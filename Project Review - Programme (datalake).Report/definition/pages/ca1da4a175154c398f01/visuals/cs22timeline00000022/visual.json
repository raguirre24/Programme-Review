    "objects": {
      "vega": [
        {
          "properties": {
            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\"$schema\":\"https://vega.github.io/schema/vega-lite/v5.json\",\"description\":\"Calendar Stretch delay timeline: each delayed activity''s remaining work up to the finish it would have without dated calendar exceptions (dark, on its own workweek), the calendar days holidays, shutdowns and rostered days off add (red), and shutdowns of 7+ days drawn over the bars (pale, dashed). Dates arrive as ISO text and become UTC timestamps (time(utcParse(...))), so a day can be added numerically.\",\"data\":{\"name\":\"dataset\"},\"width\":\"container\",\"height\":\"container\",\"transform\":[{\"filter\":\"isValid(datum[''Timeline Dates'']) && datum[''Timeline Dates''] != ''''\"},{\"calculate\":\"split(datum[''Timeline Dates''], ''|'')\",\"as\":\"dates\"},{\"calculate\":\"time(utcParse(datum.dates[0], ''%Y-%m-%d''))\",\"as\":\"Remaining start\"},{\"calculate\":\"time(utcParse(datum.dates[1], ''%Y-%m-%d''))\",\"as\":\"Exception-free finish\"},{\"calculate\":\"time(utcParse(datum.dates[2], ''%Y-%m-%d''))\",\"as\":\"Scheduled finish\"},{\"calculate\":\"time(utcParse(datum.dates[3], ''%Y-%m-%d''))\",\"as\":\"Data date\"},{\"calculate\":\"utcFormat(datum[''Remaining start''], ''%d-%b-%y'')\",\"as\":\"Remaining start text\"},{\"calculate\":\"utcFormat(datum[''Exception-free finish''], ''%d-%b-%y'')\",\"as\":\"Exception-free finish text\"},{\"calculate\":\"utcFormat(datum[''Scheduled finish''], ''%d-%b-%y'')\",\"as\":\"Scheduled finish text\"},{\"calculate\":\"utcFormat(datum[''Data date''], ''%d-%b-%y'')\",\"as\":\"Data date text\"},{\"calculate\":\"datum[''Exception-free finish''] + 86400000\",\"as\":\"exceptionFreeEnd\"},{\"calculate\":\"datum[''Scheduled finish''] + 86400000\",\"as\":\"finishEnd\"},{\"calculate\":\"''+'' + format(datum[''Delay Days''], '','') + '' d''\",\"as\":\"delayLabel\"},{\"calculate\":\"datum.__selected__ == ''off'' ? 0.35 : 1\",\"as\":\"rowOpacity\"},{\"calculate\":\"0.55 * datum.rowOpacity\",\"as\":\"shutdownOpacity\"}],\"encoding\":{\"y\":{\"field\":\"Activity\",\"type\":\"nominal\",\"sort\":{\"field\":\"Delay Days\",\"op\":\"max\",\"order\":\"descending\"},\"axis\":{\"title\":null,\"labelLimit\":150,\"labelFontSize\":10}}},\"layer\":[{\"mark\":{\"type\":\"bar\",\"color\":\"#404040\",\"height\":{\"band\":0.55}},\"encoding\":{\"x\":{\"field\":\"Remaining start\",\"type\":\"temporal\",\"scale\":{\"type\":\"utc\"}},\"x2\":{\"field\":\"exceptionFreeEnd\"},\"opacity\":{\"field\":\"rowOpacity\",\"type\":\"quantitative\",\"scale\":null},\"tooltip\":[{\"field\":\"Activity\",\"title\":\"Activity\"},{\"field\":\"Name\",\"title\":\"Name\"},{\"field\":\"Calendar\",\"title\":\"Calendar\"},{\"field\":\"Remaining start text\",\"title\":\"Remaining start\"},{\"field\":\"Exception-free finish text\",\"title\":\"Finish without calendar exceptions\"},{\"field\":\"Total Float\",\"type\":\"quantitative\",\"format\":\",.1f\",\"title\":\"Total float (working days)\"}]}},{\"transform\":[{\"filter\":\"datum[''Delay Days''] > 0\"}],\"mark\":{\"type\":\"bar\",\"color\":\"#C00000\",\"height\":{\"band\":0.55}},\"encoding\":{\"x\":{\"field\":\"exceptionFreeEnd\",\"type\":\"temporal\",\"scale\":{\"type\":\"utc\"}},\"x2\":{\"field\":\"finishEnd\"},\"opacity\":{\"field\":\"rowOpacity\",\"type\":\"quantitative\",\"scale\":null},\"tooltip\":[{\"field\":\"Activity\",\"title\":\"Activity\"},{\"field\":\"Name\",\"title\":\"Name\"},{\"field\":\"Exception-free finish text\",\"title\":\"Finish without calendar exceptions\"},{\"field\":\"Scheduled finish text\",\"title\":\"Scheduled finish\"},{\"field\":\"Delay Days\",\"type\":\"quantitative\",\"format\":\",\",\"title\":\"Calendar-driven delay (days)\"}]}},{\"transform\":[{\"filter\":\"isValid(datum[''Shutdown Bands'']) && datum[''Shutdown Bands''] != ''''\"},{\"calculate\":\"split(datum[''Shutdown Bands''], '';'')\",\"as\":\"band\"},{\"flatten\":[\"band\"]},{\"calculate\":\"time(utcParse(split(datum.band, ''|'')[0], ''%Y-%m-%d''))\",\"as\":\"Shutdown from\"},{\"calculate\":\"time(utcParse(split(datum.band, ''|'')[1], ''%Y-%m-%d''))\",\"as\":\"Shutdown to\"},{\"calculate\":\"datum[''Shutdown to''] + 86400000\",\"as\":\"bandEnd\"},{\"calculate\":\"utcFormat(datum[''Shutdown from''], ''%d-%b-%y'') + '' to '' + utcFormat(datum[''Shutdown to''], ''%d-%b-%y'')\",\"as\":\"Shutdown\"}],\"mark\":{\"type\":\"bar\",\"color\":\"#FFFFFF\",\"stroke\":\"#595959\",\"strokeWidth\":1,\"strokeDash\":[3,2],\"height\":{\"band\":0.8}},\"encoding\":{\"x\":{\"field\":\"Shutdown from\",\"type\":\"temporal\",\"scale\":{\"type\":\"utc\"}},\"x2\":{\"field\":\"bandEnd\"},\"opacity\":{\"field\":\"shutdownOpacity\",\"type\":\"quantitative\",\"scale\":null},\"tooltip\":[{\"field\":\"Activity\",\"title\":\"Activity\"},{\"field\":\"Name\",\"title\":\"Name\"},{\"field\":\"Shutdown\",\"title\":\"Shutdown (no working days)\"}]}},{\"transform\":[{\"filter\":\"datum[''Delay Days''] > 0\"}],\"mark\":{\"type\":\"text\",\"align\":\"left\",\"baseline\":\"middle\",\"dx\":4,\"color\":\"#C00000\",\"fontWeight\":\"bold\",\"fontSize\":10},\"encoding\":{\"x\":{\"field\":\"finishEnd\",\"type\":\"temporal\",\"scale\":{\"type\":\"utc\"}},\"text\":{\"field\":\"delayLabel\"},\"opacity\":{\"field\":\"rowOpacity\",\"type\":\"quantitative\",\"scale\":null}}},{\"transform\":[{\"window\":[{\"op\":\"row_number\",\"as\":\"dataDateRow\"}]},{\"filter\":\"datum.dataDateRow == 1\"}],\"mark\":{\"type\":\"rule\",\"color\":\"#7F7F7F\",\"strokeDash\":[4,3]},\"encoding\":{\"x\":{\"field\":\"Data date\",\"type\":\"temporal\",\"scale\":{\"type\":\"utc\"}},\"y\":{\"value\":0},\"y2\":{\"value\":{\"expr\":\"height\"}},\"tooltip\":[{\"field\":\"Data date text\",\"title\":\"Data date\"}]}}],\"resolve\":{\"scale\":{\"x\":\"shared\"}},\"config\":{\"axisX\":{\"format\":\"%b-%y\",\"formatType\":\"utc\",\"title\":null,\"grid\":true,\"labelFontSize\":10,\"tickCount\":\"month\"}}}'"
