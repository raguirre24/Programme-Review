	measure 'SM Invalid Dates Points' =
			VAR MetricValue = [SM Invalid Dates %]
			RETURN IF ( NOT ISBLANK ( MetricValue ),
			    SWITCH ( TRUE (), MetricValue <= 0, 1, MetricValue <= 0.001, 0.5, 0 )
			)
		formatString: 0.0
		isHidden
		displayFolder: Schedule Quality Score\Internal bands
		lineageTag: ad669110-2f27-5fb9-8aed-97922e4c3e27

	measure 'SM Review Checks' =
			VAR CheckPoints =
			{
			    [SM Missing Logic Points],
			    [SM Leads Points],
			    [SM Lags Points],
			    [SM FS Points],
			    [SM Constraints Points],
			    [SM Negative Float Points],
			    [SM High Duration Points],
			    [SM Invalid Dates Points]
			}
			RETURN IF ( [Task_Count] > 0, COALESCE ( COUNTROWS ( FILTER ( CheckPoints,
			    NOT ISBLANK ( [Value] ) && [Value] == 0.5 ) ), 0 ) )
		formatString: #,0
		displayFolder: Schedule Quality Score
		lineageTag: 32d91495-d09d-598d-bacc-5c63ae381210

	measure 'SM Priority Checks' =
			VAR CheckPoints =
			{
			    [SM Missing Logic Points],
			    [SM Leads Points],
			    [SM Lags Points],
			    [SM FS Points],
			    [SM Constraints Points],
			    [SM Negative Float Points],
			    [SM High Duration Points],
			    [SM Invalid Dates Points]
			}
			RETURN IF ( [Task_Count] > 0, COALESCE ( COUNTROWS ( FILTER ( CheckPoints,
			    NOT ISBLANK ( [Value] ) && [Value] == 0 ) ), 0 ) )
		formatString: #,0
		displayFolder: Schedule Quality Score
		lineageTag: 17b9491c-18f4-5112-a1b6-063e86789512

	measure 'SM Score Coverage' =
			VAR ApplicableChecks = [SM Applicable Checks]
			VAR AssessedChecks = [SM Assessed Checks]
			VAR PartialChecks = [SM Partial Checks]
			VAR UnassessedChecks = ApplicableChecks - AssessedChecks
			VAR CoverageLabel = FORMAT ( AssessedChecks, "0" ) & "/" & FORMAT ( ApplicableChecks, "0" ) & " assessed"
			RETURN SWITCH ( TRUE (),
			    NOT [SM Snapshot Valid], "Input coverage unavailable",
			    NOT ( [Task_Count] > 0 ), "N/A - no incomplete discrete work",
			    CoverageLabel
			        & IF ( UnassessedChecks > 0, " | " & FORMAT ( UnassessedChecks, "0" ) & " unassessed", "" )
			        & IF ( PartialChecks > 0, " | " & FORMAT ( PartialChecks, "0" ) & " partial inputs", "" )
			        & IF ( UnassessedChecks = 0 && PartialChecks = 0, " | complete inputs", "" )
			)
		formatString: @
		displayFolder: Schedule Quality Coverage
		lineageTag: 9e3aa57d-5300-5ffc-9025-0769345fe721

	partition 'XER Metrics' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

