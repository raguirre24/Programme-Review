		lineageTag: bd12dee0-b112-560c-ab6c-a6b786b4b3f8

	measure 'SM FS Points' =
			VAR MetricValue = [SM FS %]
			RETURN IF ( NOT ISBLANK ( MetricValue ),
			    SWITCH ( TRUE (), MetricValue >= 0.90, 1, MetricValue >= 0.80, 0.5, 0 )
			)
		formatString: 0.0
		isHidden
		displayFolder: Schedule Quality Score\Internal bands
		lineageTag: 107640e5-9570-5aac-b666-4934663ed668

	measure 'SM Constraints Points' =
