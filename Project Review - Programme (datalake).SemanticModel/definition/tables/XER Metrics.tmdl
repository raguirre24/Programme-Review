	measure 'SM High Duration Points' =
			VAR MetricValue = [HighDur%]
			RETURN IF ( NOT ISBLANK ( MetricValue ),
			    SWITCH ( TRUE (), MetricValue <= 0.05, 1, MetricValue <= 0.10, 0.5, 0 )
			)
		formatString: 0.0
