table 'XER Metrics'
	lineageTag: 4c90930e-7191-402b-8b10-d92d87090b7d

	/// Eligible work with no predecessor. Diagnostic component of combined missing logic.
	measure 'Missing Predecessor' =
			VAR N = [Task_Count]
			VAR Result = CALCULATE ( COUNTROWS ( '01 XER_TASK' ), REMOVEFILTERS ( '01 XER_TASK'[status_code], '01 XER_TASK'[StatusCategory],
			    '01 XER_TASK'[task_type], '01 XER_TASK'[TaskType_Classified], '01 XER_TASK'[Is Unscheduled] ),
			REMOVEFILTERS ( Filter_Activity_Status ),
			REMOVEFILTERS ( Filter_TaskType ),
			REMOVEFILTERS ( '00 CALENDAR' ),
			REMOVEFILTERS ( '00 PLANNED DATE TABLE (PV)' ),
			'01 XER_TASK'[status_code] IN { "Not Started", "In Progress" },
			'01 XER_TASK'[task_type] IN { "TT_Task", "TT_Rsrc" }, KEEPFILTERS ( '01 XER_TASK'[No Predecessor] = 1 ) )
			RETURN IF ( N > 0, COALESCE ( Result, 0 ) )
		formatString: #,0
		displayFolder: Schedule Quality Table
		lineageTag: b2f7cb81-8dec-4005-9a48-ad65ebfa34d0

	/// Incomplete discrete work: TT_Task/TT_Rsrc. Includes unscheduled work; preserves datalake exclusions. Not a sum across snapshots.
	measure Task_Count =
			VAR N = CALCULATE ( COUNTROWS ( '01 XER_TASK' ), REMOVEFILTERS ( '01 XER_TASK'[status_code], '01 XER_TASK'[StatusCategory],
			    '01 XER_TASK'[task_type], '01 XER_TASK'[TaskType_Classified], '01 XER_TASK'[Is Unscheduled] ),
			REMOVEFILTERS ( Filter_Activity_Status ),
			REMOVEFILTERS ( Filter_TaskType ),
			REMOVEFILTERS ( '00 CALENDAR' ),
			REMOVEFILTERS ( '00 PLANNED DATE TABLE (PV)' ),
			'01 XER_TASK'[status_code] IN { "Not Started", "In Progress" },
			'01 XER_TASK'[task_type] IN { "TT_Task", "TT_Rsrc" } )
			RETURN IF ( [SM Snapshot Valid], N )
		formatString: #,0
		displayFolder: Schedule Quality Table
		lineageTag: a59b8440-c71a-49f5-ac02-82817bf03c64

	measure MissingPredecessor% = DIVIDE ( [Missing Predecessor], [Task_Count] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Schedule Quality Visuals
		lineageTag: b10b5f78-5dc1-4c51-b3a0-55f52d133cc1

	/// Float is already in working days; no hours-to-days conversion.
	measure 'Float >44' =
			VAR N = [Task_Count]
			VAR Result = CALCULATE ( COUNTROWS ( '01 XER_TASK' ), REMOVEFILTERS ( '01 XER_TASK'[status_code], '01 XER_TASK'[StatusCategory],
			    '01 XER_TASK'[task_type], '01 XER_TASK'[TaskType_Classified], '01 XER_TASK'[Is Unscheduled] ),
			REMOVEFILTERS ( Filter_Activity_Status ),
			REMOVEFILTERS ( Filter_TaskType ),
			REMOVEFILTERS ( '00 CALENDAR' ),
			REMOVEFILTERS ( '00 PLANNED DATE TABLE (PV)' ),
			'01 XER_TASK'[status_code] IN { "Not Started", "In Progress" },
			'01 XER_TASK'[task_type] IN { "TT_Task", "TT_Rsrc" }, KEEPFILTERS ( '01 XER_TASK'[total_float] > 44 ) )
			RETURN IF ( N > 0, COALESCE ( Result, 0 ) )
		formatString: #,0
		displayFolder: Schedule Quality Table
		lineageTag: f455b06e-fc38-40f8-a1bd-e98e87db351b

	/// Float >44 working days / work with known float; a context-dependent diagnostic, excluded from the score. Missing inputs are disclosed separately.
	measure HighFloat% = DIVIDE ( [Float >44], [Task_Count] - [SM Missing Float Count] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Schedule Quality Visuals
		lineageTag: b0c84e96-887e-471b-b1d0-f53663d01542

	/// Custom remaining-duration check, not original/baseline duration.
	measure 'Dur >44' =
			VAR N = [Task_Count]
			VAR Result = CALCULATE ( COUNTROWS ( '01 XER_TASK' ), REMOVEFILTERS ( '01 XER_TASK'[status_code], '01 XER_TASK'[StatusCategory],
			    '01 XER_TASK'[task_type], '01 XER_TASK'[TaskType_Classified], '01 XER_TASK'[Is Unscheduled] ),
			REMOVEFILTERS ( Filter_Activity_Status ),
			REMOVEFILTERS ( Filter_TaskType ),
			REMOVEFILTERS ( '00 CALENDAR' ),
			REMOVEFILTERS ( '00 PLANNED DATE TABLE (PV)' ),
			'01 XER_TASK'[status_code] IN { "Not Started", "In Progress" },
			'01 XER_TASK'[task_type] IN { "TT_Task", "TT_Rsrc" }, KEEPFILTERS ( '01 XER_TASK'[remaining_duration] > 44 ) )
			RETURN IF ( N > 0, COALESCE ( Result, 0 ) )
		formatString: #,0
		displayFolder: Schedule Quality Table
		lineageTag: f0c8dee3-9325-44bb-ac70-f3c622aae79a

	/// Custom remaining duration >44 working days / work with valid duration; internal benchmark at or below 5%.
	measure HighDur% = DIVIDE ( [Dur >44], [Task_Count] - [SM Missing Duration Count] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Schedule Quality Visuals
		lineageTag: 197e994d-8397-448d-81b5-bd7fc09c90d2

	/// Long-lag diagnostic retained by name. The scored Lags% uses all positive lags.
	measure Lags>5d =
			VAR N = [Task_Count]
			VAR WorkKeys = CALCULATETABLE ( VALUES ( '01 XER_TASK'[task_id_key] ), REMOVEFILTERS ( '01 XER_TASK'[status_code], '01 XER_TASK'[StatusCategory],
			    '01 XER_TASK'[task_type], '01 XER_TASK'[TaskType_Classified], '01 XER_TASK'[Is Unscheduled] ),
			REMOVEFILTERS ( Filter_Activity_Status ),
			REMOVEFILTERS ( Filter_TaskType ),
			REMOVEFILTERS ( '00 CALENDAR' ),
			REMOVEFILTERS ( '00 PLANNED DATE TABLE (PV)' ),
			'01 XER_TASK'[status_code] IN { "Not Started", "In Progress" },
			'01 XER_TASK'[task_type] IN { "TT_Task", "TT_Rsrc" } )
			VAR Result = CALCULATE ( COUNTROWS ( '06 XER_PREDECESSOR' ),
			    REMOVEFILTERS ( '01 XER_TASK' ),
			    TREATAS ( WorkKeys, '06 XER_PREDECESSOR'[task_id_key] ),
			    KEEPFILTERS ( '06 XER_PREDECESSOR'[lag] > 5 ) )
			RETURN IF ( N > 0, COALESCE ( Result, 0 ) )
		formatString: #,0
		displayFolder: Schedule Quality Table
		lineageTag: aebdccda-d216-44b1-a7ab-769cdc91a580

	/// Positive lag relationships / relationships with known lag. Pass at or below 5%.
	measure Lags% = DIVIDE ( [SM Positive Lag Count], [SM Eligible Relationship Count] - [SM Missing Lag Count] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Schedule Quality Visuals
		lineageTag: 0b9d0cbd-83a4-4567-9276-c9e312b19b1d

	/// Average of eight assessed internal review grades: within=1, review=0.5, priority=0. High float is diagnostic only; coverage is separate.
	measure Score =
			VAR CheckPoints =
			{
			    [SM Missing Logic Points],
			    [SM Leads Points],
			    [SM Lags Points],
			    [SM FS Points],
			    [SM Constraints Points],
			    [SM Negative Float Points],
			    [SM High Duration Points],
			    [SM Invalid Dates Points]
			}
			VAR AssessedPoints = FILTER ( CheckPoints, NOT ISBLANK ( [Value] ) )
			RETURN IF ( [Task_Count] > 0, AVERAGEX ( AssessedPoints, [Value] ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Schedule Quality Score
		lineageTag: 91a728f9-6f81-400e-a5e1-e9f966f407af

	measure Task_Count_Negative_Float =
			VAR N = [Task_Count]
			VAR Result = CALCULATE ( COUNTROWS ( '01 XER_TASK' ), REMOVEFILTERS ( '01 XER_TASK'[status_code], '01 XER_TASK'[StatusCategory],
			    '01 XER_TASK'[task_type], '01 XER_TASK'[TaskType_Classified], '01 XER_TASK'[Is Unscheduled] ),
			REMOVEFILTERS ( Filter_Activity_Status ),
			REMOVEFILTERS ( Filter_TaskType ),
			REMOVEFILTERS ( '00 CALENDAR' ),
			REMOVEFILTERS ( '00 PLANNED DATE TABLE (PV)' ),
			'01 XER_TASK'[status_code] IN { "Not Started", "In Progress" },
			'01 XER_TASK'[task_type] IN { "TT_Task", "TT_Rsrc" }, KEEPFILTERS ( '01 XER_TASK'[total_float] < 0 ) )
			RETURN IF ( N > 0, COALESCE ( Result, 0 ) )
		formatString: #,0
		displayFolder: Schedule Quality Table
		lineageTag: 84f80f9d-6679-44c8-9967-879cefb38790

	/// All primary constraints; retained for existing diagnostic consumers. Score uses restrictive primary constraints instead.
	measure 'Primary Constraints' =
			VAR N = [Task_Count]
			VAR Result = CALCULATE ( COUNTROWS ( '01 XER_TASK' ), REMOVEFILTERS ( '01 XER_TASK'[status_code], '01 XER_TASK'[StatusCategory],
			    '01 XER_TASK'[task_type], '01 XER_TASK'[TaskType_Classified], '01 XER_TASK'[Is Unscheduled] ),
			REMOVEFILTERS ( Filter_Activity_Status ),
			REMOVEFILTERS ( Filter_TaskType ),
			REMOVEFILTERS ( '00 CALENDAR' ),
			REMOVEFILTERS ( '00 PLANNED DATE TABLE (PV)' ),
			'01 XER_TASK'[status_code] IN { "Not Started", "In Progress" },
			'01 XER_TASK'[task_type] IN { "TT_Task", "TT_Rsrc" }, KEEPFILTERS ( NOT ISBLANK ( '01 XER_TASK'[cstr_type] ) && '01 XER_TASK'[cstr_type] <> "" ) )
			RETURN IF ( N > 0, COALESCE ( Result, 0 ) )
		formatString: #,0
		displayFolder: Schedule Quality Table
		lineageTag: a30c0519-b72a-480b-8510-a3d929447144

	measure Leads<0d =
			VAR N = [Task_Count]
			VAR WorkKeys = CALCULATETABLE ( VALUES ( '01 XER_TASK'[task_id_key] ), REMOVEFILTERS ( '01 XER_TASK'[status_code], '01 XER_TASK'[StatusCategory],
			    '01 XER_TASK'[task_type], '01 XER_TASK'[TaskType_Classified], '01 XER_TASK'[Is Unscheduled] ),
			REMOVEFILTERS ( Filter_Activity_Status ),
			REMOVEFILTERS ( Filter_TaskType ),
			REMOVEFILTERS ( '00 CALENDAR' ),
			REMOVEFILTERS ( '00 PLANNED DATE TABLE (PV)' ),
			'01 XER_TASK'[status_code] IN { "Not Started", "In Progress" },
			'01 XER_TASK'[task_type] IN { "TT_Task", "TT_Rsrc" } )
			VAR Result = CALCULATE ( COUNTROWS ( '06 XER_PREDECESSOR' ),
			    REMOVEFILTERS ( '01 XER_TASK' ),
			    TREATAS ( WorkKeys, '06 XER_PREDECESSOR'[task_id_key] ),
			    KEEPFILTERS ( '06 XER_PREDECESSOR'[lag] < 0 ) )
			RETURN IF ( N > 0, COALESCE ( Result, 0 ) )
		formatString: #,0
		displayFolder: Schedule Quality Table
		lineageTag: bd7bae77-005f-45cb-b795-11d1bc91c490

	/// Strict equality excludes missing float. Diagnostic only, not longest path or a scored defect.
	measure Task_Count_Float_0 =
			VAR N = [Task_Count]
			VAR Result = CALCULATE ( COUNTROWS ( '01 XER_TASK' ), REMOVEFILTERS ( '01 XER_TASK'[status_code], '01 XER_TASK'[StatusCategory],
			    '01 XER_TASK'[task_type], '01 XER_TASK'[TaskType_Classified], '01 XER_TASK'[Is Unscheduled] ),
			REMOVEFILTERS ( Filter_Activity_Status ),
			REMOVEFILTERS ( Filter_TaskType ),
			REMOVEFILTERS ( '00 CALENDAR' ),
			REMOVEFILTERS ( '00 PLANNED DATE TABLE (PV)' ),
			'01 XER_TASK'[status_code] IN { "Not Started", "In Progress" },
			'01 XER_TASK'[task_type] IN { "TT_Task", "TT_Rsrc" }, KEEPFILTERS ( '01 XER_TASK'[total_float] == 0 ) )
			RETURN IF ( N > 0, COALESCE ( Result, 0 ) )
		formatString: #,0
		displayFolder: Schedule Quality Table
		lineageTag: f23dbffe-c081-4eae-8448-8886f89d6cb0

	/// Diagnostic only; neither longest-path membership nor a scored defect.
	measure 0Float% = DIVIDE ( [Task_Count_Float_0], [Task_Count] - [SM Missing Float Count] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Schedule Quality Visuals
		lineageTag: a831311e-8b1d-4ec8-b39f-dccb280d63ff

	/// Negative total float / work with known float. Pass only at zero; missing inputs are disclosed separately.
	measure <0Float% = DIVIDE ( [Task_Count_Negative_Float], [Task_Count] - [SM Missing Float Count] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Schedule Quality Visuals
		lineageTag: f2302477-2578-475c-a8c0-6c00a2b9dd98

	/// Negative lag relationships / relationships with known lag. Pass only at zero.
	measure <0Lead% = DIVIDE ( [Leads<0d], [SM Eligible Relationship Count] - [SM Missing Lag Count] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Schedule Quality Visuals
		lineageTag: 491fc125-f8aa-4e36-878d-89d555bf390c

	/// Primary restrictive constraints only; at or below 5%. Secondary constraints are not available.
	measure Constraint% = DIVIDE ( [SM Restrictive Primary Count], [Task_Count] - [SM Unknown Constraint Count] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Schedule Quality Visuals
		lineageTag: 2ad2059f-95e3-418a-9e3e-4a2659f6bb8c

	/// Eligible work with no successor. Diagnostic component of combined missing logic.
	measure 'Missing Successor' =
			VAR N = [Task_Count]
			VAR Result = CALCULATE ( COUNTROWS ( '01 XER_TASK' ), REMOVEFILTERS ( '01 XER_TASK'[status_code], '01 XER_TASK'[StatusCategory],
			    '01 XER_TASK'[task_type], '01 XER_TASK'[TaskType_Classified], '01 XER_TASK'[Is Unscheduled] ),
			REMOVEFILTERS ( Filter_Activity_Status ),
			REMOVEFILTERS ( Filter_TaskType ),
			REMOVEFILTERS ( '00 CALENDAR' ),
			REMOVEFILTERS ( '00 PLANNED DATE TABLE (PV)' ),
			'01 XER_TASK'[status_code] IN { "Not Started", "In Progress" },
			'01 XER_TASK'[task_type] IN { "TT_Task", "TT_Rsrc" }, KEEPFILTERS ( '01 XER_TASK'[No Successor] = 1 ) )
			RETURN IF ( N > 0, COALESCE ( Result, 0 ) )
		formatString: #,0
		displayFolder: Schedule Quality Table
		lineageTag: 72da43b9-9740-4e17-9d42-0d75e5d8d035

	measure MissingSuccessor% = DIVIDE ( [Missing Successor], [Task_Count] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Schedule Quality Visuals
		lineageTag: aa2548ee-cb2f-4bfe-9f84-8449da03dafe

	/// History up to the selected update, evaluated at one disconnected UpdateHistory axis point.
	measure 'Score (History)' =
			VAR SelectedUpdate = [SM Selected History Cutoff]
			VAR AxisUpdate = SELECTEDVALUE ( UpdateHistory[UpdateDate] )
			RETURN IF ( NOT ISBLANK ( AxisUpdate ) && AxisUpdate <= SelectedUpdate,
			    CALCULATE ( [Score], REMOVEFILTERS ( CurrentDate ),
			        TREATAS ( { AxisUpdate }, '01 XER_TASK'[UpdateDate] ) )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Schedule Quality Trend
		lineageTag: 2e2f3c32-9116-4175-bc7c-39d3f92856c7

	/// History up to the selected update, evaluated at one disconnected UpdateHistory axis point.
	measure 'HighDur% (History)' =
			VAR SelectedUpdate = [SM Selected History Cutoff]
			VAR AxisUpdate = SELECTEDVALUE ( UpdateHistory[UpdateDate] )
			RETURN IF ( NOT ISBLANK ( AxisUpdate ) && AxisUpdate <= SelectedUpdate,
			    CALCULATE ( [HighDur%], REMOVEFILTERS ( CurrentDate ),
			        TREATAS ( { AxisUpdate }, '01 XER_TASK'[UpdateDate] ) )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Schedule Quality Trend
		lineageTag: 718a571f-8715-4cc1-ac9c-4217052ed4b2

