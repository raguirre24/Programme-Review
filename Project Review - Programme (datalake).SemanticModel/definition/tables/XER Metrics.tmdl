	/// History up to the selected update, evaluated at one disconnected UpdateHistory axis point.
	measure 'MissingSuccessor% (History)' =
			VAR SelectedUpdate = [SM Selected History Cutoff]
			VAR AxisUpdate = SELECTEDVALUE ( UpdateHistory[UpdateDate] )
			RETURN IF ( NOT ISBLANK ( AxisUpdate ) && AxisUpdate <= SelectedUpdate,
			    CALCULATE ( [MissingSuccessor%], REMOVEFILTERS ( CurrentDate ),
