			)
		formatString: 0.0
		isHidden
		displayFolder: Schedule Quality Score\Internal bands
		lineageTag: 265693d8-6230-5247-b9b6-29c5219ce82b

	measure 'SM Negative Float Points' =
			VAR MetricValue = [<0Float%]
			RETURN IF ( NOT ISBLANK ( MetricValue ),
			    SWITCH ( TRUE (), MetricValue <= 0, 1, MetricValue <= 0.01, 0.5, 0 )
			)
		formatString: 0.0
		isHidden
		displayFolder: Schedule Quality Score\Internal bands
