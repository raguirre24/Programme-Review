	partition 'Schedule Metric Guide' = calculated
		mode: import
		source =
				DATATABLE (
				    "Order", INTEGER,
				    "Metric", STRING,
				    "Meaning and calculation", STRING,
				    "Green (1 pt)", STRING,
				    "Amber (0–1 pt)", STRING,
				    "Red (0 pt)", STRING,
				    "Scope and notes", STRING,
				    {
				        { 1, "Missing logic", "Activities with no predecessor, no successor, or neither. Calculation: Activities missing either end / core activities. Each activity counted once.", "≤5%", ">5% to <10%", "≥10%", "Core activities: incomplete task- and resource-dependent activities. Excludes milestones, LOE, WBS summaries and completed work. Each activity missing a predecessor, a successor, or both is counted once. Right-click Missing logic > Drill through to list failing activities." },
				        { 2, "Leads", "Relationships with negative lag. Calculation: Relationships with lag < 0 / relationships with a known lag.", "0%", ">0% to <1%", "≥1%", "Links into incomplete discrete successors. Gauge scores relationships (missing lag excluded); table column Leads <0d counts distinct incomplete activities receiving a lead for drill-through." },
				        { 3, "Lags over 5 days", "Relationships with a waiting period of more than 5 working days. Calculation: Relationships with lag > 5 days / relationships with a known lag.", "≤5%", ">5% to <10%", "≥10%", "Links into incomplete discrete successors. Short lags (5 days or less), mostly on SS/FF overlap pairs, are not counted; missing lag excluded. Gauge scores relationships; table column Lags >5d counts distinct receiving activities for drill-through." },
				        { 4, "Finish-to-start relationships", "Share of relationships that are finish-to-start. Calculation: FS relationships (incl. PR_FS1) / relationships with a recognised FS, SS, FF or SF type.", "≥90%", ">80% to <90%", "≤80%", "Links into incomplete discrete successors. Unknown types excluded; FS and FS1 rows are not deduplicated. Gauge scores FS share of relationships; table column Non-FS counts distinct activities receiving SS/FF/SF links for drill-through." },
				        { 5, "Hard constraints", "Incomplete activities and milestones whose primary constraint fixes or caps their dates (hard constraints). Calculation: Incomplete activities and milestones with a hard primary constraint / incomplete activities and milestones with a known or blank constraint.", "≤5%", ">5% to <10%", "≥10%", "Incomplete activities and milestones (excludes only Level of Effort and WBS Summary); primary hard constraints only. Counted: Must Start On (CS_MSO), Start On or Before (CS_MSOB), Must Finish On (CS_MEO), Finish On or Before (CS_MEOB), Mandatory Start (CS_MANDSTART), Mandatory Finish (CS_MANDFIN). Soft constraints and unconstrained items are not counted. Unknown codes excluded. Right-click Hard constraints > Drill through to list failing activities and milestones." },
				        { 6, "Out-of-sequence progress", "In-progress activities that started before their logic allowed. Calculation: In-progress activities with an FS predecessor not finished, or an SS predecessor not started / in-progress activities.", "0%", ">0% to <10%", "≥10%", "In-progress task- and resource-dependent activities. LOE and WBS predecessors are ignored. Shows 0% until work is in progress. Fix by progressing the predecessor or correcting the logic." },
				        { 7, "Negative total float", "Activities forecast to miss a required date (total float below zero). Calculation: Activities with total float < 0 / core activities with known float.", "0%", ">0% to <5%", "≥5%", "Core activities. Any negative float counts, however small. Missing float excluded." },
				        { 8, "Long remaining duration", "Activities with more than 44 working days still to perform. Calculation: Activities with remaining duration > 44d / core activities with known, non-negative remaining duration.", "≤5%", ">5% to <10%", "≥10%", "Core activities. Uses remaining, not original, duration. Exactly 44d is not flagged." },
				        { 9, "Date integrity (invalid or missing dates)", "Activities with a missing required date, or a date inconsistent with the data date or status. Calculation: Activities and milestones failing any date rule / all eligible activities and milestones. Each counted once.", "0%", ">0% to <1%", "≥1%", "Task- and resource-dependent activities and milestones in all statuses. Excludes LOE and WBS summaries. Rules: future actuals, overdue forecasts, actual finish vs status, missing data date, unknown status, finish before start. Milestones need only their relevant date. Missing dates count as defects." },
				        { 10, "Baseline coverage", "Share of current activities that have a dated baseline match. Calculation: Current activities matched to a baseline activity with a Finish / all current activities.", "≥90%", ">60% to <90%", "≤60%", "Whole project, all statuses, against the latest BL baseline file up to the selected update (or the earliest loaded update when no BL file exists). Gauge scores whole-project coverage (0% if a BL filename tag is invalid; repeated codes disclosed, not penalised). Table column No baseline counts unmatched activities in the current selection for drill-through." }
				    }
				)

