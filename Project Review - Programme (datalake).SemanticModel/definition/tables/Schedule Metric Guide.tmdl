/// Reader reference for the implemented Schedule Metrics page; static and disconnected.
table 'Schedule Metric Guide'
	isHidden
	lineageTag: d3d3a63c-d103-5b94-849e-5435f7617888

	column Order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 75f18f11-15f2-5b04-acad-61e733dda511
		summarizeBy: none
		sourceColumn: [Order]

	column Metric
		dataType: string
		lineageTag: b839f793-864d-553b-9798-281b40b5d2ea
		summarizeBy: none
		sourceColumn: [Metric]
		sortByColumn: Order

	column 'Meaning and calculation'
		dataType: string
		lineageTag: f95ee015-56e1-5bf1-bb87-1d2050d4cc5b
		summarizeBy: none
		sourceColumn: [Meaning and calculation]

	column 'Target / score'
		dataType: string
		lineageTag: b2a95d02-1049-56cc-8490-290ac834fced
		summarizeBy: none
		sourceColumn: [Target / score]

	column 'Scope and notes'
		dataType: string
		lineageTag: 45161ea0-9e69-5598-a5ec-52f21cc8bea6
		summarizeBy: none
		sourceColumn: [Scope and notes]

	partition 'Schedule Metric Guide' = calculated
		mode: import
		source =
				DATATABLE (
				    "Order", INTEGER,
				    "Metric", STRING,
				    "Meaning and calculation", STRING,
				    "Target / score", STRING,
				    "Scope and notes", STRING,
				    {
				        { 1, "Schedule health score", "A 0–100% summary of eight schedule health checks. Each assessed check has equal weight, regardless of its activity or relationship count. Why it matters: Helps prioritise schedule reviews. Read the individual results and evidence coverage alongside the score. Calculation: Green (within band) = 1 point; amber (review) = 0.5; red (priority) = 0. Score = earned points / assessed checks × 100. Example: 3 green + 4 amber + 1 red gives (3 + 4 × 0.5 + 1 × 0) / 8 × 100 = 62.5%. Raw metric percentages are not averaged.", "Aim: 100%. Colour follows the worst assessed check: any red = red; otherwise any amber = amber; all green = green. N/A = grey. The 62.5% example is red because one check is a priority. No separate percentage bands apply to the overall score.", "Included: missing logic, leads, positive lags, FS relationships, restrictive primary constraints, negative float, long remaining duration and date integrity. High float, the four selectable detail metrics and table-only counts have no additional weight. Coverage: assessed/applicable checks can be fewer than 8 when a check has no eligible population. A check with no usable result is omitted, never passed. Partial inputs still give a full-weight grade from usable records and a coverage warning; missing required dates count as defects. Compare scores with coverage in view. Invalid project/update selection, no incomplete discrete work or no assessable checks gives N/A. 100% means all assessed checks are green; it does not mean 100% complete, full evidence or assured delivery." },
				        { 2, "Missing logic", "Work that has no recorded predecessor, no recorded successor, or both. Why it matters: Missing links can leave work disconnected from the sequence used to forecast delivery. Review whether each open end is intentional or needs a relationship. Calculation: Incomplete discrete activities missing either end / all incomplete discrete activities. Each activity is counted once.", "Green: <=5%; amber: >5% to 10%; red: >10%. Equal weight: green 1 point; amber 0.5; red 0.", "Core activity population; recorded relationships in the selected snapshot. The separate Missing Pred. and Missing Succ. counts overlap when an activity has neither. The check assesses recorded links; it does not prove that the linked sequence is correct. Review the separate components through the Missing Predecessor and Missing Successor drill-through pages, available from an update in the counts table." },
				        { 3, "Leads", "Relationships with negative lag, allowing the successor event to occur earlier than the relationship would otherwise allow. Why it matters: Negative lag can make the intended overlap difficult to explain or monitor. Review whether the sequence is clearer when the overlap is represented explicitly. Calculation: Eligible relationships with lag below zero / eligible relationships with a known lag.", "Green: 0%; amber: >0% to 1%; red: >1%. Equal weight: green 1 point; amber 0.5; red 0.", "Links into incomplete discrete successor activities; the predecessor can be complete. Missing lag is excluded and disclosed. The denominator counts relationships, not activities." },
				        { 4, "Positive lags", "Relationships containing a waiting period between their linked events. Why it matters: Waiting time inside a relationship has no separate activity to track. Review whether each lag represents a justified wait or work that needs its own duration and progress record. Calculation: Eligible relationships with lag above zero / eligible relationships with a known lag.", "Green: <=5%; amber: >5% to 10%; red: >10%. Equal weight: green 1 point; amber 0.5; red 0.", "Links into incomplete discrete successor activities; the predecessor can be complete. All positive lags count, including those of five days or less. Missing lag is excluded and disclosed." },
				        { 5, "Finish-to-start relationships", "The share of recognised relationships requiring a predecessor finish before a successor start. Why it matters: A clear finish-to-start sequence is usually easier to follow. A lower share prompts a review of whether overlapping or finish-linked relationships reflect the intended delivery sequence. Calculation: Eligible PR_FS or PR_FS1 relationships / eligible relationships with a recognised FS, SS, FF or SF type.", "Green: >=90%; amber: 80% to <90%; red: <80%. Equal weight: green 1 point; amber 0.5; red 0.", "Links into incomplete discrete successor activities; the predecessor can be complete. PR_FS1 is a user-confirmed FS alias. Other unknown types are excluded and disclosed. Imported rows are counted without deduplicating FS and FS1 records." },
				        { 6, "Restrictive primary constraints", "Work with a fixed or latest-date primary constraint that restricts normal logic-driven scheduling. Why it matters: Restrictive dates can limit how the forecast responds to changes in preceding work. Review whether each constraint reflects a real commitment and remains appropriate. Calculation: Activities with a recognised restrictive primary constraint / core activities with a recognised constraint code or no constraint.", "Green: <=5%; amber: >5% to 10%; red: >10%. Equal weight: green 1 point; amber 0.5; red 0.", "Core activity population; primary constraint only. Blank means no primary constraint. Unknown codes are excluded and disclosed. Secondary constraints are not available. Counted codes: CS_MSO, CS_MSOB, CS_MEO, CS_MEOB, CS_MANDSTART and CS_MANDFIN." },
				        { 7, "High float >44d (review indicator)", "Work with more than 44 working days of total float, which can warrant a review of logic or timing assumptions. Why it matters: Large amounts of float may represent genuine flexibility or incomplete logic. Reviewing the affected work helps distinguish usable time allowance from a weakly connected forecast. Calculation: Activities with total float above 44 working days / core activities with known total float.", "No universal pass/fail target; blue diagnostic. Excluded from the schedule health score.", "Core activity population with nonblank total float. Exactly 44 days is not flagged. Imported float is already in working days. Missing float is excluded and disclosed; it is not treated as zero. High float can be legitimate flexibility, so review the logic and timing rather than treating its prevalence as an automatic failure." },
				        { 8, "Negative total float", "Work with less than zero total float, indicating pressure against the schedule's required dates. Why it matters: Negative float highlights where the current schedule cannot meet a required date under its recorded logic and constraints. Review the cause and whether recovery action or a date decision is needed. Calculation: Activities with total float below zero / core activities with known total float.", "Green: 0%; amber: >0% to 1%; red: >1%. Equal weight: green 1 point; amber 0.5; red 0.", "Core activity population with nonblank total float. Missing float is excluded and disclosed. This check is distinct from longest-path membership." },
				        { 9, "Long remaining duration", "Work with more than 44 working days still to perform. Why it matters: Long remaining activities can conceal intermediate progress and delay the visibility of slippage. Review whether the work has enough measurable stages for reliable forecasting. Calculation: Activities with remaining duration above 44 working days / core activities with known, nonnegative remaining duration.", "Green: <=5%; amber: >5% to 10%; red: >10%. Equal weight: green 1 point; amber 0.5; red 0.", "Core activity population with usable remaining duration. Uses the duration still to perform rather than the activity's original duration. Exactly 44 days is not flagged. Missing or negative remaining durations are excluded and disclosed." },
				        { 10, "Date integrity (invalid or missing dates)", "Activities with at least one missing required date, impossible date sequence or inconsistency with the data date or status. Why it matters: Inconsistent dates weaken the distinction between completed work and the forecast. Review these records before relying on progress, finish-date or baseline comparisons. Calculation: Activities or milestones failing any date-integrity rule / all eligible activities and milestones. Each record is counted once.", "Green: 0%; amber: >0% to 0.1%; red: >0.1%. Equal weight: green 1 point; amber 0.5; red 0.", "Task-dependent/resource-dependent activities and milestones in all statuses, including completed and unscheduled work; excludes LOE and WBS summaries. Tests include future actuals, overdue forecasts, inconsistent actual finish/status, missing data date, unknown status and reversed start/finish. Milestones require only their meaningful endpoint. Start is the imported status-aware field, not a separate raw actual-start column. Missing dates count as defects rather than leaving this denominator." },
				        { 11, "Missed dates (matched)", "Matched activities due by the data date whose current finish is later than their original baseline finish. Why it matters: Shows how often comparable work due by now has finished late or is forecast to finish late. Review the affected activities to understand where the original delivery dates are slipping. Calculation: Matched, baseline-due activities with current Finish later than baseline Finish / matched, baseline-due activities with both finish dates known.", "At most 5% — internal warning benchmark Diagnostic only.", "Whole-project task-dependent/resource-dependent activities, in all statuses, matched to the original baseline by activity code. Compares actual or forecast current finishes within the matched cohort. Missing required finishes are excluded and disclosed; unrelated Start/status warnings do not remove a usable finish comparison. Added or absent baseline activities do not enter the matched ratio. No assessable due work gives N/A. Red/green reflects the stated matched-cohort benchmark; partial inputs remain a separate warning." },
				        { 12, "Execution index (matched)", "Matched completions achieved by the data date compared with how many matched activities were due by that date. Why it matters: Compares the number of completions achieved with the number planned by now. It helps identify a shortfall in completion volume, while the missed-dates check shows whether the due activities themselves are late. Calculation: Completed activities in the eligible matched cohort / activities in that same cohort with baseline Finish on or before the data date.", "At least 0.95 — internal benchmark Diagnostic only.", "Whole-project discrete activities matched to a dated baseline, with a known completion state. Completed means Complete with actual Finish on/before the data date; open means Not Started/In Progress with no actual Finish. Displayed as a ratio. Early completions can make it exceed 1. Missing/conflicting completion evidence is excluded and disclosed; unrelated Start/current forecast Finish warnings do not block it. Added or absent activities are outside this matched cohort. No eligible baseline-due work gives N/A. Red/green reflects the stated matched-cohort benchmark; partial inputs remain a separate warning." },
				        { 13, "Baseline coverage", "How much of the current activity population has a matching original baseline activity with a known finish date. Why it matters: Shows how much current work can support a dated baseline comparison. Lower coverage prompts a review of additions, missing dates or activity-code changes before interpreting delivery trends. Calculation: Current discrete activities matched to a baseline activity with a nonblank Finish / all current discrete activities.", "100% dated coverage target Completeness indicator only; excluded from the score.", "Whole-project task-dependent/resource-dependent activities in all statuses. Requires recognised baseline provenance and unambiguous activity codes. 100% means every current eligible activity has a dated baseline match. It does not mean every original baseline activity still exists. Baseline activities absent from the current snapshot and current additions are disclosed separately. This is a coverage indicator, not a schedule-performance score." },
				        { 14, "Longest-path share", "The share of remaining activities and milestones explicitly flagged as belonging to the project's longest path. Why it matters: Shows how much remaining work is identified as part of the longest path. Changes can help focus a review on where timely delivery depends on that sequence of work. Calculation: Incomplete discrete activities and milestones with driving_path_flag = Y / all incomplete discrete activities and milestones.", "No universal target — diagnostic only Diagnostic only.", "Whole selected project/programme; task-dependent/resource-dependent activities and milestones that are Not Started or In Progress. LOE and WBS summaries are excluded. Uses the supplied Y flag only; it does not infer membership from float or blank flags. It is not a critical-path test or a recalculation of the network. Unlike the other detail options, it does not need a baseline comparison." },
				        { 15, "Remaining activities", "The number of incomplete discrete activities in this snapshot and selected core scope. Why it matters: Provides the scale of the remaining activity population so flagged counts and percentages can be interpreted in context. Changes may reflect progress, added work or restructuring. Calculation: Count of Not Started/In Progress task-dependent and resource-dependent activities.", "No pass/fail threshold Supports the activity checks; no separate score weight.", "Core activity population, including unscheduled work. Does not include milestones, completed work, LOE or WBS summaries. A population count, not a measure of remaining effort or duration. Known-input percentage denominators can be smaller. Do not sum this count across update rows." },
				        { 16, "Missing predecessors", "Incomplete discrete activities with no recorded incoming relationship. Why it matters: Identifies work whose start is not connected to preceding work. Review whether each activity is a legitimate starting point or is missing a dependency. Calculation: Count of core activities whose No Predecessor flag is 1.", "Assessed through the combined Missing logic check Included through combined Missing logic only; not scored separately.", "Core activity population. A component of Missing logic. It overlaps Missing successors when both ends are absent; do not add the two counts to derive the combined numerator. To inspect these activities, right-click the update in the counts table and select Drill through > Missing Predecessor." },
				        { 17, "Missing successors", "Incomplete discrete activities with no recorded outgoing relationship. Why it matters: Identifies work whose completion is not connected to later work. Review whether each activity is a legitimate endpoint or whether its effect on downstream delivery is missing. Calculation: Count of core activities whose No Successor flag is 1.", "Assessed through the combined Missing logic check Included through combined Missing logic only; not scored separately.", "Core activity population. A component of Missing logic. It overlaps Missing predecessors when both ends are absent; do not add the two counts to derive the combined numerator. To inspect these activities, right-click the update in the counts table and select Drill through > Missing Successor." },
				        { 18, "Zero total float", "Incomplete discrete activities with an explicitly recorded total float of exactly zero. Why it matters: Highlights work with no recorded total-float allowance. It provides a focused set of activities to review for timing sensitivity alongside the longest-path and negative-float results. Calculation: Count of core activities whose total_float equals numeric zero; blank values are not counted.", "No universal target — diagnostic only Diagnostic only.", "Core activity population. Zero float is not the same as longest-path membership and is not a critical-path test. The grid shows a count, not a percentage." }
				    }
				)

