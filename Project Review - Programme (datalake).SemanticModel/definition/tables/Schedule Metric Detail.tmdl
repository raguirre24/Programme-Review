			    "ActivityCode", '01 XER_TASK'[task_code], "BaselineFinish", '01 XER_TASK'[Finish])
			VAR CurrentActivities = SELECTCOLUMNS(CurrentRows,
			    "ActivityCode", '01 XER_TASK'[task_code], "CurrentFinish", '01 XER_TASK'[Finish], "CurrentStart", '01 XER_TASK'[Start],
			    "ActualFinish", '01 XER_TASK'[act_end_date], "ActivityStatus", '01 XER_TASK'[status_code])
			VAR MatchedActivities = NATURALINNERJOIN(BaselineActivities, CurrentActivities)
			VAR ExecutionActivities = FILTER(MatchedActivities, NOT ISBLANK([BaselineFinish]) && (([ActivityStatus] = "Complete" && NOT ISBLANK([ActualFinish]) && [ActualFinish] <= StatusDate) || ([ActivityStatus] IN {"Not Started", "In Progress"} && ISBLANK([ActualFinish]))))
			RETURN COALESCE(COUNTROWS(ExecutionActivities), 0)
		formatString: #,0
		isHidden
		displayFolder: Detail diagnostics\Internal
		lineageTag: 5a10a512-bc44-4ce1-836a-44cd9df89f19

	measure 'SM Detail Execution Due' =
			VAR ProjectCode = [SM Detail Project]
			VAR ProgrammeType = [SM Detail Programme]
			VAR SnapshotDate = [SM Detail Snapshot]
			VAR BaselineDate = [SM Detail Baseline Date]
			VAR StatusDate = [SM Detail Data Date]
			VAR BaselineRows = CALCULATETABLE('01 XER_TASK',
			    REMOVEFILTERS(),
			    TREATAS({ProjectCode}, '01 XER_TASK'[ProjectCode]),
			    TREATAS({ProgrammeType}, '01 XER_TASK'[ProgrammeType]),
			    '01 XER_TASK'[IsExcludedFromDataLake] = FALSE(),
			    TREATAS({BaselineDate}, '01 XER_TASK'[UpdateDate]),
			    '01 XER_TASK'[task_type] IN {"TT_Task", "TT_Rsrc"})
			VAR CurrentRows = CALCULATETABLE('01 XER_TASK',
			    REMOVEFILTERS(),
			    TREATAS({ProjectCode}, '01 XER_TASK'[ProjectCode]),
			    TREATAS({ProgrammeType}, '01 XER_TASK'[ProgrammeType]),
			    '01 XER_TASK'[IsExcludedFromDataLake] = FALSE(),
			    TREATAS({SnapshotDate}, '01 XER_TASK'[UpdateDate]),
			    '01 XER_TASK'[task_type] IN {"TT_Task", "TT_Rsrc"})
			VAR BaselineActivities = SELECTCOLUMNS(BaselineRows,
			    "ActivityCode", '01 XER_TASK'[task_code], "BaselineFinish", '01 XER_TASK'[Finish])
			VAR CurrentActivities = SELECTCOLUMNS(CurrentRows,
			    "ActivityCode", '01 XER_TASK'[task_code], "CurrentFinish", '01 XER_TASK'[Finish], "CurrentStart", '01 XER_TASK'[Start],
			    "ActualFinish", '01 XER_TASK'[act_end_date], "ActivityStatus", '01 XER_TASK'[status_code])
			VAR MatchedActivities = NATURALINNERJOIN(BaselineActivities, CurrentActivities)
			VAR ExecutionActivities = FILTER(MatchedActivities, NOT ISBLANK([BaselineFinish]) && (([ActivityStatus] = "Complete" && NOT ISBLANK([ActualFinish]) && [ActualFinish] <= StatusDate) || ([ActivityStatus] IN {"Not Started", "In Progress"} && ISBLANK([ActualFinish]))))
			RETURN COALESCE(COUNTROWS(FILTER(ExecutionActivities, [BaselineFinish] <= StatusDate)), 0)
		formatString: #,0
		isHidden
		displayFolder: Detail diagnostics\Internal
		lineageTag: e7ae10d8-d362-4729-a7de-583f0a32d43b

