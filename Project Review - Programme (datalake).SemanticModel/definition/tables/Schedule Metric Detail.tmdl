	measure 'SM Detail Invalid Activity Codes' =
			VAR ProjectCode = [SM Detail Project]
			VAR ProgrammeType = [SM Detail Programme]
			VAR SnapshotDate = [SM Detail Snapshot]
			VAR BaselineDate = [SM Detail Baseline Date]
			VAR StatusDate = [SM Detail Data Date]
			VAR BaselineRows = CALCULATETABLE('01 XER_TASK',
			    REMOVEFILTERS(),
			    TREATAS({ProjectCode}, '01 XER_TASK'[ProjectCode]),
			    TREATAS({ProgrammeType}, '01 XER_TASK'[ProgrammeType]),
			    '01 XER_TASK'[IsExcludedFromDataLake] = FALSE(),
			    TREATAS({BaselineDate}, '01 XER_TASK'[UpdateDate]),
			    '01 XER_TASK'[task_type] IN {"TT_Task", "TT_Rsrc"})
			VAR CurrentRows = CALCULATETABLE('01 XER_TASK',
			    REMOVEFILTERS(),
			    TREATAS({ProjectCode}, '01 XER_TASK'[ProjectCode]),
			    TREATAS({ProgrammeType}, '01 XER_TASK'[ProgrammeType]),
			    '01 XER_TASK'[IsExcludedFromDataLake] = FALSE(),
			    TREATAS({SnapshotDate}, '01 XER_TASK'[UpdateDate]),
			    '01 XER_TASK'[task_type] IN {"TT_Task", "TT_Rsrc"})
			VAR BaselineActivities = SELECTCOLUMNS(BaselineRows,
			    "ActivityCode", '01 XER_TASK'[task_code], "BaselineFinish", '01 XER_TASK'[Finish])
			VAR CurrentActivities = SELECTCOLUMNS(CurrentRows,
			    "ActivityCode", '01 XER_TASK'[task_code], "CurrentFinish", '01 XER_TASK'[Finish], "CurrentStart", '01 XER_TASK'[Start],
			    "ActualFinish", '01 XER_TASK'[act_end_date], "ActivityStatus", '01 XER_TASK'[status_code])
			VAR MatchedActivities = NATURALINNERJOIN(BaselineActivities, CurrentActivities)
			RETURN COALESCE(COUNTROWS(BaselineRows), 0) - COALESCE(COUNTROWS(SUMMARIZE(BaselineRows, '01 XER_TASK'[task_code])), 0) + COALESCE(COUNTROWS(CurrentRows), 0) - COALESCE(COUNTROWS(SUMMARIZE(CurrentRows, '01 XER_TASK'[task_code])), 0) + COALESCE(COUNTROWS(FILTER(BaselineRows, ISBLANK('01 XER_TASK'[task_code]) || TRIM('01 XER_TASK'[task_code]) = "")), 0) + COALESCE(COUNTROWS(FILTER(CurrentRows, ISBLANK('01 XER_TASK'[task_code]) || TRIM('01 XER_TASK'[task_code]) = "")), 0)
		formatString: #,0
		isHidden
		displayFolder: Detail diagnostics\Internal
		lineageTag: f2454ced-4095-4421-9cdc-7b4a84309a86

	measure 'SM Detail Baseline Message' =
			SWITCH(TRUE(),
			    [SM Detail Scope Message] <> "", [SM Detail Scope Message],
			    NOT [SM Detail Baseline Provenance], "N/A: the earliest snapshot is not one verified BL-tagged file.",
			    [SM Detail Current Activities] = 0, "N/A: no task-dependent or resource-dependent activities in this snapshot.",
			    [SM Detail Invalid Activity Codes] > 0, "N/A: blank or duplicate activity codes in the baseline or current snapshot.",
			    [SM Detail Matched Activities] = 0, "N/A: no current activities match the baseline.",
			    [SM Detail Baseline Due] = 0, "N/A: no matched baseline activities are due by the data date.",
			    "")
		isHidden
		displayFolder: Detail diagnostics\Internal
		lineageTag: 664b9c1a-6ea4-4ecc-a270-22bafae41fd3

	/// Custom matched-scope missed-date ratio. Uses matched baseline-due rows with known baseline/current Finish; unrelated Start/status warnings do not exclude usable finishes. Tooltip discloses excluded rows.
	measure 'SM Matched Baseline Missed %' =
			IF([SM Detail Baseline Message] = "",
			    DIVIDE([SM Detail Missed Due], [SM Detail Missed Assessable Due]))
		formatString: 0.0%
		displayFolder: Detail diagnostics
		lineageTag: bb08aa7b-48b3-47e8-94dc-475a51cb916c

	/// Custom matched-scope execution index. Uses dated baseline matches with known completion state in both cohorts; missing/conflicting completion inputs are excluded and disclosed. Early completions can exceed one.
	measure 'SM Matched Baseline Execution Index' =
			IF([SM Detail Baseline Message] = "",
			    DIVIDE([SM Detail Matched Completed], [SM Detail Execution Due]))
		formatString: 0.00
		displayFolder: Detail diagnostics
		lineageTag: 787ed098-aa82-4416-b764-d289c01d73b8

	/// Current task-dependent/resource-dependent activities with a matching, dated original baseline divided by all current activities in that population.
	measure 'SM Baseline Coverage %' =
			IF([SM Detail Scope Message] = "" && [SM Detail Baseline Provenance] && [SM Detail Invalid Activity Codes] = 0,
			    DIVIDE([SM Detail Dated Matches], [SM Detail Current Activities]))
		formatString: 0.0%
		displayFolder: Detail diagnostics
		lineageTag: a90a90f9-c697-483c-87c9-cdca333bec9b

	measure 'SM Detail Open Activities' =
			VAR ProjectCode = [SM Detail Project]
			VAR ProgrammeType = [SM Detail Programme]
			VAR SnapshotDate = [SM Detail Snapshot]
			VAR OpenActivities = CALCULATETABLE('01 XER_TASK',
			    REMOVEFILTERS(),
			    TREATAS({ProjectCode}, '01 XER_TASK'[ProjectCode]),
			    TREATAS({ProgrammeType}, '01 XER_TASK'[ProgrammeType]),
			    '01 XER_TASK'[IsExcludedFromDataLake] = FALSE(),
			    TREATAS({SnapshotDate}, '01 XER_TASK'[UpdateDate]),
			    '01 XER_TASK'[task_type] IN {"TT_Task", "TT_Rsrc", "TT_Mile", "TT_FinMile"},
			    '01 XER_TASK'[status_code] IN {"Not Started", "In Progress"})
			RETURN COALESCE(COUNTROWS(OpenActivities), 0)
		formatString: #,0
		isHidden
		displayFolder: Detail diagnostics\Internal
		lineageTag: 4377c82e-6022-495c-88ef-5c62af125110

	measure 'SM Detail Longest Path Activities' =
			VAR ProjectCode = [SM Detail Project]
			VAR ProgrammeType = [SM Detail Programme]
			VAR SnapshotDate = [SM Detail Snapshot]
			VAR OpenActivities = CALCULATETABLE('01 XER_TASK',
			    REMOVEFILTERS(),
			    TREATAS({ProjectCode}, '01 XER_TASK'[ProjectCode]),
			    TREATAS({ProgrammeType}, '01 XER_TASK'[ProgrammeType]),
			    '01 XER_TASK'[IsExcludedFromDataLake] = FALSE(),
			    TREATAS({SnapshotDate}, '01 XER_TASK'[UpdateDate]),
			    '01 XER_TASK'[task_type] IN {"TT_Task", "TT_Rsrc", "TT_Mile", "TT_FinMile"},
			    '01 XER_TASK'[status_code] IN {"Not Started", "In Progress"})
			RETURN COALESCE(COUNTROWS(FILTER(OpenActivities, '01 XER_TASK'[driving_path_flag] = "Y")), 0)
