table '04 XER_BASELINE'
	lineageTag: af4b1256-6095-4e3f-9357-ed2535c6aeb5

	column task_id_key
		isHidden
		isAvailableInMdx: false
		lineageTag: e06edf12-2c30-41d2-a790-8e28cdc16ad4
		summarizeBy: none
		isNameInferred
		sourceColumn: [task_id_key]

		annotation SummarizationSetBy = Automatic

	column Finish
		formatString: dd/mm/yyyy
		lineageTag: 9ee2acaf-d4bd-4671-ac51-f752a5c0816d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Finish]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	partition '04 XER_BASELINE' = calculated
		mode: import
		source =
				
				// Baseline rows: each project and programme type's earliest update, selected in one FILTER pass over the tasks.
				// No CALCULATE, CALCULATETABLE or context transition here: they depend on 01's relationships, including the
				// one-to-one link back to this table, and Desktop rejects that as a circular dependency.
				VAR FirstUpdates =
				    SUMMARIZE(
				        '01 XER_TASK',
				        '01 XER_TASK'[ProjectCode],
				        '01 XER_TASK'[ProgrammeType],
				        "First_Project_Month", MIN( '01 XER_TASK'[UpdateDate] )
				    )
				RETURN
				    SELECTCOLUMNS(
				        FILTER(
				            '01 XER_TASK',
				            ( '01 XER_TASK'[ProjectCode], '01 XER_TASK'[ProgrammeType], '01 XER_TASK'[UpdateDate] ) IN FirstUpdates
				        ),
				        "task_id_key", '01 XER_TASK'[task_id_key],
				        "Finish", '01 XER_TASK'[Finish]
				    )

	annotation PBI_Id = 960966e01ba34e338059b5ad6d0b01ab

