table 'Monthly Resource Distribution Baseline'
	lineageTag: fa1cf293-638c-4a26-8dd7-9b7d1bbee83f

	column distribution_month
		lineageTag: d0438b2e-0560-468e-a64f-e09f6bd24bc2
		isNameInferred
		sourceColumn: [distribution_month]

	column ProjectCode
		lineageTag: 6b653616-608d-4155-bc7d-1fac65c713bd
		isNameInferred
		sourceColumn: [ProjectCode]

	column monthly_hours
		lineageTag: 3d0deae2-c097-4fcd-b799-aba906d09e96
		isNameInferred
		sourceColumn: [monthly_hours]

	column task_code
		lineageTag: 7a82914c-1d54-4a29-873b-592b1a03f421
		isNameInferred
		sourceColumn: [task_code]

	column rsrc_name
		lineageTag: b6591024-5d18-4e89-a212-38b9c104e743
		isNameInferred
		sourceColumn: [rsrc_name]

	column rsrc_type
		lineageTag: 914028fa-7104-4c8d-bf9e-a89e47201b22
		isNameInferred
		sourceColumn: [rsrc_type]

	partition 'Monthly Resource Distribution Baseline' = calculated
		mode: import
		source =
				
				SELECTCOLUMNS(
				    FILTER(
				        '15_XER_RESOURCE_DISTRIBUTION',
				        '15_XER_RESOURCE_DISTRIBUTION'[task_id_key] IN VALUES('04 XER_BASELINE'[task_id_key])
				    ),
				    "distribution_month", '15_XER_RESOURCE_DISTRIBUTION'[distribution_month],
				    "ProjectCode", '15_XER_RESOURCE_DISTRIBUTION'[ProjectCode],
				    "task_code", RELATED('01 XER_TASK'[task_code]),
				    "rsrc_name", '15_XER_RESOURCE_DISTRIBUTION'[rsrc_name],
				    "rsrc_type", '15_XER_RESOURCE_DISTRIBUTION'[rsrc_type],
				    "monthly_hours", '15_XER_RESOURCE_DISTRIBUTION'[monthly_hours]
				)

	annotation PBI_Id = e8e5aed95e8c4576a9cdbf22ecc98dbc

