	measure 'Variance to Previous Update (History)' =
			
			// CurrentDate sets the last update shown; earlier updates stay on the disconnected UpdateHistory axis.
			VAR SelectedUpdate = MAX(CurrentDate[UpdateDate])
			VAR HistoryUpdates =
			    FILTER(
			        VALUES(UpdateHistory[UpdateDate]),
			        UpdateHistory[UpdateDate] <= SelectedUpdate
			    )
			// Narrowed activities (see 'Is Activity Selection') are fixed to those shown for the CurrentDate update, then
			// traced through every update by task_code, wherever they sat in the WBS and whatever their status at the time.
			VAR IsSelection = [Is Activity Selection]
			VAR SelectedTaskCodes = VALUES('01 XER_TASK'[task_code])
			// The chart follows the single project shown at the CurrentDate update; blank for none or several.
			VAR SelectedProjects = VALUES('01 XER_TASK'[ProjectName])
			RETURN
			    IF(
			        COUNTROWS(SelectedProjects) = 1,
			        SUMX(
			            HistoryUpdates,
			            VAR AxisUpdate = UpdateHistory[UpdateDate]
			            RETURN
			                IF(
			                    IsSelection,
			                    CALCULATE(
			                        IF(NOT ISEMPTY('01 XER_TASK'), [Variance to Previous Update]),
			                        REMOVEFILTERS('01 XER_TASK'),
			                        REMOVEFILTERS('03 XER_PROJWBS'),
			                        REMOVEFILTERS('09 XER_TASKACTV'),
			                        REMOVEFILTERS(CurrentDate),
			                        SelectedTaskCodes,
			                        SelectedProjects,
			                        TREATAS({ AxisUpdate }, '01 XER_TASK'[UpdateDate])
			                    ),
			                    CALCULATE(
			                        IF(NOT ISEMPTY('01 XER_TASK'), [Variance to Previous Update]),
			                        REMOVEFILTERS(CurrentDate),
			                        SelectedProjects,
			                        TREATAS({ AxisUpdate }, '01 XER_TASK'[UpdateDate])
			                    )
			                )
			        )
			    )
		formatString: 0
		lineageTag: 43d29fba-4880-4513-86d4-b34c7a29555a

	measure 'Latest Finish (History)' =
			
			// Tooltip partner for 'Variance to Previous Update (History)'; blank after the selected update so no extra axis months appear.
			VAR SelectedUpdate = MAX(CurrentDate[UpdateDate])
			VAR HistoryUpdates =
			    FILTER(
			        VALUES(UpdateHistory[UpdateDate]),
			        UpdateHistory[UpdateDate] <= SelectedUpdate
			    )
			// Same selection tracing and project rule as 'Variance to Previous Update (History)': each traced task's
			// last reported finish, shown only for updates that contain at least one traced task.
			VAR IsSelection = [Is Activity Selection]
			VAR SelectedTaskCodes = VALUES('01 XER_TASK'[task_code])
			VAR SelectedProjects = VALUES('01 XER_TASK'[ProjectName])
			VAR AsOfUpdate = MAXX(HistoryUpdates, UpdateHistory[UpdateDate])
			RETURN
			    IF(
			        COUNTROWS(SelectedProjects) = 1,
			        IF(
			            IsSelection,
			            CALCULATE(
			                VAR IsPresent =
			                    NOT ISEMPTY(
			                        CALCULATETABLE(
			                            '01 XER_TASK',
			                            TREATAS(HistoryUpdates, '01 XER_TASK'[UpdateDate])
			                        )
			                    )
			                VAR LastSeen =
			                    CALCULATETABLE(
			                        ADDCOLUMNS(
			                            VALUES('01 XER_TASK'[task_code]),
			                            "@LastUpdate", CALCULATE(MAX('01 XER_TASK'[UpdateDate]))
			                        ),
			                        '01 XER_TASK'[UpdateDate] <= AsOfUpdate,
			                        NOT ISBLANK('01 XER_TASK'[Finish])
			                    )
			                RETURN
			                    IF(
			                        IsPresent,
			                        CALCULATE(
			                            MAX('01 XER_TASK'[Finish]),
			                            TREATAS(LastSeen, '01 XER_TASK'[task_code], '01 XER_TASK'[UpdateDate])
			                        )
			                    ),
			                REMOVEFILTERS('01 XER_TASK'),
			                REMOVEFILTERS('03 XER_PROJWBS'),
			                REMOVEFILTERS('09 XER_TASKACTV'),
			                REMOVEFILTERS(CurrentDate),
			                SelectedTaskCodes,
			                SelectedProjects
			            ),
			            CALCULATE(
			                MAX('01 XER_TASK'[Finish]),
			                REMOVEFILTERS(CurrentDate),
			                SelectedProjects,
			                TREATAS(HistoryUpdates, '01 XER_TASK'[UpdateDate])
			            )
			        )
			    )
		formatString: dd/mm/yyyy
		lineageTag: db31a615-edfe-41c7-929b-f28bac3b90fa

	measure 'Is Activity Selection' =
			
			// True when slicers or selections narrow the activities: matrix rows, task code/name searches, WBS,
			// or the activity slicers (critical, driving, task type, float, duration, constraint, activity codes).
			// The completion-variance waterfall then traces exactly those activities by task_code. Activity status
			// and the variance slicers are deliberately excluded; they don't filter the waterfall.
			ISFILTERED('01 XER_TASK'[task_code]) ||
			ISFILTERED('01 XER_TASK'[task_name]) ||
			ISFILTERED('03 XER_PROJWBS'[Level_2]) ||
			ISFILTERED('03 XER_PROJWBS'[Level_3]) ||
			ISFILTERED('03 XER_PROJWBS'[Level_4]) ||
			ISFILTERED('03 XER_PROJWBS'[Level_5]) ||
			ISFILTERED('03 XER_PROJWBS'[Level_6]) ||
			ISFILTERED('03 XER_PROJWBS'[Level_7]) ||
			ISFILTERED(Filter_Critical_Status) ||
			ISFILTERED(Filter_Driving) ||
			ISFILTERED(Filter_TaskType) ||
			ISFILTERED(Filter_Float) ||
			ISFILTERED(Filter_Duration) ||
			ISFILTERED(Filter_Constraint_Types) ||
			ISFILTERED('09 XER_TASKACTV')
		isHidden
		lineageTag: 7f9f8a05-f23c-425d-af51-1180591ecc51

	/// First day of the month containing the selected snapshot's Data Date.
	measure 'CA Horizon Start Month' =
			VAR RawDataDate =
			    CALCULATE(
			        MAX('01 XER_TASK'[data_date]),
			        REMOVEFILTERS('01 XER_TASK'[task_code], '01 XER_TASK'[task_name], '01 XER_TASK'[calendar_id_key], '01 XER_TASK'[Calendar])
			    )
			RETURN
			    IF(NOT ISBLANK(RawDataDate), DATE(YEAR(RawDataDate), MONTH(RawDataDate), 1))
		formatString: dd/mm/yyyy
		displayFolder: Calendar Analysis
		lineageTag: e06577db-71a4-52fc-a922-f4c59385dba1

	/// First day of the month containing the latest forecast Finish date among incomplete activities in the selected snapshot.
	measure 'CA Horizon End Month' =
			VAR MaxFinish =
			    CALCULATE(
			        MAX('01 XER_TASK'[Finish]),
			        '01 XER_TASK'[status_code] <> "Complete",
			        REMOVEFILTERS('01 XER_TASK'[task_code], '01 XER_TASK'[task_name], '01 XER_TASK'[calendar_id_key], '01 XER_TASK'[Calendar])
			    )
			VAR MaxAxisMonth = CALCULATE(MAX('Scenario Date'[Month]), REMOVEFILTERS('Scenario Date'))
			VAR CandidateMonth = IF(NOT ISBLANK(MaxFinish), DATE(YEAR(MaxFinish), MONTH(MaxFinish), 1))
			RETURN
			    IF(NOT ISBLANK(CandidateMonth), MIN(CandidateMonth, MaxAxisMonth))
		formatString: dd/mm/yyyy
		displayFolder: Calendar Analysis
		lineageTag: f2b4b16d-307a-53aa-aa21-65b4d7b3ed4d

	/// Resolved working days for the calendar and month (7 weekday rules plus net dated exception overrides), bounded to the active project forecast horizon.
	measure 'CA Monthly Working Days' =
			VAR CalKey = SELECTEDVALUE('Scenario Calendar'[clndr_id_key])
			VAR ProjKey = SELECTEDVALUE('Scenario Calendar'[ProjectKey])
			VAR CsvFlag = SELECTEDVALUE('Scenario Calendar'[IsCsvSource])
			VAR MonthStart = MIN('Scenario Date'[Date])
			VAR MonthEnd = MAX('Scenario Date'[Date])
			VAR HorizonStart = [CA Horizon Start Month]
			VAR HorizonEnd = [CA Horizon End Month]
			VAR ActiveTasks = [CA Incomplete Activity Count]
			RETURN
			    IF(
			        COUNTROWS('Scenario Calendar') = 1
			            && HASONEVALUE('Scenario Date'[Month])
			            && NOT ISBLANK(CalKey)
			            && NOT ISBLANK(ActiveTasks) && ActiveTasks > 0
			            && NOT ISBLANK(HorizonStart) && NOT ISBLANK(HorizonEnd)
			            && MonthStart >= HorizonStart && MonthStart <= HorizonEnd,
			        VAR CalendarRows =
			            CALCULATETABLE(
			                '11 XER_CALENDAR_DETAILED',
			                REMOVEFILTERS('11 XER_CALENDAR_DETAILED'),
			                KEEPFILTERS(TREATAS({ CalKey }, '11 XER_CALENDAR_DETAILED'[clndr_id_key])),
			                KEEPFILTERS(TREATAS({ ProjKey }, '11 XER_CALENDAR_DETAILED'[ProjectKey])),
			                KEEPFILTERS(TREATAS({ CsvFlag }, '11 XER_CALENDAR_DETAILED'[IsCsvSource]))
			            )
			        VAR WeekRows =
			            FILTER(
			                CalendarRows,
			                ISBLANK('11 XER_CALENDAR_DETAILED'[date])
			                    && '11 XER_CALENDAR_DETAILED'[exception_type] == "Standard"
			                    && NOT ISBLANK('11 XER_CALENDAR_DETAILED'[work_hours])
			                    && '11 XER_CALENDAR_DETAILED'[work_hours] >= 0
			            )
			        VAR ValidWeekdays =
			            COUNTROWS(WeekRows) = 7
			                && COUNTROWS(DISTINCT(SELECTCOLUMNS(WeekRows, "__Dow", '11 XER_CALENDAR_DETAILED'[day_of_week_num]))) = 7
			        VAR InvalidUndated =
			            COUNTROWS(FILTER(CalendarRows, ISBLANK('11 XER_CALENDAR_DETAILED'[date]) && '11 XER_CALENDAR_DETAILED'[exception_type] <> "Standard")) > 0
			        VAR MonthExceptions =
			            FILTER(
			                CalendarRows,
			                NOT ISBLANK('11 XER_CALENDAR_DETAILED'[date])
			                    && '11 XER_CALENDAR_DETAILED'[date] >= MonthStart
			                    && '11 XER_CALENDAR_DETAILED'[date] <= MonthEnd
			            )
			        VAR InvalidMonthExceptions =
			            COUNTROWS(
			                FILTER(
			                    MonthExceptions,
			                    ISBLANK('11 XER_CALENDAR_DETAILED'[work_hours])
			                        || '11 XER_CALENDAR_DETAILED'[work_hours] < 0
			                        || '11 XER_CALENDAR_DETAILED'[exception_type] == "Exception - Invalid"
			                )
			            ) > 0
			        RETURN
			            IF(
			                ValidWeekdays && NOT InvalidUndated && NOT InvalidMonthExceptions,
			                VAR SpanDays = INT(MonthEnd - MonthStart) + 1
			                VAR StartDow = WEEKDAY(MonthStart, 2)
			                VAR FullWeeks = QUOTIENT(SpanDays, 7)
			                VAR ExtraDays = MOD(SpanDays, 7)
			                VAR StandardDays =
			                    SUMX(
			                        WeekRows,
			                        VAR RuleDow = '11 XER_CALENDAR_DETAILED'[day_of_week_num]
			                        VAR Occurrences = FullWeeks + IF(MOD(RuleDow - StartDow, 7) < ExtraDays, 1, 0)
			                        RETURN Occurrences * IF('11 XER_CALENDAR_DETAILED'[work_hours] > 0, 1, 0)
			                    )
			                VAR ExceptionDelta =
			                    SUMX(
			                        MonthExceptions,
			                        VAR ExcDow = WEEKDAY('11 XER_CALENDAR_DETAILED'[date], 2)
			                        VAR NormalHours = MAXX(FILTER(WeekRows, '11 XER_CALENDAR_DETAILED'[day_of_week_num] = ExcDow), '11 XER_CALENDAR_DETAILED'[work_hours])
			                        VAR ExcHours = '11 XER_CALENDAR_DETAILED'[work_hours]
			                        RETURN IF(ExcHours > 0, 1, 0) - IF(NormalHours > 0, 1, 0)
			                    )
			                RETURN MAX(0, StandardDays + ExceptionDelta)
			            )
			    )
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: 830e1e0a-15f8-585d-88a2-2f2aed0fe0d9

	/// Baseline monthly working days from the calendar's 7-day standard workweek rule before dated exceptions.
	measure 'CA Monthly Standard Working Days' =
			VAR CalKey = SELECTEDVALUE('Scenario Calendar'[clndr_id_key])
			VAR ProjKey = SELECTEDVALUE('Scenario Calendar'[ProjectKey])
			VAR CsvFlag = SELECTEDVALUE('Scenario Calendar'[IsCsvSource])
			VAR MonthStart = MIN('Scenario Date'[Date])
			VAR MonthEnd = MAX('Scenario Date'[Date])
			VAR HorizonStart = [CA Horizon Start Month]
			VAR HorizonEnd = [CA Horizon End Month]
			VAR ActiveTasks = [CA Incomplete Activity Count]
			RETURN
			    IF(
			        COUNTROWS('Scenario Calendar') = 1
			            && HASONEVALUE('Scenario Date'[Month])
			            && NOT ISBLANK(CalKey)
			            && NOT ISBLANK(ActiveTasks) && ActiveTasks > 0
			            && NOT ISBLANK(HorizonStart) && NOT ISBLANK(HorizonEnd)
			            && MonthStart >= HorizonStart && MonthStart <= HorizonEnd,
			        VAR CalendarRows =
			            CALCULATETABLE(
			                '11 XER_CALENDAR_DETAILED',
			                REMOVEFILTERS('11 XER_CALENDAR_DETAILED'),
			                KEEPFILTERS(TREATAS({ CalKey }, '11 XER_CALENDAR_DETAILED'[clndr_id_key])),
			                KEEPFILTERS(TREATAS({ ProjKey }, '11 XER_CALENDAR_DETAILED'[ProjectKey])),
			                KEEPFILTERS(TREATAS({ CsvFlag }, '11 XER_CALENDAR_DETAILED'[IsCsvSource]))
			            )
			        VAR WeekRows =
			            FILTER(
			                CalendarRows,
			                ISBLANK('11 XER_CALENDAR_DETAILED'[date])
			                    && '11 XER_CALENDAR_DETAILED'[exception_type] == "Standard"
			                    && NOT ISBLANK('11 XER_CALENDAR_DETAILED'[work_hours])
			                    && '11 XER_CALENDAR_DETAILED'[work_hours] >= 0
			            )
			        VAR ValidWeekdays =
			            COUNTROWS(WeekRows) = 7
			                && COUNTROWS(DISTINCT(SELECTCOLUMNS(WeekRows, "__Dow", '11 XER_CALENDAR_DETAILED'[day_of_week_num]))) = 7
			        RETURN
			            IF(
			                ValidWeekdays,
			                VAR SpanDays = INT(MonthEnd - MonthStart) + 1
			                VAR StartDow = WEEKDAY(MonthStart, 2)
			                VAR FullWeeks = QUOTIENT(SpanDays, 7)
			                VAR ExtraDays = MOD(SpanDays, 7)
			                RETURN
			                    SUMX(
			                        WeekRows,
			                        VAR RuleDow = '11 XER_CALENDAR_DETAILED'[day_of_week_num]
			                        VAR Occurrences = FullWeeks + IF(MOD(RuleDow - StartDow, 7) < ExtraDays, 1, 0)
			                        RETURN Occurrences * IF('11 XER_CALENDAR_DETAILED'[work_hours] > 0, 1, 0)
			                    )
			            )
			    )
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: 323c17e4-a6bb-589f-8837-d916ade2f27b

	/// Net working days gained (+) or lost (-) in the month from dated calendar exceptions relative to the standard workweek.
	measure 'CA Monthly Exception Delta Days' =
			VAR WorkDays = [CA Monthly Working Days]
			VAR StdDays = [CA Monthly Standard Working Days]
			RETURN
			    IF(NOT ISBLANK(WorkDays) && NOT ISBLANK(StdDays), WorkDays - StdDays)
		formatString: +#,0;-#,0;0
		displayFolder: Calendar Analysis
		lineageTag: 472b5580-ad3e-5b34-a447-e3f07879e91c

	/// Total non-working civil days in the month for the selected calendar (routine weekend/off days plus net exception blackouts).
	measure 'CA Monthly Non-Working Days' =
			VAR WorkDays = [CA Monthly Working Days]
			VAR SpanDays = INT(MAX('Scenario Date'[Date]) - MIN('Scenario Date'[Date])) + 1
			RETURN
			    IF(NOT ISBLANK(WorkDays), MAX(0, SpanDays - WorkDays))
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: 110d119d-8738-5f4a-9e56-8ba89715dcf2

	/// Total resolved working hours in the month for the selected calendar.
	measure 'CA Monthly Working Hours' =
			VAR CalKey = SELECTEDVALUE('Scenario Calendar'[clndr_id_key])
			VAR ProjKey = SELECTEDVALUE('Scenario Calendar'[ProjectKey])
			VAR CsvFlag = SELECTEDVALUE('Scenario Calendar'[IsCsvSource])
			VAR MonthStart = MIN('Scenario Date'[Date])
			VAR MonthEnd = MAX('Scenario Date'[Date])
			VAR HorizonStart = [CA Horizon Start Month]
			VAR HorizonEnd = [CA Horizon End Month]
			VAR ActiveTasks = [CA Incomplete Activity Count]
			RETURN
			    IF(
			        COUNTROWS('Scenario Calendar') = 1
			            && HASONEVALUE('Scenario Date'[Month])
			            && NOT ISBLANK(CalKey)
			            && NOT ISBLANK(ActiveTasks) && ActiveTasks > 0
			            && NOT ISBLANK(HorizonStart) && NOT ISBLANK(HorizonEnd)
			            && MonthStart >= HorizonStart && MonthStart <= HorizonEnd,
			        VAR CalendarRows =
			            CALCULATETABLE(
			                '11 XER_CALENDAR_DETAILED',
			                REMOVEFILTERS('11 XER_CALENDAR_DETAILED'),
			                KEEPFILTERS(TREATAS({ CalKey }, '11 XER_CALENDAR_DETAILED'[clndr_id_key])),
			                KEEPFILTERS(TREATAS({ ProjKey }, '11 XER_CALENDAR_DETAILED'[ProjectKey])),
			                KEEPFILTERS(TREATAS({ CsvFlag }, '11 XER_CALENDAR_DETAILED'[IsCsvSource]))
			            )
			        VAR WeekRows =
			            FILTER(
			                CalendarRows,
			                ISBLANK('11 XER_CALENDAR_DETAILED'[date])
			                    && '11 XER_CALENDAR_DETAILED'[exception_type] == "Standard"
			                    && NOT ISBLANK('11 XER_CALENDAR_DETAILED'[work_hours])
			                    && '11 XER_CALENDAR_DETAILED'[work_hours] >= 0
			            )
			        VAR ValidWeekdays =
			            COUNTROWS(WeekRows) = 7
			                && COUNTROWS(DISTINCT(SELECTCOLUMNS(WeekRows, "__Dow", '11 XER_CALENDAR_DETAILED'[day_of_week_num]))) = 7
			        VAR MonthExceptions =
			            FILTER(
			                CalendarRows,
			                NOT ISBLANK('11 XER_CALENDAR_DETAILED'[date])
			                    && '11 XER_CALENDAR_DETAILED'[date] >= MonthStart
			                    && '11 XER_CALENDAR_DETAILED'[date] <= MonthEnd
			                    && NOT ISBLANK('11 XER_CALENDAR_DETAILED'[work_hours])
			                    && '11 XER_CALENDAR_DETAILED'[work_hours] >= 0
			            )
			        RETURN
			            IF(
			                ValidWeekdays,
			                VAR SpanDays = INT(MonthEnd - MonthStart) + 1
			                VAR StartDow = WEEKDAY(MonthStart, 2)
			                VAR FullWeeks = QUOTIENT(SpanDays, 7)
			                VAR ExtraDays = MOD(SpanDays, 7)
			                VAR StandardHours =
			                    SUMX(
			                        WeekRows,
			                        VAR RuleDow = '11 XER_CALENDAR_DETAILED'[day_of_week_num]
			                        VAR Occurrences = FullWeeks + IF(MOD(RuleDow - StartDow, 7) < ExtraDays, 1, 0)
			                        RETURN Occurrences * '11 XER_CALENDAR_DETAILED'[work_hours]
			                    )
			                VAR ExceptionDeltaHours =
			                    SUMX(
			                        MonthExceptions,
			                        VAR ExcDow = WEEKDAY('11 XER_CALENDAR_DETAILED'[date], 2)
			                        VAR NormalHours = MAXX(FILTER(WeekRows, '11 XER_CALENDAR_DETAILED'[day_of_week_num] = ExcDow), '11 XER_CALENDAR_DETAILED'[work_hours])
			                        RETURN '11 XER_CALENDAR_DETAILED'[work_hours] - NormalHours
			                    )
			                RETURN MAX(0, StandardHours + ExceptionDeltaHours)
			            )
			    )
		formatString: #,0.0
		displayFolder: Calendar Analysis
		lineageTag: 0af24984-1b00-5c50-82da-92b24fc348a8

	/// Incomplete critical activities (Total Float <= 0) on this calendar whose remaining execution window overlaps the month.
	measure 'CA Monthly Critical Activities' =
			VAR CalKey = SELECTEDVALUE('Scenario Calendar'[clndr_id_key])
			VAR MonthStart = MIN('Scenario Date'[Date])
			VAR MonthEnd = MAX('Scenario Date'[Date])
			VAR HorizonStart = [CA Horizon Start Month]
			VAR HorizonEnd = [CA Horizon End Month]
			VAR ActiveTasks = [CA Incomplete Activity Count]
			RETURN
			    IF(
			        COUNTROWS('Scenario Calendar') = 1
			            && HASONEVALUE('Scenario Date'[Month])
			            && NOT ISBLANK(CalKey)
			            && NOT ISBLANK(ActiveTasks) && ActiveTasks > 0
			            && NOT ISBLANK(HorizonStart) && NOT ISBLANK(HorizonEnd)
			            && MonthStart >= HorizonStart && MonthStart <= HorizonEnd,
			        COALESCE(
			            CALCULATE(
			                COUNTROWS(
			                    FILTER(
			                        '01 XER_TASK',
			                        '01 XER_TASK'[status_code] <> "Complete"
			                            && '01 XER_TASK'[TaskType_Classified] = "Activity"
			                            && NOT ISBLANK('01 XER_TASK'[total_float])
			                            && '01 XER_TASK'[total_float] <= 0
			                            && NOT ISBLANK('01 XER_TASK'[Finish])
			                            && MAX('01 XER_TASK'[Start], '01 XER_TASK'[data_date]) <= MonthEnd
			                            && '01 XER_TASK'[Finish] >= MonthStart
			                    )
			                ),
			                KEEPFILTERS(TREATAS({ CalKey }, '01 XER_TASK'[calendar_id_key]))
			            ),
			            0
			        )
			    )
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: 29dbea8f-a064-5a7d-8eb0-377557f3c073

	/// Summary of the calendar's standard 7-day workweek rule (working days per week, hours per day, and weekly hours).
	measure 'CA Workweek Signature' =
			VAR CalKey = SELECTEDVALUE('Scenario Calendar'[clndr_id_key])
			VAR ProjKey = SELECTEDVALUE('Scenario Calendar'[ProjectKey])
			VAR CsvFlag = SELECTEDVALUE('Scenario Calendar'[IsCsvSource])
			VAR ActiveTasks = [CA Incomplete Activity Count]
			RETURN
			    IF(
			        COUNTROWS('Scenario Calendar') = 1
			            && NOT ISBLANK(CalKey)
			            && NOT ISBLANK(ActiveTasks) && ActiveTasks > 0,
			        VAR CalendarRows =
			            CALCULATETABLE(
			                '11 XER_CALENDAR_DETAILED',
			                REMOVEFILTERS('11 XER_CALENDAR_DETAILED'),
			                KEEPFILTERS(TREATAS({ CalKey }, '11 XER_CALENDAR_DETAILED'[clndr_id_key])),
			                KEEPFILTERS(TREATAS({ ProjKey }, '11 XER_CALENDAR_DETAILED'[ProjectKey])),
			                KEEPFILTERS(TREATAS({ CsvFlag }, '11 XER_CALENDAR_DETAILED'[IsCsvSource]))
			            )
			        VAR WeekRows =
			            FILTER(
			                CalendarRows,
			                ISBLANK('11 XER_CALENDAR_DETAILED'[date])
			                    && '11 XER_CALENDAR_DETAILED'[exception_type] == "Standard"
			                    && NOT ISBLANK('11 XER_CALENDAR_DETAILED'[work_hours])
			                    && '11 XER_CALENDAR_DETAILED'[work_hours] >= 0
			            )
			        VAR ValidWeekdays =
			            COUNTROWS(WeekRows) = 7
			                && COUNTROWS(DISTINCT(SELECTCOLUMNS(WeekRows, "__Dow", '11 XER_CALENDAR_DETAILED'[day_of_week_num]))) = 7
			        VAR PositiveRows = FILTER(WeekRows, '11 XER_CALENDAR_DETAILED'[work_hours] > 0)
			        VAR WorkDaysPerWeek = COUNTROWS(PositiveRows)
			        VAR WeeklyHours = SUMX(WeekRows, '11 XER_CALENDAR_DETAILED'[work_hours])
			        VAR MinHours = MINX(PositiveRows, '11 XER_CALENDAR_DETAILED'[work_hours])
			        VAR MaxHours = MAXX(PositiveRows, '11 XER_CALENDAR_DETAILED'[work_hours])
			        VAR MinHoursText = IF(ABS(MinHours - ROUND(MinHours, 0)) < 0.05, FORMAT(ROUND(MinHours, 0), "0"), FORMAT(MinHours, "0.0"))
			        VAR MaxHoursText = IF(ABS(MaxHours - ROUND(MaxHours, 0)) < 0.05, FORMAT(ROUND(MaxHours, 0), "0"), FORMAT(MaxHours, "0.0"))
			        VAR WeeklyHoursText = IF(ABS(WeeklyHours - ROUND(WeeklyHours, 0)) < 0.05, FORMAT(ROUND(WeeklyHours, 0), "0"), FORMAT(WeeklyHours, "0.0"))
			        RETURN
			            IF(
			                NOT ValidWeekdays,
			                "Invalid / incomplete rule",
			                IF(
			                    WorkDaysPerWeek = 0,
			                    "0d/wk (0h)",
			                    FORMAT(WorkDaysPerWeek, "0") & "d/wk | "
			                        & IF(
			                            ABS(MaxHours - MinHours) < 0.01,
			                            MaxHoursText & "h/d",
			                            MinHoursText & "–" & MaxHoursText & "h/d"
			                        )
			                        & " (" & WeeklyHoursText & "h)"
			                )
			            )
			    )
		formatString: @
		displayFolder: Calendar Analysis
		lineageTag: 378e058a-66be-5db9-8e31-61c56538ae23

	/// Count of future dated non-working holidays/exceptions between the Data Date and Project Finish that turn a standard working weekday into a non-working day.
	measure 'CA Future Exception Blackout Days' =
			VAR CalKey = SELECTEDVALUE('Scenario Calendar'[clndr_id_key])
			VAR ProjKey = SELECTEDVALUE('Scenario Calendar'[ProjectKey])
			VAR CsvFlag = SELECTEDVALUE('Scenario Calendar'[IsCsvSource])
			VAR ActiveTasks = [CA Incomplete Activity Count]
			VAR DataDate =
			    CALCULATE(
			        MAX('01 XER_TASK'[data_date]),
			        REMOVEFILTERS('01 XER_TASK'[task_code], '01 XER_TASK'[task_name], '01 XER_TASK'[calendar_id_key], '01 XER_TASK'[Calendar])
			    )
			VAR MaxFinish =
			    CALCULATE(
			        MAX('01 XER_TASK'[Finish]),
			        '01 XER_TASK'[status_code] <> "Complete",
			        REMOVEFILTERS('01 XER_TASK'[task_code], '01 XER_TASK'[task_name], '01 XER_TASK'[calendar_id_key], '01 XER_TASK'[Calendar])
			    )
			RETURN
			    IF(
			        COUNTROWS('Scenario Calendar') = 1
			            && NOT ISBLANK(CalKey)
			            && NOT ISBLANK(ActiveTasks) && ActiveTasks > 0,
			        VAR CalendarRows =
			            CALCULATETABLE(
			                '11 XER_CALENDAR_DETAILED',
			                REMOVEFILTERS('11 XER_CALENDAR_DETAILED'),
			                KEEPFILTERS(TREATAS({ CalKey }, '11 XER_CALENDAR_DETAILED'[clndr_id_key])),
			                KEEPFILTERS(TREATAS({ ProjKey }, '11 XER_CALENDAR_DETAILED'[ProjectKey])),
			                KEEPFILTERS(TREATAS({ CsvFlag }, '11 XER_CALENDAR_DETAILED'[IsCsvSource]))
			            )
			        VAR WeekRows =
			            FILTER(
			                CalendarRows,
			                ISBLANK('11 XER_CALENDAR_DETAILED'[date])
			                    && '11 XER_CALENDAR_DETAILED'[exception_type] == "Standard"
			                    && NOT ISBLANK('11 XER_CALENDAR_DETAILED'[work_hours])
			                    && '11 XER_CALENDAR_DETAILED'[work_hours] >= 0
			            )
			        VAR FutureExceptions =
			            FILTER(
			                CalendarRows,
			                NOT ISBLANK('11 XER_CALENDAR_DETAILED'[date])
			                    && (ISBLANK(DataDate) || '11 XER_CALENDAR_DETAILED'[date] >= DataDate)
			                    && (ISBLANK(MaxFinish) || '11 XER_CALENDAR_DETAILED'[date] <= MaxFinish)
			                    && NOT ISBLANK('11 XER_CALENDAR_DETAILED'[work_hours])
			                    && '11 XER_CALENDAR_DETAILED'[work_hours] <= 0
			            )
			        RETURN
			            COALESCE(
			                SUMX(
			                    FutureExceptions,
			                    VAR ExcDow = WEEKDAY('11 XER_CALENDAR_DETAILED'[date], 2)
			                    VAR NormalHours = MAXX(FILTER(WeekRows, '11 XER_CALENDAR_DETAILED'[day_of_week_num] = ExcDow), '11 XER_CALENDAR_DETAILED'[work_hours])
			                    RETURN IF(NormalHours > 0, 1, 0)
			                ),
			                0
			            )
			    )
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: 4aa16b0e-9130-5c0a-9c51-e651fb185ba6

	/// Total incomplete work activities assigned to this calendar in the selected snapshot and float scope.
	measure 'CA Incomplete Activity Count' =
			VAR CalKey = SELECTEDVALUE('Scenario Calendar'[clndr_id_key])
			VAR InScopeRow = ISINSCOPE('Scenario Calendar'[Calendar])
			VAR ActiveTaskCount =
			    IF(
			        COUNTROWS('Scenario Calendar') = 1 && NOT ISBLANK(CalKey),
			        CALCULATE(
			            COUNTROWS('01 XER_TASK'),
			            '01 XER_TASK'[status_code] <> "Complete",
			            '01 XER_TASK'[TaskType_Classified] = "Activity",
			            KEEPFILTERS(TREATAS({ CalKey }, '01 XER_TASK'[calendar_id_key]))
			        )
			    )
			RETURN
			    IF(
			        InScopeRow,
			        IF(NOT ISBLANK(ActiveTaskCount) && ActiveTaskCount > 0, ActiveTaskCount),
			        CALCULATE(
			            COUNTROWS('01 XER_TASK'),
			            '01 XER_TASK'[status_code] <> "Complete",
			            '01 XER_TASK'[TaskType_Classified] = "Activity"
			        )
			    )
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: 40a01574-2f74-5a57-8d0e-682105c3ac87

	/// Incomplete critical activities (Total Float <= 0) assigned to this calendar in the selected snapshot and float scope.
	measure 'CA Critical Activity Count' =
			VAR CalKey = SELECTEDVALUE('Scenario Calendar'[clndr_id_key])
			VAR InScopeRow = ISINSCOPE('Scenario Calendar'[Calendar])
			VAR ActiveTasks = [CA Incomplete Activity Count]
			RETURN
			    IF(
			        InScopeRow,
			        IF(
			            COUNTROWS('Scenario Calendar') = 1 && NOT ISBLANK(CalKey) && NOT ISBLANK(ActiveTasks) && ActiveTasks > 0,
			            COALESCE(
			                CALCULATE(
			                    COUNTROWS('01 XER_TASK'),
			                    '01 XER_TASK'[status_code] <> "Complete",
			                    '01 XER_TASK'[TaskType_Classified] = "Activity",
			                    KEEPFILTERS(NOT ISBLANK('01 XER_TASK'[total_float])),
			                    KEEPFILTERS('01 XER_TASK'[total_float] <= 0),
			                    KEEPFILTERS(TREATAS({ CalKey }, '01 XER_TASK'[calendar_id_key]))
			                ),
			                0
			            )
			        ),
			        COALESCE(
			            CALCULATE(
			                COUNTROWS('01 XER_TASK'),
			                '01 XER_TASK'[status_code] <> "Complete",
			                '01 XER_TASK'[TaskType_Classified] = "Activity",
			                KEEPFILTERS(NOT ISBLANK('01 XER_TASK'[total_float])),
			                KEEPFILTERS('01 XER_TASK'[total_float] <= 0)
			            ),
			            0
			        )
			    )
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: a7ca79ae-0044-5560-8667-86af7e928ca8

	/// Sum of remaining working duration (in days) across incomplete critical activities (Total Float <= 0) on this calendar.
	measure 'CA Critical Remaining Working Days' =
			VAR CalKey = SELECTEDVALUE('Scenario Calendar'[clndr_id_key])
			VAR InScopeRow = ISINSCOPE('Scenario Calendar'[Calendar])
			VAR ActiveTasks = [CA Incomplete Activity Count]
			RETURN
			    IF(
			        InScopeRow,
			        IF(
			            COUNTROWS('Scenario Calendar') = 1 && NOT ISBLANK(CalKey) && NOT ISBLANK(ActiveTasks) && ActiveTasks > 0,
			            COALESCE(
			                CALCULATE(
			                    SUM('01 XER_TASK'[remaining_duration]),
			                    '01 XER_TASK'[status_code] <> "Complete",
			                    '01 XER_TASK'[TaskType_Classified] = "Activity",
			                    KEEPFILTERS(NOT ISBLANK('01 XER_TASK'[total_float])),
			                    KEEPFILTERS('01 XER_TASK'[total_float] <= 0),
			                    KEEPFILTERS(TREATAS({ CalKey }, '01 XER_TASK'[calendar_id_key]))
			                ),
			                0
			            )
			        ),
			        COALESCE(
			            CALCULATE(
			                SUM('01 XER_TASK'[remaining_duration]),
			                '01 XER_TASK'[status_code] <> "Complete",
			                '01 XER_TASK'[TaskType_Classified] = "Activity",
			                KEEPFILTERS(NOT ISBLANK('01 XER_TASK'[total_float])),
			                KEEPFILTERS('01 XER_TASK'[total_float] <= 0)
			            ),
			            0
			        )
			    )
		formatString: #,0.0
		displayFolder: Calendar Analysis
		lineageTag: 4f736475-e078-5d19-9671-cb1310b4421a

	/// Total float (in working days) for an incomplete activity in the selected scope.
	measure 'CA Activity Total Float' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Selection Match],
			        MIN('01 XER_TASK'[total_float])
			    )
		formatString: #,0.0
		displayFolder: Calendar Analysis
		lineageTag: e841b2a1-6bf8-5490-94c7-bb9562ab9e9a

	/// Remaining working duration (in activity-calendar working days) for an incomplete activity in the selected scope.
	measure 'CA Activity Remaining Working Days' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Selection Match],
			        SUM('01 XER_TASK'[remaining_duration])
			    )
		formatString: #,0.0
		displayFolder: Calendar Analysis
		lineageTag: 13bf451a-e60b-5eb2-a1d5-c7b14b8bc097

	/// Inclusive calendar days in the activity's remaining execution window from MAX(Start, Data Date) through Finish.
	measure 'CA Activity Remaining Elapsed Days' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Selection Match],
			        MAXX(
			            '01 XER_TASK',
			            VAR StartDate = '01 XER_TASK'[Start]
			            VAR FinishDate = '01 XER_TASK'[Finish]
			            VAR DataDate = '01 XER_TASK'[data_date]
			            VAR EffectiveStart = IF(NOT ISBLANK(StartDate) && NOT ISBLANK(DataDate), MAX(StartDate, DataDate), StartDate)
			            RETURN
			                IF(
			                    NOT ISBLANK(EffectiveStart) && NOT ISBLANK(FinishDate) && FinishDate >= EffectiveStart,
			                    INT(FinishDate - EffectiveStart) + 1
			                )
			        )
			    )
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: 902a19af-c354-5d50-b3d8-9ead430a8b3e

	/// Routine non-working days (weekends or rostered off-days in the calendar's own seven weekday rules, '10 XER_CALENDARS'[Workweek Mask]) inside the activity's remaining execution window, capped at its non-working total. Blank when the calendar's weekday rules are unusable.
	measure 'CA Activity Standard Non-Working Days' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Selection Match],
			        MAXX(
			            '01 XER_TASK',
			            VAR WorkweekMask = RELATED('10 XER_CALENDARS'[Workweek Mask])
			            VAR StartDate = '01 XER_TASK'[Start]
			            VAR FinishDate = '01 XER_TASK'[Finish]
			            VAR DataDate = '01 XER_TASK'[data_date]
			            VAR RemWork = '01 XER_TASK'[remaining_duration]
			            VAR EffectiveStart = IF(NOT ISBLANK(StartDate) && NOT ISBLANK(DataDate), MAX(StartDate, DataDate), StartDate)
			            RETURN
			                IF(
			                    NOT ISBLANK(EffectiveStart) && NOT ISBLANK(FinishDate)
			                        && FinishDate >= EffectiveStart && NOT ISBLANK(RemWork) && LEN(WorkweekMask) = 7,
			                    VAR ElapsedDays = INT(FinishDate - EffectiveStart) + 1
			                    VAR TotalNonWork = MAX(0, ElapsedDays - ROUND(RemWork, 0))
			                    VAR StartDow = WEEKDAY(EffectiveStart, 2)
			                    VAR FullWeeks = QUOTIENT(ElapsedDays, 7)
			                    VAR ExtraDays = MOD(ElapsedDays, 7)
			                    // Off weekdays in each full week, plus those among the leftover days running from StartDow.
			                    VAR ExpectedOffDays =
			                        FullWeeks * (7 - LEN(SUBSTITUTE(WorkweekMask, "0", "")))
			                            + ExtraDays - LEN(SUBSTITUTE(MID(WorkweekMask & WorkweekMask, StartDow, ExtraDays), "0", ""))
			                    RETURN
			                        MIN(TotalNonWork, ExpectedOffDays)
			                )
			        )
			    )
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: 13c054a8-9452-5706-a208-6d1b245ec494

	/// Net non-working blackout days added by dated calendar exceptions (holidays, shutdowns, weather, alternate rostered Saturdays) inside the activity's remaining execution window: its non-working total less the calendar's routine off-days. Blank when the calendar's weekday rules are unusable.
	measure 'CA Activity Exception Blackout Days' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Selection Match],
			        MAXX(
			            '01 XER_TASK',
			            VAR WorkweekMask = RELATED('10 XER_CALENDARS'[Workweek Mask])
			            VAR StartDate = '01 XER_TASK'[Start]
			            VAR FinishDate = '01 XER_TASK'[Finish]
			            VAR DataDate = '01 XER_TASK'[data_date]
			            VAR RemWork = '01 XER_TASK'[remaining_duration]
			            VAR EffectiveStart = IF(NOT ISBLANK(StartDate) && NOT ISBLANK(DataDate), MAX(StartDate, DataDate), StartDate)
			            RETURN
			                IF(
			                    NOT ISBLANK(EffectiveStart) && NOT ISBLANK(FinishDate)
			                        && FinishDate >= EffectiveStart && NOT ISBLANK(RemWork) && LEN(WorkweekMask) = 7,
			                    VAR ElapsedDays = INT(FinishDate - EffectiveStart) + 1
			                    VAR TotalNonWork = MAX(0, ElapsedDays - ROUND(RemWork, 0))
			                    VAR StartDow = WEEKDAY(EffectiveStart, 2)
			                    VAR FullWeeks = QUOTIENT(ElapsedDays, 7)
			                    VAR ExtraDays = MOD(ElapsedDays, 7)
			                    VAR ExpectedOffDays =
			                        FullWeeks * (7 - LEN(SUBSTITUTE(WorkweekMask, "0", "")))
			                            + ExtraDays - LEN(SUBSTITUTE(MID(WorkweekMask & WorkweekMask, StartDow, ExtraDays), "0", ""))
			                    VAR StdNonWork = MIN(TotalNonWork, ExpectedOffDays)
			                    RETURN
			                        MAX(0, TotalNonWork - StdNonWork)
			                )
			        )
			    )
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: e136983c-76e4-5105-822e-098a33c279a9

	/// Total non-working civil days inside the activity's remaining execution window.
	measure 'CA Activity Non-Working Stretch Days' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Selection Match],
			        MAXX(
			            '01 XER_TASK',
			            VAR StartDate = '01 XER_TASK'[Start]
			            VAR FinishDate = '01 XER_TASK'[Finish]
			            VAR DataDate = '01 XER_TASK'[data_date]
			            VAR RemWork = '01 XER_TASK'[remaining_duration]
			            VAR EffectiveStart = IF(NOT ISBLANK(StartDate) && NOT ISBLANK(DataDate), MAX(StartDate, DataDate), StartDate)
			            RETURN
			                IF(
			                    NOT ISBLANK(EffectiveStart) && NOT ISBLANK(FinishDate)
			                        && FinishDate >= EffectiveStart && NOT ISBLANK(RemWork),
			                    VAR ElapsedDays = INT(FinishDate - EffectiveStart) + 1
			                    RETURN
			                        MAX(0, ElapsedDays - ROUND(RemWork, 0))
			                )
			        )
			    )
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: 49c9e56c-75f6-5011-9103-fdc5a6e136b5

	/// Ratio of remaining calendar days to remaining working days (e.g. 1.40x on a Monday to Friday workweek without holidays, higher when hit by holidays/exceptions).
	measure 'CA Activity Stretch Ratio' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Selection Match],
			        MAXX(
			            '01 XER_TASK',
			            VAR StartDate = '01 XER_TASK'[Start]
			            VAR FinishDate = '01 XER_TASK'[Finish]
			            VAR DataDate = '01 XER_TASK'[data_date]
			            VAR RemWork = '01 XER_TASK'[remaining_duration]
			            VAR EffectiveStart = IF(NOT ISBLANK(StartDate) && NOT ISBLANK(DataDate), MAX(StartDate, DataDate), StartDate)
			            RETURN
			                IF(
			                    NOT ISBLANK(EffectiveStart) && NOT ISBLANK(FinishDate)
			                        && FinishDate >= EffectiveStart && NOT ISBLANK(RemWork) && RemWork > 0,
			                    DIVIDE(INT(FinishDate - EffectiveStart) + 1, RemWork)
			                )
			        )
			    )
		formatString: 0.00x
		displayFolder: Calendar Analysis
		lineageTag: d646b34d-cbe2-57e8-a288-9e6ce8827963

	/// Plain-English explanation of why the activity's remaining calendar days exceed its remaining working duration.
	measure 'CA Activity Stretch Diagnosis' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Selection Match],
			        MAXX(
			            '01 XER_TASK',
			            VAR CalName = '01 XER_TASK'[Calendar]
			            VAR WorkweekMask = RELATED('10 XER_CALENDARS'[Workweek Mask])
			            VAR StartDate = '01 XER_TASK'[Start]
			            VAR FinishDate = '01 XER_TASK'[Finish]
			            VAR DataDate = '01 XER_TASK'[data_date]
			            VAR RemWork = '01 XER_TASK'[remaining_duration]
			            VAR EffectiveStart = IF(NOT ISBLANK(StartDate) && NOT ISBLANK(DataDate), MAX(StartDate, DataDate), StartDate)
			            RETURN
			                IF(
			                    NOT ISBLANK(EffectiveStart) && NOT ISBLANK(FinishDate)
			                        && FinishDate >= EffectiveStart,
			                    VAR ElapsedDays = INT(FinishDate - EffectiveStart) + 1
			                    VAR TotalNonWork = IF(NOT ISBLANK(RemWork), MAX(0, ElapsedDays - ROUND(RemWork, 0)), 0)
			                    VAR StartDow = WEEKDAY(EffectiveStart, 2)
			                    VAR FullWeeks = QUOTIENT(ElapsedDays, 7)
			                    VAR ExtraDays = MOD(ElapsedDays, 7)
			                    VAR ExpectedOffDays =
			                        FullWeeks * (7 - LEN(SUBSTITUTE(WorkweekMask, "0", "")))
			                            + ExtraDays - LEN(SUBSTITUTE(MID(WorkweekMask & WorkweekMask, StartDow, ExtraDays), "0", ""))
			                    VAR StdNonWork = MIN(TotalNonWork, ExpectedOffDays)
			                    VAR ExcBlackouts = MAX(0, TotalNonWork - StdNonWork)
			                    VAR RemWorkText =
			                        IF(
			                            ISBLANK(RemWork),
			                            "0",
			                            IF(ABS(RemWork - ROUND(RemWork, 0)) < 0.05, FORMAT(ROUND(RemWork, 0), "#,0"), FORMAT(RemWork, "#,0.0"))
			                        )
			                    RETURN
			                        SWITCH(
			                            TRUE(),
			                            ISBLANK(CalName),
			                                "Missing calendar (" & FORMAT(ElapsedDays, "#,0") & " calendar days)",
			                            LEN(WorkweekMask) <> 7,
			                                "Calendar weekday rules unavailable: " & FORMAT(TotalNonWork, "#,0") & " non-working days (" & RemWorkText & " work days in " & FORMAT(ElapsedDays, "#,0") & " calendar days)",
			                            ExcBlackouts > 0 && StdNonWork > 0,
			                                "+" & FORMAT(ExcBlackouts, "#,0") & " holidays/exceptions & +" & FORMAT(StdNonWork, "#,0") & " weekends/off-days (" & RemWorkText & " work days in " & FORMAT(ElapsedDays, "#,0") & " calendar days)",
			                            ExcBlackouts > 0,
			                                "+" & FORMAT(ExcBlackouts, "#,0") & " holidays/exceptions (" & RemWorkText & " work days in " & FORMAT(ElapsedDays, "#,0") & " calendar days)",
			                            StdNonWork > 0,
			                                "Weekends/off-days only: +" & FORMAT(StdNonWork, "#,0") & " days (" & RemWorkText & " work days in " & FORMAT(ElapsedDays, "#,0") & " calendar days)",
			                            "Continuous working days (0 non-working days in " & FORMAT(ElapsedDays, "#,0") & " calendar days)"
			                        )
			                )
			        )
			    )
		formatString: @
		displayFolder: Calendar Analysis
		lineageTag: 87dee850-ee1a-5e2a-a4cb-182304edbc0e

	/// Count of distinct project calendars actively assigned to incomplete activities in the selected project, report update, and float scope.
	measure 'CA KPI Active Calendars' =
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT('01 XER_TASK'[calendar_id_key]),
			        '01 XER_TASK'[status_code] <> "Complete",
			        '01 XER_TASK'[TaskType_Classified] = "Activity",
			        NOT ISBLANK('01 XER_TASK'[calendar_id_key])
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: dba01ee1-cf35-5f02-8ae8-03d7da1ef6b6

	/// Total dated exception blackout days absorbed inside the remaining execution windows of incomplete critical activities (Total Float <= 0), measured against each calendar's own weekday rules; activities whose calendar rules are unusable add nothing.
	measure 'CA KPI Critical Exception Blackout Days' =
			VAR CriticalTasks =
			    CALCULATETABLE(
			        SUMMARIZE(
			            '01 XER_TASK',
			            '01 XER_TASK'[task_id_key],
			            '10 XER_CALENDARS'[Workweek Mask],
			            '01 XER_TASK'[Start],
			            '01 XER_TASK'[Finish],
			            '01 XER_TASK'[data_date],
			            '01 XER_TASK'[remaining_duration]
			        ),
			        '01 XER_TASK'[status_code] <> "Complete",
			        '01 XER_TASK'[TaskType_Classified] = "Activity",
			        KEEPFILTERS(NOT ISBLANK('01 XER_TASK'[total_float])),
			        KEEPFILTERS('01 XER_TASK'[total_float] <= 0),
			        NOT ISBLANK('01 XER_TASK'[Finish])
			    )
			RETURN
			    COALESCE(
			        SUMX(
			            CriticalTasks,
			            VAR WorkweekMask = '10 XER_CALENDARS'[Workweek Mask]
			            VAR StartDate = '01 XER_TASK'[Start]
			            VAR FinishDate = '01 XER_TASK'[Finish]
			            VAR DataDate = '01 XER_TASK'[data_date]
			            VAR RemWork = '01 XER_TASK'[remaining_duration]
			            VAR EffectiveStart = IF(NOT ISBLANK(StartDate) && NOT ISBLANK(DataDate), MAX(StartDate, DataDate), StartDate)
			            RETURN
			                IF(
			                    NOT ISBLANK(EffectiveStart) && NOT ISBLANK(FinishDate) && FinishDate >= EffectiveStart && NOT ISBLANK(RemWork)
			                        && LEN(WorkweekMask) = 7,
			                    VAR SpanDays = INT(FinishDate - EffectiveStart) + 1
			                    VAR TotalNonWork = MAX(0, SpanDays - ROUND(RemWork, 0))
			                    VAR StartDow = WEEKDAY(EffectiveStart, 2)
			                    VAR FullWeeks = QUOTIENT(SpanDays, 7)
			                    VAR ExtraDays = MOD(SpanDays, 7)
			                    VAR ExpectedOffDays =
			                        FullWeeks * (7 - LEN(SUBSTITUTE(WorkweekMask, "0", "")))
			                            + ExtraDays - LEN(SUBSTITUTE(MID(WorkweekMask & WorkweekMask, StartDow, ExtraDays), "0", ""))
			                    VAR StdNonWork = MIN(TotalNonWork, ExpectedOffDays)
			                    RETURN MAX(0, TotalNonWork - StdNonWork),
			                    0
			                )
			        ),
			        0
			    )
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: d7f225ef-77cb-5ee0-9d72-3ec434e87b48

	/// Highest non-working day stretch (Remaining Elapsed Days minus Remaining Working Days) on a single incomplete critical activity.
	measure 'CA KPI Max Critical Stretch Days' =
			VAR CriticalTasks =
			    CALCULATETABLE(
			        SUMMARIZE(
			            '01 XER_TASK',
			            '01 XER_TASK'[task_id_key],
			            '01 XER_TASK'[Start],
			            '01 XER_TASK'[Finish],
			            '01 XER_TASK'[data_date],
			            '01 XER_TASK'[remaining_duration]
			        ),
			        '01 XER_TASK'[status_code] <> "Complete",
			        '01 XER_TASK'[TaskType_Classified] = "Activity",
			        KEEPFILTERS(NOT ISBLANK('01 XER_TASK'[total_float])),
			        KEEPFILTERS('01 XER_TASK'[total_float] <= 0),
			        NOT ISBLANK('01 XER_TASK'[Finish]),
			        NOT ISBLANK('01 XER_TASK'[remaining_duration]),
			        '01 XER_TASK'[remaining_duration] > 0
			    )
			RETURN
			    COALESCE(
			        MAXX(
			            CriticalTasks,
			            VAR StartDate = '01 XER_TASK'[Start]
			            VAR FinishDate = '01 XER_TASK'[Finish]
			            VAR DataDate = '01 XER_TASK'[data_date]
			            VAR EffectiveStart = IF(NOT ISBLANK(StartDate) && NOT ISBLANK(DataDate), MAX(StartDate, DataDate), StartDate)
			            VAR ElapsedDays = IF(FinishDate >= EffectiveStart, INT(FinishDate - EffectiveStart) + 1, 0)
			            RETURN MAX(0, ElapsedDays - ROUND('01 XER_TASK'[remaining_duration], 0))
			        ),
			        0
			    )
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: 10c7236c-d74c-5697-a95f-f4ae2ae3523a

	/// Inspector row gate: FALSE unless one project and one update are in context, then re-applies a calendar or month selected in the summary table or matrix, which use 'Scenario Calendar' / 'Scenario Date' (no relationship to '01 XER_TASK').
	measure 'CA Inspector Selection Match' =
			VAR CalendarSelected = ISFILTERED('Scenario Calendar'[Calendar])
			VAR MonthSelected = ISFILTERED('Scenario Date'[Month])
			VAR MonthStart = MIN('Scenario Date'[Date])
			VAR MonthEnd = MAX('Scenario Date'[Date])
			RETURN
			    SWITCH(
			        TRUE(),
			        NOT [CA Inspector Scope Ready], FALSE(),
			        CalendarSelected && MonthSelected,
			            CALCULATE(
			                COUNTROWS('01 XER_TASK'),
			                KEEPFILTERS(TREATAS(VALUES('Scenario Calendar'[clndr_id_key]), '01 XER_TASK'[calendar_id_key])),
			                // Remaining window overlaps the month: Finish >= MonthStart and MAX(Start, Data Date) <= MonthEnd
			                KEEPFILTERS('01 XER_TASK'[Finish] >= MonthStart),
			                KEEPFILTERS('01 XER_TASK'[Start] <= MonthEnd),
			                KEEPFILTERS('01 XER_TASK'[data_date] <= MonthEnd)
			            ) > 0,
			        CalendarSelected,
			            CALCULATE(
			                COUNTROWS('01 XER_TASK'),
			                KEEPFILTERS(TREATAS(VALUES('Scenario Calendar'[clndr_id_key]), '01 XER_TASK'[calendar_id_key]))
			            ) > 0,
			        MonthSelected,
			            CALCULATE(
			                COUNTROWS('01 XER_TASK'),
			                KEEPFILTERS('01 XER_TASK'[Finish] >= MonthStart),
			                KEEPFILTERS('01 XER_TASK'[Start] <= MonthEnd),
			                KEEPFILTERS('01 XER_TASK'[data_date] <= MonthEnd)
			            ) > 0,
			        TRUE()
			    )
		isHidden
		displayFolder: Calendar Analysis
		lineageTag: 7967bab6-4205-4804-83dc-1f82c52e39ec

	/// Activity name for an inspector row; blank outside the calendar/month selection so unselected rows drop out.
	measure 'CA Activity Name' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Selection Match],
			        SELECTEDVALUE('01 XER_TASK'[task_name])
			    )
		formatString: @
		displayFolder: Calendar Analysis
		lineageTag: d1b2ccd3-4926-4ac2-9ce9-c02159880ee7

	/// Activity calendar name for an inspector row; blank outside the calendar/month selection.
	measure 'CA Activity Calendar' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Selection Match],
			        SELECTEDVALUE('01 XER_TASK'[Calendar])
			    )
		formatString: @
		displayFolder: Calendar Analysis
		lineageTag: c8a465c1-dbb2-4793-ae73-192814753741

	/// Activity start (actual or forecast) for an inspector row; blank outside the calendar/month selection.
	measure 'CA Activity Start' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Selection Match],
			        MIN('01 XER_TASK'[Start])
			    )
		formatString: dd/mm/yyyy
		displayFolder: Calendar Analysis
		lineageTag: 9eef6df0-f11d-4a2f-bc0a-cb81918072e6

	/// Activity forecast finish for an inspector row; blank outside the calendar/month selection.
	measure 'CA Activity Finish' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Selection Match],
			        MAX('01 XER_TASK'[Finish])
			    )
		formatString: dd/mm/yyyy
		displayFolder: Calendar Analysis
		lineageTag: 5849f826-7617-4038-8184-28a034678de0

	/// TRUE when exactly one project and one update are in context. task_code is unique only within one project snapshot, so the activity inspector lists rows only then.
	measure 'CA Inspector Scope Ready' = HASONEVALUE(Project_Dimension[ProjectKey]) && HASONEVALUE(CurrentDate[UpdateDate])
		isHidden
		displayFolder: Calendar Analysis
		lineageTag: 8501d8c3-3bc4-44c3-8835-7c04a50c5be1

	/// Activity inspector title; asks for one project when the table is blank because several are in context.
	measure 'CA Inspector Title' =
			IF(
			    [CA Inspector Scope Ready],
			    "Activities by Calendar · Remaining Working Days vs Remaining Calendar Days",
			    "Activities by Calendar · select one project to list activities"
			)
		formatString: @
		displayFolder: Calendar Analysis
		lineageTag: f78f0c41-1796-4abc-89ab-0f34af4624d7

	/// Incomplete activities on this calendar whose remaining execution window overlaps the month (what the activity table lists for that cell).
	measure 'CA Monthly Active Activities' =
			VAR CalKey = SELECTEDVALUE('Scenario Calendar'[clndr_id_key])
			VAR MonthStart = MIN('Scenario Date'[Date])
			VAR MonthEnd = MAX('Scenario Date'[Date])
			RETURN
			    IF(
			        COUNTROWS('Scenario Calendar') = 1
			            && HASONEVALUE('Scenario Date'[Month])
			            && NOT ISBLANK(CalKey),
			        COALESCE(
			            CALCULATE(
			                COUNTROWS('01 XER_TASK'),
			                KEEPFILTERS('01 XER_TASK'[status_code] <> "Complete"),
			                KEEPFILTERS('01 XER_TASK'[TaskType_Classified] = "Activity"),
			                KEEPFILTERS(TREATAS({ CalKey }, '01 XER_TASK'[calendar_id_key])),
			                // Same month overlap as [CA Inspector Selection Match]: Finish >= MonthStart and MAX(Start, Data Date) <= MonthEnd
			                KEEPFILTERS('01 XER_TASK'[Finish] >= MonthStart),
			                KEEPFILTERS('01 XER_TASK'[Start] <= MonthEnd),
			                KEEPFILTERS('01 XER_TASK'[data_date] <= MonthEnd)
			            ),
			            0
			        )
			    )
		formatString: #,0
		displayFolder: Calendar Analysis
		lineageTag: b0a30b58-c88c-4c97-b0d7-195b0d652de4

	/// Matrix cell background: grey when no activity on the calendar falls in the month, light red when a critical one (Total Float <= 0) does, light orange when only near-critical ones (0 < Total Float <= 10) do.
	measure 'CA Monthly Working Days Colour' =
			VAR CellDays = [CA Monthly Working Days]
			RETURN
			    IF(
			        NOT ISBLANK(CellDays),
			        SWITCH(
			            TRUE(),
			            [CA Monthly Active Activities] = 0, "#687078",
			            CALCULATE([CA Monthly Active Activities], KEEPFILTERS('01 XER_TASK'[CriticalStatus] = "Critical")) > 0, "#FFC7CE",
			            CALCULATE([CA Monthly Active Activities], KEEPFILTERS('01 XER_TASK'[CriticalStatus] = "Near Critical")) > 0, "#FFD9B3"
			        )
			    )
		formatString: @
		displayFolder: Calendar Analysis
		lineageTag: c50d0256-e5d8-4cf2-84c2-201de31a22ac

	/// Matrix cell font: white on grey (no-activity) cells.
	measure 'CA Monthly Working Days Font Colour' = IF([CA Monthly Working Days Colour] = "#687078", "#FFFFFF")
		formatString: @
		displayFolder: Calendar Analysis
		lineageTag: 4e1b6aad-f93b-4622-900a-513632d4dc63

	/// Calendar days that dated holidays and shutdowns add to the activity's remaining work beyond its finish without calendar exceptions ('01 XER_TASK'[Calendar Delay Days]). Listed only for one project and one update, because task_code is unique only within a project snapshot.
	measure 'CS Activity Calendar Delay Days' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Scope Ready],
			        MAXX('01 XER_TASK', '01 XER_TASK'[Calendar Delay Days])
			    )
		formatString: #,0
		displayFolder: Calendar Stretch
		lineageTag: 2c84bf17-0330-545d-9d39-61d2f2d0c5bb

	/// Start of the activity's remaining work: MAX(Start, Data Date).
	measure 'CS Activity Effective Start' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Scope Ready],
			        MAXX(
			            '01 XER_TASK',
			            VAR StartDate = '01 XER_TASK'[Start]
			            VAR DataDate = '01 XER_TASK'[data_date]
			            RETURN IF(NOT ISBLANK(StartDate) && NOT ISBLANK(DataDate), MAX(StartDate, DataDate), StartDate)
			        )
			    )
		formatString: dd/mm/yyyy
		displayFolder: Calendar Stretch
		lineageTag: 21266d80-74c5-54d9-bed0-b017bd4f6e36

	/// Finish the activity's remaining work would have on its calendar's own workweek without dated exceptions (holidays, shutdowns, rostered days off): '01 XER_TASK'[Finish Without Exceptions].
	measure 'CS Activity Finish Without Exceptions' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Scope Ready],
			        MAXX('01 XER_TASK', '01 XER_TASK'[Finish Without Exceptions])
			    )
		formatString: dd/mm/yyyy
		displayFolder: Calendar Stretch
		lineageTag: 859e8360-627f-5c13-9384-56d1d366c2fe

	/// Incomplete activities whose calendar adds more than 30 calendar days to their remaining work.
	measure 'CS KPI Delayed Activities' =
			COALESCE(
			    CALCULATE(COUNTROWS('01 XER_TASK'), KEEPFILTERS('01 XER_TASK'[Calendar Delay Days] > 30)),
			    0
			)
		formatString: #,0
		displayFolder: Calendar Stretch
		lineageTag: f62c606e-d065-5e89-a97b-771c353a1a52

	/// Incomplete activities whose calendar adds more than 90 calendar days to their remaining work.
	measure 'CS KPI Severely Delayed Activities' =
			COALESCE(
			    CALCULATE(COUNTROWS('01 XER_TASK'), KEEPFILTERS('01 XER_TASK'[Calendar Delay Days] > 90)),
			    0
			)
		formatString: #,0
		displayFolder: Calendar Stretch
		lineageTag: 4b044820-9816-55e7-ac8e-6592b6bd2317

	/// Calendar days that dated holidays and shutdowns add across critical and near-critical activities (Total Float <= 10).
	measure 'CS KPI Critical Delay Days' =
			COALESCE(
			    CALCULATE(
			        SUM('01 XER_TASK'[Calendar Delay Days]),
			        KEEPFILTERS('01 XER_TASK'[CriticalStatus] IN { "Critical", "Near Critical" })
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Calendar Stretch
		lineageTag: ad7d07b0-0b86-5a1b-b62a-a7f038a3b697

	/// Largest calendar-driven delay on a single incomplete activity.
	measure 'CS KPI Max Delay Days' = COALESCE(MAX('01 XER_TASK'[Calendar Delay Days]), 0)
		formatString: #,0
		displayFolder: Calendar Stretch
		lineageTag: d5e6e985-bb61-5a3e-8b34-bb7c93784be9

	/// Highest ratio of remaining calendar days to remaining working days among activities the calendar delays (at least one working day left).
	measure 'CS KPI Worst Stretch Ratio' =
			CALCULATE(
			    MAXX(
			        '01 XER_TASK',
			        VAR StartDate = '01 XER_TASK'[Start]
			        VAR DataDate = '01 XER_TASK'[data_date]
			        VAR EffectiveStart = IF(NOT ISBLANK(StartDate) && NOT ISBLANK(DataDate), MAX(StartDate, DataDate), StartDate)
			        RETURN DIVIDE(INT('01 XER_TASK'[Finish] - EffectiveStart) + 1, '01 XER_TASK'[remaining_duration])
			    ),
			    KEEPFILTERS('01 XER_TASK'[Calendar Delay Days] > 0),
			    KEEPFILTERS('01 XER_TASK'[remaining_duration] >= 1)
			)
		formatString: 0.0x
		displayFolder: Calendar Stretch
		lineageTag: 742a5416-c8b7-55fc-866f-153c13698439

	/// Calendar Stretch visual subtitle: the selected update, or a prompt for one project and one update.
	measure 'CS Scope Prompt' =
			IF(
			    [CA Inspector Scope Ready],
			    "Update " & FORMAT(SELECTEDVALUE(CurrentDate[UpdateDate]), "dd-MMM-yy") & " · remaining work from the data date",
			    "Select one project and one update to list activities"
			)
		formatString: @
		displayFolder: Calendar Stretch
		lineageTag: 866e0f82-9a44-5e5b-bd63-68e52edc4648

	/// ISO dates for the Deneb delay timeline, "remaining start|finish without exceptions|finish|data date", so the visual parses them in UTC without time-zone shifts. Blank where Finish Without Exceptions is blank.
	measure 'CS Activity Timeline Dates' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Scope Ready],
			        MAXX(
			            '01 XER_TASK',
			            VAR StartDate = '01 XER_TASK'[Start]
			            VAR DataDate = '01 XER_TASK'[data_date]
			            VAR EffectiveStart = IF(NOT ISBLANK(StartDate) && NOT ISBLANK(DataDate), MAX(StartDate, DataDate), StartDate)
			            VAR ExceptionFreeFinish = '01 XER_TASK'[Finish Without Exceptions]
			            RETURN
			                IF(
			                    NOT ISBLANK(ExceptionFreeFinish),
			                    FORMAT(EffectiveStart, "yyyy-MM-dd") & "|" & FORMAT(ExceptionFreeFinish, "yyyy-MM-dd") & "|"
			                        & FORMAT('01 XER_TASK'[Finish], "yyyy-MM-dd") & "|" & FORMAT(DataDate, "yyyy-MM-dd")
			                )
			        )
			    )
		formatString: @
		displayFolder: Calendar Stretch
		lineageTag: ae5e5ac5-6208-5d66-93b6-a185d7f3e2df

	/// Shutdowns of 7 or more consecutive non-working days inside the activity's remaining window, as "yyyy-MM-dd|yyyy-MM-dd;..." for the Deneb delay timeline. Runs grow from dated non-working exceptions across routine off-days (a usable workweek has at most 6 consecutive off-days, so every such run holds an exception) and stop at a working day or a working exception. Evaluated only for activities the calendar delays; dates are read as loaded (already realigned).
	measure 'CS Activity Shutdown Bands' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && ISINSCOPE('01 XER_TASK'[task_code]) && [CA Inspector Scope Ready],
			        MAXX(
			            '01 XER_TASK',
			            VAR StartDate = '01 XER_TASK'[Start]
			            VAR DataDate = '01 XER_TASK'[data_date]
			            VAR EffectiveStart = IF(NOT ISBLANK(StartDate) && NOT ISBLANK(DataDate), MAX(StartDate, DataDate), StartDate)
			            VAR FinishDate = '01 XER_TASK'[Finish]
			            VAR CalKey = '01 XER_TASK'[calendar_id_key]
			            VAR WorkweekMask = RELATED('10 XER_CALENDARS'[Workweek Mask])
			            RETURN
			                IF(
			                    '01 XER_TASK'[Calendar Delay Days] > 0 && LEN(WorkweekMask) = 7,
			                    VAR FetchFrom = EffectiveStart - 7
			                    VAR FetchTo = FinishDate + 7
			                    VAR Dated =
			                        CALCULATETABLE(
			                            SELECTCOLUMNS(
			                                '11 XER_CALENDAR_DETAILED',
			                                "__Date", '11 XER_CALENDAR_DETAILED'[date],
			                                "__Hours", '11 XER_CALENDAR_DETAILED'[work_hours]
			                            ),
			                            REMOVEFILTERS('11 XER_CALENDAR_DETAILED'),
			                            TREATAS({ CalKey }, '11 XER_CALENDAR_DETAILED'[clndr_id_key]),
			                            '11 XER_CALENDAR_DETAILED'[date] >= FetchFrom,
			                            '11 XER_CALENDAR_DETAILED'[date] <= FetchTo,
			                            '11 XER_CALENDAR_DETAILED'[exception_type] <> "Exception - Invalid"
			                        )
			                    VAR Closed = DISTINCT(SELECTCOLUMNS(FILTER(Dated, NOT ISBLANK([__Hours]) && [__Hours] <= 0), "__Date", [__Date]))
			                    VAR Opened = DISTINCT(SELECTCOLUMNS(FILTER(Dated, [__Hours] > 0), "__Date", [__Date]))
			                    VAR OffPerWeek = 7 - LEN(SUBSTITUTE(WorkweekMask, "0", ""))
			                    VAR DoubleMask = WorkweekMask & WorkweekMask
			                    VAR ReverseMask =
			                        MID(WorkweekMask, 7, 1) & MID(WorkweekMask, 6, 1) & MID(WorkweekMask, 5, 1) & MID(WorkweekMask, 4, 1)
			                            & MID(WorkweekMask, 3, 1) & MID(WorkweekMask, 2, 1) & MID(WorkweekMask, 1, 1)
			                    // A closed date starts a run unless every day since the previous closed date is a routine off-day.
			                    VAR Heads =
			                        FILTER(
			                            Closed,
			                            VAR ThisDate = [__Date]
			                            VAR PreviousDate = MAXX(FILTER(Closed, [__Date] < ThisDate), [__Date])
			                            VAR GapDays = IF(ISBLANK(PreviousDate), 0, INT(ThisDate - PreviousDate) - 1)
			                            VAR GapStartDow = IF(ISBLANK(PreviousDate), 1, WEEKDAY(PreviousDate + 1, 2))
			                            VAR GapExtra = MOD(GapDays, 7)
			                            VAR GapOffDays = QUOTIENT(GapDays, 7) * OffPerWeek + GapExtra - LEN(SUBSTITUTE(MID(DoubleMask, GapStartDow, GapExtra), "0", ""))
			                            RETURN
			                                ISBLANK(PreviousDate)
			                                    || GapOffDays < GapDays
			                                    || NOT ISEMPTY(FILTER(Opened, [__Date] > PreviousDate && [__Date] < ThisDate))
			                        )
			                    // Each run spans its head to the last closed date before the next head, widened over adjacent routine off-days.
			                    VAR Runs =
			                        ADDCOLUMNS(
			                            Heads,
			                            "__Start",
			                                VAR Head = [__Date]
			                                VAR OffBefore = FIND("1", MID(ReverseMask & ReverseMask, 8 - WEEKDAY(Head - 1, 2), 7) & "1") - 1
			                                VAR LastOpened = MAXX(FILTER(Opened, [__Date] < Head), [__Date])
			                                VAR Back = IF(ISBLANK(LastOpened), OffBefore, MIN(OffBefore, INT(Head - LastOpened) - 1))
			                                RETURN MAX(FetchFrom, Head - Back),
			                            "__End",
			                                VAR Head = [__Date]
			                                VAR NextHead = MINX(FILTER(Heads, [__Date] > Head), [__Date])
			                                VAR Tail = MAXX(FILTER(Closed, [__Date] >= Head && (ISBLANK(NextHead) || [__Date] < NextHead)), [__Date])
			                                VAR OffAfter = FIND("1", MID(DoubleMask, WEEKDAY(Tail + 1, 2), 7) & "1") - 1
			                                VAR NextOpened = MINX(FILTER(Opened, [__Date] > Tail), [__Date])
			                                VAR Forward = IF(ISBLANK(NextOpened), OffAfter, MIN(OffAfter, INT(NextOpened - Tail) - 1))
			                                RETURN MIN(FetchTo, Tail + Forward)
			                        )
			                    VAR Bands =
			                        FILTER(
			                            ADDCOLUMNS(Runs, "__From", MAX([__Start], EffectiveStart), "__To", MIN([__End], FinishDate)),
			                            INT([__End] - [__Start]) + 1 >= 7 && [__To] >= [__From]
			                        )
			                    RETURN
			                        CONCATENATEX(Bands, FORMAT([__From], "yyyy-MM-dd") & "|" & FORMAT([__To], "yyyy-MM-dd"), ";", [__From], ASC)
			                )
			        )
			    )
		formatString: @
		displayFolder: Calendar Stretch
		lineageTag: 02080098-b2bc-5472-9908-2b5ea5f9b0d6

	/// Activity shown by the cliff-edge chart and callout: the one clicked in the bars, timeline or scatter, otherwise the activity with the largest calendar-driven delay. Blank unless one project and one update are in context.
	measure 'CS Cliff Task Code' =
			VAR TaskRows = COUNTROWS('01 XER_TASK')
			RETURN
			    IF(
			        TaskRows > 0 && [CA Inspector Scope Ready],
			        IF(
			            HASONEVALUE('01 XER_TASK'[task_code]),
			            VALUES('01 XER_TASK'[task_code]),
			            VAR MaxDelay = MAX('01 XER_TASK'[Calendar Delay Days])
			            RETURN
			                IF(
			                    MaxDelay > 0,
			                    CALCULATE(MIN('01 XER_TASK'[task_code]), KEEPFILTERS('01 XER_TASK'[Calendar Delay Days] = MaxDelay))
			                )
			        )
			    )
		formatString: @
		isHidden
		displayFolder: Calendar Stretch
		lineageTag: cf487d5d-d0f5-57f8-badc-db30735107fc

	/// Finish the cliff-edge activity ([CS Cliff Task Code]) would reach if its remaining work started on the 'Scenario Date' axis date: the CEILING(remaining_duration)-th working day on its calendar's weekday rules plus dated exceptions. Only within 60 days of its remaining start; blank past an invalid or conflicting exception, when exception coverage is unknown, or beyond the axis. A sparse search (closed-form weekday counts plus exception deltas, 13 bisection levels rendered by scripts/calendar_analysis/stretch_dax.py), never a date series; the search stops at the scheduled finish + 400 days when the latest window start completes by then, otherwise at the axis end.
	measure 'CS Cliff Finish Date' =
			VAR Code = [CS Cliff Task Code]
			VAR CandidateStart = SELECTEDVALUE('Scenario Date'[Date])
			RETURN
			    IF(
			        NOT ISBLANK(Code) && NOT ISBLANK(CandidateStart),
			        VAR TaskRow = CALCULATETABLE('01 XER_TASK', KEEPFILTERS(TREATAS({ Code }, '01 XER_TASK'[task_code])))
			        VAR DataDate = MAXX(TaskRow, '01 XER_TASK'[data_date])
			        VAR EffectiveStart =
			            MAXX(
			                TaskRow,
			                VAR StartDate = '01 XER_TASK'[Start]
			                VAR RowDataDate = '01 XER_TASK'[data_date]
			                RETURN IF(NOT ISBLANK(StartDate) && NOT ISBLANK(RowDataDate), MAX(StartDate, RowDataDate), StartDate)
			            )
			        VAR WindowStart = MAX(DataDate, EffectiveStart - 60)
			        VAR WindowEnd = EffectiveStart + 60
			        RETURN
			            IF(
			                NOT ISBLANK(EffectiveStart) && CandidateStart >= WindowStart && CandidateStart <= WindowEnd,
			                VAR RemWork = MAXX(TaskRow, '01 XER_TASK'[remaining_duration])
			                VAR NeedDays = IF(NOT ISBLANK(RemWork), INT(CEILING(ROUND(RemWork, 4), 1)))
			                VAR CalKey = MAXX(TaskRow, '01 XER_TASK'[calendar_id_key])
			                VAR WorkweekMask = MAXX(TaskRow, RELATED('10 XER_CALENDARS'[Workweek Mask]))
			                VAR WorkDays = LEN(SUBSTITUTE(WorkweekMask, "0", ""))
			                VAR UndatedMarkers =
			                    CALCULATE(
			                        COUNTROWS('11 XER_CALENDAR_DETAILED'),
			                        REMOVEFILTERS('11 XER_CALENDAR_DETAILED'),
			                        TREATAS({ CalKey }, '11 XER_CALENDAR_DETAILED'[clndr_id_key]),
			                        ISBLANK('11 XER_CALENDAR_DETAILED'[date]),
			                        '11 XER_CALENDAR_DETAILED'[exception_type] <> "Standard"
			                    )
			                RETURN
			                    IF(
			                        LEN(WorkweekMask) = 7 && WorkDays > 0 && NeedDays >= 1 && ISBLANK(UndatedMarkers),
			                        VAR AxisEnd = CALCULATE(MAX('Scenario Date'[Date]), REMOVEFILTERS('Scenario Date'))
			                        // Search no further than the scheduled finish + 400 days when even the latest candidate start (WindowEnd) completes by then:
			                        // every earlier start completes sooner, so results are unchanged and the exception deltas stay few. Otherwise (for example a
			                        // cutover calendar with long embargoes) search to the axis end. The reach test is the same for every axis date, so it is cached.
			                        VAR ScheduledFinish = CALCULATE(MAX('01 XER_TASK'[Finish]), KEEPFILTERS(TREATAS({ Code }, '01 XER_TASK'[task_code])))
			                        VAR NearEnd = MIN(AxisEnd, ScheduledFinish + 400)
			                        VAR ReachSpan = INT(NearEnd - WindowEnd) + 1
			                        VAR WorkingWeekdays = FILTER({ 1, 2, 3, 4, 5, 6, 7 }, MID(WorkweekMask, [Value], 1) = "1")
			                        VAR OffWeekdays = FILTER({ 1, 2, 3, 4, 5, 6, 7 }, MID(WorkweekMask, [Value], 1) = "0")
			                        VAR ReachClosures =
			                            CALCULATE(
			                                DISTINCTCOUNT('11 XER_CALENDAR_DETAILED'[date]),
			                                REMOVEFILTERS('11 XER_CALENDAR_DETAILED'),
			                                TREATAS({ CalKey }, '11 XER_CALENDAR_DETAILED'[clndr_id_key]),
			                                '11 XER_CALENDAR_DETAILED'[date] >= WindowEnd,
			                                '11 XER_CALENDAR_DETAILED'[date] <= NearEnd,
			                                TREATAS(WorkingWeekdays, '11 XER_CALENDAR_DETAILED'[day_of_week_num]),
			                                NOT ISBLANK('11 XER_CALENDAR_DETAILED'[work_hours]),
			                                '11 XER_CALENDAR_DETAILED'[work_hours] = 0,
			                                '11 XER_CALENDAR_DETAILED'[exception_type] <> "Exception - Invalid"
			                            )
			                        VAR ReachOpenings =
			                            CALCULATE(
			                                DISTINCTCOUNT('11 XER_CALENDAR_DETAILED'[date]),
			                                REMOVEFILTERS('11 XER_CALENDAR_DETAILED'),
			                                TREATAS({ CalKey }, '11 XER_CALENDAR_DETAILED'[clndr_id_key]),
			                                '11 XER_CALENDAR_DETAILED'[date] >= WindowEnd,
			                                '11 XER_CALENDAR_DETAILED'[date] <= NearEnd,
			                                TREATAS(OffWeekdays, '11 XER_CALENDAR_DETAILED'[day_of_week_num]),
			                                '11 XER_CALENDAR_DETAILED'[work_hours] > 0,
			                                '11 XER_CALENDAR_DETAILED'[exception_type] <> "Exception - Invalid"
			                            )
			                        VAR NearReached =
			                            ReachSpan > 0
			                                && QUOTIENT(ReachSpan, 7) * WorkDays + LEN(SUBSTITUTE(MID(WorkweekMask & WorkweekMask, WEEKDAY(WindowEnd, 2), MOD(ReachSpan, 7)), "0", ""))
			                                    - COALESCE(ReachClosures, 0) + COALESCE(ReachOpenings, 0) >= NeedDays
			                        VAR SearchEnd = IF(NearReached, NearEnd, AxisEnd)
			                        VAR Dated =
			                            CALCULATETABLE(
			                                SELECTCOLUMNS(
			                                    '11 XER_CALENDAR_DETAILED',
			                                    "__Date", '11 XER_CALENDAR_DETAILED'[date],
			                                    "__Hours", '11 XER_CALENDAR_DETAILED'[work_hours],
			                                    "__Type", '11 XER_CALENDAR_DETAILED'[exception_type]
			                                ),
			                                REMOVEFILTERS('11 XER_CALENDAR_DETAILED'),
			                                TREATAS({ CalKey }, '11 XER_CALENDAR_DETAILED'[clndr_id_key]),
			                                '11 XER_CALENDAR_DETAILED'[date] >= WindowStart,
			                                '11 XER_CALENDAR_DETAILED'[date] <= SearchEnd
			                            )
			                        VAR Valid =
			                            DISTINCT(
			                                SELECTCOLUMNS(
			                                    FILTER(Dated, NOT ISBLANK([__Hours]) && [__Hours] >= 0 && [__Type] <> "Exception - Invalid"),
			                                    "__Date", [__Date],
			                                    "__Working", IF([__Hours] > 0, 1, 0)
			                                )
			                            )
			                        // Unusable dates: invalid exceptions, or a date carrying both a working and a non-working exception.
			                        VAR FirstUnknown =
			                            MINX(
			                                FILTER(
			                                    UNION(
			                                        SELECTCOLUMNS(FILTER(Dated, ISBLANK([__Hours]) || [__Hours] < 0 || [__Type] = "Exception - Invalid"), "__Date", [__Date]),
			                                        SELECTCOLUMNS(FILTER(GROUPBY(Valid, [__Date], "__Flags", SUMX(CURRENTGROUP(), 1)), [__Flags] > 1), "__Date", [__Date])
			                                    ),
			                                    [__Date] >= CandidateStart
			                                ),
			                                [__Date]
			                            )
			                        VAR Deltas =
			                            FILTER(
			                                ADDCOLUMNS(
			                                    FILTER(Valid, [__Date] >= CandidateStart),
			                                    "__Delta", [__Working] - IF(MID(WorkweekMask, WEEKDAY([__Date], 2), 1) = "1", 1, 0)
			                                ),
			                                [__Delta] <> 0
			                            )
			                        VAR StartDow = WEEKDAY(CandidateStart, 2)
			                        VAR DoubleMask = WorkweekMask & WorkweekMask
			                        // Finish without exceptions from CandidateStart, as '01 XER_TASK'[Finish Without Exceptions]; exact when no exception falls before it.
			                        VAR FullWeeks = QUOTIENT(NeedDays - 1, WorkDays)
			                        VAR LastWeekRank = NeedDays - FullWeeks * WorkDays
			                        VAR ExceptionFreeFinish = CandidateStart + FullWeeks * 7 + FIND("X", SUBSTITUTE(MID(DoubleMask, StartDow, 7), "1", "X", LastWeekRank)) - 1
			                        VAR FinishFound =
			                            IF(
			                                ISEMPTY(FILTER(Deltas, [__Date] <= ExceptionFreeFinish)),
			                                ExceptionFreeFinish,
			                                // Bisection invariant: fewer than NeedDays working days through Lo, at least NeedDays through Hi.
			                                VAR Lo00 = CandidateStart - 1
			                                VAR Hi00 = SearchEnd
			                                VAR Mid01 = Lo00 + QUOTIENT(INT(Hi00 - Lo00), 2)
			                                VAR Ok01 = QUOTIENT(INT(Mid01 - CandidateStart) + 1, 7) * WorkDays + LEN(SUBSTITUTE(MID(DoubleMask, StartDow, MOD(INT(Mid01 - CandidateStart) + 1, 7)), "0", "")) + SUMX(FILTER(Deltas, [__Date] <= Mid01), [__Delta]) >= NeedDays
			                                VAR Lo01 = IF(Ok01, Lo00, Mid01)
			                                VAR Hi01 = IF(Ok01, Mid01, Hi00)
			                                VAR Mid02 = Lo01 + QUOTIENT(INT(Hi01 - Lo01), 2)
			                                VAR Ok02 = QUOTIENT(INT(Mid02 - CandidateStart) + 1, 7) * WorkDays + LEN(SUBSTITUTE(MID(DoubleMask, StartDow, MOD(INT(Mid02 - CandidateStart) + 1, 7)), "0", "")) + SUMX(FILTER(Deltas, [__Date] <= Mid02), [__Delta]) >= NeedDays
			                                VAR Lo02 = IF(Ok02, Lo01, Mid02)
			                                VAR Hi02 = IF(Ok02, Mid02, Hi01)
			                                VAR Mid03 = Lo02 + QUOTIENT(INT(Hi02 - Lo02), 2)
			                                VAR Ok03 = QUOTIENT(INT(Mid03 - CandidateStart) + 1, 7) * WorkDays + LEN(SUBSTITUTE(MID(DoubleMask, StartDow, MOD(INT(Mid03 - CandidateStart) + 1, 7)), "0", "")) + SUMX(FILTER(Deltas, [__Date] <= Mid03), [__Delta]) >= NeedDays
			                                VAR Lo03 = IF(Ok03, Lo02, Mid03)
			                                VAR Hi03 = IF(Ok03, Mid03, Hi02)
			                                VAR Mid04 = Lo03 + QUOTIENT(INT(Hi03 - Lo03), 2)
			                                VAR Ok04 = QUOTIENT(INT(Mid04 - CandidateStart) + 1, 7) * WorkDays + LEN(SUBSTITUTE(MID(DoubleMask, StartDow, MOD(INT(Mid04 - CandidateStart) + 1, 7)), "0", "")) + SUMX(FILTER(Deltas, [__Date] <= Mid04), [__Delta]) >= NeedDays
			                                VAR Lo04 = IF(Ok04, Lo03, Mid04)
			                                VAR Hi04 = IF(Ok04, Mid04, Hi03)
			                                VAR Mid05 = Lo04 + QUOTIENT(INT(Hi04 - Lo04), 2)
			                                VAR Ok05 = QUOTIENT(INT(Mid05 - CandidateStart) + 1, 7) * WorkDays + LEN(SUBSTITUTE(MID(DoubleMask, StartDow, MOD(INT(Mid05 - CandidateStart) + 1, 7)), "0", "")) + SUMX(FILTER(Deltas, [__Date] <= Mid05), [__Delta]) >= NeedDays
			                                VAR Lo05 = IF(Ok05, Lo04, Mid05)
			                                VAR Hi05 = IF(Ok05, Mid05, Hi04)
			                                VAR Mid06 = Lo05 + QUOTIENT(INT(Hi05 - Lo05), 2)
			                                VAR Ok06 = QUOTIENT(INT(Mid06 - CandidateStart) + 1, 7) * WorkDays + LEN(SUBSTITUTE(MID(DoubleMask, StartDow, MOD(INT(Mid06 - CandidateStart) + 1, 7)), "0", "")) + SUMX(FILTER(Deltas, [__Date] <= Mid06), [__Delta]) >= NeedDays
			                                VAR Lo06 = IF(Ok06, Lo05, Mid06)
			                                VAR Hi06 = IF(Ok06, Mid06, Hi05)
			                                VAR Mid07 = Lo06 + QUOTIENT(INT(Hi06 - Lo06), 2)
			                                VAR Ok07 = QUOTIENT(INT(Mid07 - CandidateStart) + 1, 7) * WorkDays + LEN(SUBSTITUTE(MID(DoubleMask, StartDow, MOD(INT(Mid07 - CandidateStart) + 1, 7)), "0", "")) + SUMX(FILTER(Deltas, [__Date] <= Mid07), [__Delta]) >= NeedDays
			                                VAR Lo07 = IF(Ok07, Lo06, Mid07)
			                                VAR Hi07 = IF(Ok07, Mid07, Hi06)
			                                VAR Mid08 = Lo07 + QUOTIENT(INT(Hi07 - Lo07), 2)
			                                VAR Ok08 = QUOTIENT(INT(Mid08 - CandidateStart) + 1, 7) * WorkDays + LEN(SUBSTITUTE(MID(DoubleMask, StartDow, MOD(INT(Mid08 - CandidateStart) + 1, 7)), "0", "")) + SUMX(FILTER(Deltas, [__Date] <= Mid08), [__Delta]) >= NeedDays
			                                VAR Lo08 = IF(Ok08, Lo07, Mid08)
			                                VAR Hi08 = IF(Ok08, Mid08, Hi07)
			                                VAR Mid09 = Lo08 + QUOTIENT(INT(Hi08 - Lo08), 2)
			                                VAR Ok09 = QUOTIENT(INT(Mid09 - CandidateStart) + 1, 7) * WorkDays + LEN(SUBSTITUTE(MID(DoubleMask, StartDow, MOD(INT(Mid09 - CandidateStart) + 1, 7)), "0", "")) + SUMX(FILTER(Deltas, [__Date] <= Mid09), [__Delta]) >= NeedDays
			                                VAR Lo09 = IF(Ok09, Lo08, Mid09)
			                                VAR Hi09 = IF(Ok09, Mid09, Hi08)
			                                VAR Mid10 = Lo09 + QUOTIENT(INT(Hi09 - Lo09), 2)
			                                VAR Ok10 = QUOTIENT(INT(Mid10 - CandidateStart) + 1, 7) * WorkDays + LEN(SUBSTITUTE(MID(DoubleMask, StartDow, MOD(INT(Mid10 - CandidateStart) + 1, 7)), "0", "")) + SUMX(FILTER(Deltas, [__Date] <= Mid10), [__Delta]) >= NeedDays
			                                VAR Lo10 = IF(Ok10, Lo09, Mid10)
			                                VAR Hi10 = IF(Ok10, Mid10, Hi09)
			                                VAR Mid11 = Lo10 + QUOTIENT(INT(Hi10 - Lo10), 2)
			                                VAR Ok11 = QUOTIENT(INT(Mid11 - CandidateStart) + 1, 7) * WorkDays + LEN(SUBSTITUTE(MID(DoubleMask, StartDow, MOD(INT(Mid11 - CandidateStart) + 1, 7)), "0", "")) + SUMX(FILTER(Deltas, [__Date] <= Mid11), [__Delta]) >= NeedDays
			                                VAR Lo11 = IF(Ok11, Lo10, Mid11)
			                                VAR Hi11 = IF(Ok11, Mid11, Hi10)
			                                VAR Mid12 = Lo11 + QUOTIENT(INT(Hi11 - Lo11), 2)
			                                VAR Ok12 = QUOTIENT(INT(Mid12 - CandidateStart) + 1, 7) * WorkDays + LEN(SUBSTITUTE(MID(DoubleMask, StartDow, MOD(INT(Mid12 - CandidateStart) + 1, 7)), "0", "")) + SUMX(FILTER(Deltas, [__Date] <= Mid12), [__Delta]) >= NeedDays
			                                VAR Lo12 = IF(Ok12, Lo11, Mid12)
			                                VAR Hi12 = IF(Ok12, Mid12, Hi11)
			                                VAR Mid13 = Lo12 + QUOTIENT(INT(Hi12 - Lo12), 2)
			                                VAR Ok13 = QUOTIENT(INT(Mid13 - CandidateStart) + 1, 7) * WorkDays + LEN(SUBSTITUTE(MID(DoubleMask, StartDow, MOD(INT(Mid13 - CandidateStart) + 1, 7)), "0", "")) + SUMX(FILTER(Deltas, [__Date] <= Mid13), [__Delta]) >= NeedDays
			                                VAR Lo13 = IF(Ok13, Lo12, Mid13)
			                                VAR Hi13 = IF(Ok13, Mid13, Hi12)
			                                RETURN IF(QUOTIENT(INT(SearchEnd - CandidateStart) + 1, 7) * WorkDays + LEN(SUBSTITUTE(MID(DoubleMask, StartDow, MOD(INT(SearchEnd - CandidateStart) + 1, 7)), "0", "")) + SUMX(FILTER(Deltas, [__Date] <= SearchEnd), [__Delta]) >= NeedDays, Hi13)
			                            )
			                        RETURN
			                            IF(
			                                NOT ISBLANK(FinishFound) && FinishFound <= SearchEnd
			                                    && (ISBLANK(FirstUnknown) || FinishFound < FirstUnknown),
			                                FinishFound
			                            )
			                    )
			            )
			    )
		formatString: dd/mm/yyyy
		isHidden
		displayFolder: Calendar Stretch
		lineageTag: 38176df8-a45e-53d3-91ef-53a33b9b2e60

	/// Cliff-edge chart value: calendar days between [CS Cliff Finish Date] for the axis start date and the activity's scheduled Finish (negative = sooner, positive = later).
	measure 'CS Cliff Finish Shift Days' =
			VAR CliffFinish = [CS Cliff Finish Date]
			RETURN
			    IF(
			        NOT ISBLANK(CliffFinish),
			        VAR Code = [CS Cliff Task Code]
			        VAR ScheduledFinish = CALCULATE(MAX('01 XER_TASK'[Finish]), KEEPFILTERS(TREATAS({ Code }, '01 XER_TASK'[task_code])))
			        RETURN INT(CliffFinish - ScheduledFinish)
			    )
		formatString: +#,0;-#,0;0
		displayFolder: Calendar Stretch
		lineageTag: 9e789e0f-0b2a-57f5-b003-c7f77e869815

	/// Cliff-edge chart title: the activity shown, and how to change it.
	measure 'CS Cliff Title' =
			VAR Code = [CS Cliff Task Code]
			VAR TaskName = CALCULATE(MAX('01 XER_TASK'[task_name]), KEEPFILTERS(TREATAS({ Code }, '01 XER_TASK'[task_code])))
			RETURN
			    IF(
			        ISBLANK(Code),
			        "Cliff edge · select one project and one update",
			        "Cliff edge · " & Code & " · " & TaskName
			            & IF(NOT HASONEVALUE('01 XER_TASK'[task_code]), " (largest delay; click an activity to change)")
			    )
		formatString: @
		displayFolder: Calendar Stretch
		lineageTag: c0e751cc-5d09-5f06-8958-3ba234c06b6a

	/// Cliff-edge callout for [CS Cliff Task Code]: the latest earlier start that would finish at least 7 days sooner, and the earliest later start that would finish at least 7 days later, among starts within 60 days of the remaining start. Evaluates [CS Cliff Finish Date] for the whole window in one pass over 'Scenario Date' (as the chart does), so its date-independent work is shared instead of repeated per probe.
	measure 'CS Cliff Callout' =
			VAR Code = [CS Cliff Task Code]
			RETURN
			    IF(
			        ISBLANK(Code),
			        "Select one project and one update to see the cliff edge.",
			        VAR DataDate = CALCULATE(MAX('01 XER_TASK'[data_date]), KEEPFILTERS(TREATAS({ Code }, '01 XER_TASK'[task_code])))
			        VAR TaskStart = CALCULATE(MAX('01 XER_TASK'[Start]), KEEPFILTERS(TREATAS({ Code }, '01 XER_TASK'[task_code])))
			        VAR EffectiveStart = IF(NOT ISBLANK(TaskStart) && NOT ISBLANK(DataDate), MAX(TaskStart, DataDate), TaskStart)
			        VAR ScheduledFinish = CALCULATE(MAX('01 XER_TASK'[Finish]), KEEPFILTERS(TREATAS({ Code }, '01 XER_TASK'[task_code])))
			        VAR WindowStart = MAX(DataDate, EffectiveStart - 60)
			        VAR WindowEnd = EffectiveStart + 60
			        VAR MaterialDays = 7
			        // One pass over the window, like the chart, so the date-independent work is shared.
			        VAR Finishes =
			            ADDCOLUMNS(
			                CALCULATETABLE(VALUES('Scenario Date'[Date]), REMOVEFILTERS('Scenario Date'), 'Scenario Date'[Date] >= WindowStart, 'Scenario Date'[Date] <= WindowEnd),
			                "__Finish", [CS Cliff Finish Date]
			            )
			        VAR ModelFinish = MAXX(FILTER(Finishes, 'Scenario Date'[Date] = EffectiveStart), [__Finish])
			        RETURN
			            IF(
			                ISBLANK(ModelFinish),
			                Code & ": the calendar's weekday rules or exceptions are unusable near its start, so no cliff edge is shown.",
			                VAR RecoveryStart = MAXX(FILTER(Finishes, 'Scenario Date'[Date] < EffectiveStart && NOT ISBLANK([__Finish]) && [__Finish] <= ModelFinish - MaterialDays), 'Scenario Date'[Date])
			                VAR RecoveryFinish = MAXX(FILTER(Finishes, 'Scenario Date'[Date] = RecoveryStart), [__Finish])
			                VAR SlipStart = MINX(FILTER(Finishes, 'Scenario Date'[Date] > EffectiveStart && NOT ISBLANK([__Finish]) && [__Finish] >= ModelFinish + MaterialDays), 'Scenario Date'[Date])
			                VAR SlipFinish = MAXX(FILTER(Finishes, 'Scenario Date'[Date] = SlipStart), [__Finish])
			                VAR RecoveryText =
			                    IF(
			                        NOT ISBLANK(RecoveryStart),
			                        "Start by " & FORMAT(RecoveryStart, "dd-MMM-yy") & " (" & FORMAT(INT(EffectiveStart - RecoveryStart), "#,0") & " days earlier) → finish "
			                            & FORMAT(RecoveryFinish, "dd-MMM-yy") & ", " & FORMAT(INT(ModelFinish - RecoveryFinish), "#,0") & " days sooner."
			                    )
			                VAR SlipText =
			                    IF(
			                        NOT ISBLANK(SlipStart),
			                        "If it starts after " & FORMAT(SlipStart - 1, "dd-MMM-yy") & ", the finish jumps to " & FORMAT(SlipFinish, "dd-MMM-yy")
			                            & " (+" & FORMAT(INT(SlipFinish - ModelFinish), "#,0") & " days)."
			                    )
			                VAR Caveat =
			                    IF(
			                        ModelFinish <> ScheduledFinish,
			                        " The calendar model finishes on " & FORMAT(ModelFinish, "dd-MMM-yy") & ", not the P6 finish " & FORMAT(ScheduledFinish, "dd-MMM-yy")
			                            & " (resource calendar or part-day duration)."
			                    )
			                RETURN
			                    Code & ": "
			                        & SWITCH(
			                            TRUE(),
			                            NOT ISBLANK(RecoveryStart) && NOT ISBLANK(SlipStart), RecoveryText & " " & SlipText,
			                            NOT ISBLANK(RecoveryStart), RecoveryText,
			                            NOT ISBLANK(SlipStart), SlipText,
			                            "no calendar cliff within 60 days of its remaining start; the finish moves day for day."
			                        )
			                        & Caveat
			            )
			    )
		formatString: @
		displayFolder: Calendar Stretch
		lineageTag: 8a126f1e-6c24-5b69-ad29-24bbd6ccd878

	partition 'XER Measures' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

