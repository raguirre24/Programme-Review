table 'XER Measures'
	lineageTag: 1c5bb7e0-f6a8-44e3-a17e-f631a724c979

	measure 'Variance to Previous Update' =
			
			// Variance slicers select activities in the matrix; they must not reshape history.
			CALCULATE(
			    // Narrowed activities (see 'Is Activity Selection') are traced by task_code.
			    VAR IsSelection = [Is Activity Selection]
			
			    VAR CurrentProject = SELECTEDVALUE('01 XER_TASK'[ProjectName])
			    VAR CurrentMonthUpdate = SELECTEDVALUE('01 XER_TASK'[UpdateDate])
			    VAR SelectedTaskTypes = SELECTEDVALUE(Filter_TaskType[TaskType], "All")
			
			    // Find the previous project update outside snapshot-level variance filters.
			    VAR PreviousMonthUpdate =
			        CALCULATE(
			            MAX('01 XER_TASK'[UpdateDate]),
			            FILTER(
			                ALL('01 XER_TASK'),
			                '01 XER_TASK'[UpdateDate] < CurrentMonthUpdate &&
			                '01 XER_TASK'[ProjectName] = CurrentProject
			            )
			        )
			
			    VAR IsFirstMonth = ISBLANK(PreviousMonthUpdate)
			
			    // Traced tasks: the selection fixed by 'Variance to Previous Update (History)', in every update.
			    VAR TracedTaskCodes =
			        CALCULATETABLE(
			            VALUES('01 XER_TASK'[task_code]),
			            REMOVEFILTERS('01 XER_TASK'[UpdateDate])
			        )
			
			    // Each traced task's latest reported update up to (and before) this one, regardless of its WBS or
			    // status then. A task missing from an update keeps its last reported finish, matching the matrix's
			    // previous-period variance; tasks new to the selection count from their first appearance.
			    VAR LastSeenCurrent =
			        CALCULATETABLE(
			            ADDCOLUMNS(
			                VALUES('01 XER_TASK'[task_code]),
			                "@LastUpdate", CALCULATE(MAX('01 XER_TASK'[UpdateDate]))
			            ),
			            REMOVEFILTERS('01 XER_TASK'),
			            REMOVEFILTERS('03 XER_PROJWBS'),
			            REMOVEFILTERS('09 XER_TASKACTV'),
			            TracedTaskCodes,
			            '01 XER_TASK'[ProjectName] = CurrentProject,
			            '01 XER_TASK'[UpdateDate] <= CurrentMonthUpdate,
			            NOT ISBLANK('01 XER_TASK'[Finish])
			        )
			    VAR LastSeenPrevious =
			        CALCULATETABLE(
			            ADDCOLUMNS(
			                VALUES('01 XER_TASK'[task_code]),
			                "@LastUpdate", CALCULATE(MAX('01 XER_TASK'[UpdateDate]))
			            ),
			            REMOVEFILTERS('01 XER_TASK'),
			            REMOVEFILTERS('03 XER_PROJWBS'),
			            REMOVEFILTERS('09 XER_TASKACTV'),
			            TracedTaskCodes,
			            '01 XER_TASK'[ProjectName] = CurrentProject,
			            '01 XER_TASK'[UpdateDate] < CurrentMonthUpdate,
			            NOT ISBLANK('01 XER_TASK'[Finish])
			        )
			
			    // The first update any traced task appears in starts the trace at zero (IF keeps the project path lazy).
			    VAR IsFirstAppearance = IF(IsSelection, ISEMPTY(LastSeenPrevious))
			
			    // ============================================
			    // CURRENT MONTH - MAX FINISH DATE (Original Logic)
			    // ============================================
			    VAR FinishCurrent =
			        IF(
			            IsSelection,
			            CALCULATE(
			                MAX('01 XER_TASK'[Finish]),
			                REMOVEFILTERS('01 XER_TASK'),
			                REMOVEFILTERS('03 XER_PROJWBS'),
			                REMOVEFILTERS('09 XER_TASKACTV'),
			                TREATAS(LastSeenCurrent, '01 XER_TASK'[task_code], '01 XER_TASK'[UpdateDate]),
			                '01 XER_TASK'[ProjectName] = CurrentProject
			            ),
			            CALCULATE(
			                MAX('01 XER_TASK'[Finish]),
			                FILTER(
			                    ALL('01 XER_TASK'),
			                    '01 XER_TASK'[UpdateDate] = CurrentMonthUpdate &&
			                    '01 XER_TASK'[ProjectName] = CurrentProject &&
			                    (SelectedTaskTypes = "All" || '01 XER_TASK'[TaskType_Classified] = SelectedTaskTypes)
			                )
			            )
			        )
			
			    // ============================================
			    // PREVIOUS MONTH - MAX FINISH DATE (Original Logic)
			    // ============================================
			    VAR FinishPrevious =
			        IF(
			            NOT(IsFirstMonth),
			            IF(
			                IsSelection,
			                CALCULATE(
			                    MAX('01 XER_TASK'[Finish]),
			                    REMOVEFILTERS('01 XER_TASK'),
			                    REMOVEFILTERS('03 XER_PROJWBS'),
			                    REMOVEFILTERS('09 XER_TASKACTV'),
			                    TREATAS(LastSeenPrevious, '01 XER_TASK'[task_code], '01 XER_TASK'[UpdateDate]),
			                    '01 XER_TASK'[ProjectName] = CurrentProject
			                ),
			                CALCULATE(
			                    MAX('01 XER_TASK'[Finish]),
			                    FILTER(
			                        ALL('01 XER_TASK'),
			                        '01 XER_TASK'[UpdateDate] = PreviousMonthUpdate &&
			                        '01 XER_TASK'[ProjectName] = CurrentProject &&
			                        (SelectedTaskTypes = "All" || '01 XER_TASK'[TaskType_Classified] = SelectedTaskTypes)
			                    )
			                )
			            ),
			            BLANK()
			        )
			
			    // Match the matrix's signed elapsed Monday-Friday calculation.
			    VAR HasComparableFinishes =
			        NOT(ISBLANK(FinishCurrent)) && NOT(ISBLANK(FinishPrevious))
			    VAR FinishCurrentDate =
			        IF(
			            HasComparableFinishes,
			            DATE(YEAR(FinishCurrent), MONTH(FinishCurrent), DAY(FinishCurrent)),
			            BLANK()
			        )
			    VAR FinishPreviousDate =
			        IF(
			            HasComparableFinishes,
			            DATE(YEAR(FinishPrevious), MONTH(FinishPrevious), DAY(FinishPrevious)),
			            BLANK()
			        )
			    VAR FinishMin = IF(HasComparableFinishes, MIN(FinishPreviousDate, FinishCurrentDate), BLANK())
			    VAR FinishMax = IF(HasComparableFinishes, MAX(FinishPreviousDate, FinishCurrentDate), BLANK())
			    VAR FinishDirection = IF(HasComparableFinishes, SIGN(FinishCurrentDate - FinishPreviousDate), BLANK())
			    VAR FinishCalendarDays = IF(HasComparableFinishes, DATEDIFF(FinishMin, FinishMax, DAY), BLANK())
			    VAR FinishFullWeeks = IF(HasComparableFinishes, QUOTIENT(FinishCalendarDays, 7), BLANK())
			    VAR FinishRemainder = IF(HasComparableFinishes, MOD(FinishCalendarDays, 7), BLANK())
			    VAR FinishStartDay = IF(HasComparableFinishes, WEEKDAY(FinishMin, 2), BLANK())
			    VAR FinishWeekdays =
			        IF(
			            HasComparableFinishes,
			            FinishFullWeeks * 5
			                + MAX(0, MIN(FinishRemainder, 6 - FinishStartDay))
			                + MAX(0, FinishRemainder - (8 - FinishStartDay)),
			            BLANK()
			        )
			
			    RETURN
			        IF(
			            IsFirstMonth || IsFirstAppearance,
			            0,
			            IF(
			                HasComparableFinishes,
			                FinishDirection * FinishWeekdays,
			                BLANK()
			            )
			        ),
			    REMOVEFILTERS(Filter_Finish_Delay),
			    REMOVEFILTERS(Filter_Start_Delay),
			    REMOVEFILTERS(Filter_Finish_Within),
			    REMOVEFILTERS(Filter_Start_Within),
			    REMOVEFILTERS('01 XER_TASK'[PreviousMonthFinishVarianceCategory]),
			    REMOVEFILTERS('01 XER_TASK'[PreviousMonthStartVarianceCategory]),
			    REMOVEFILTERS('01 XER_TASK'[FinishDateCategory]),
			    REMOVEFILTERS('01 XER_TASK'[StartDateCategory])
			)
		formatString: 0
		lineageTag: 6ba58ba7-c860-478c-ab62-c667ee1ca436

