	partition dbo_userpermission = m
		mode: import
		queryGroup: Database
		source =
				let
				    Source =
				        Value.NativeQuery(
				            AthenaDB,
				            "SELECT p.email AS linkedsite_email, up.userprincipalname, up.projectid, up.companyid, up.region, up.refresh_date, pr.projectno FROM ""prod_projectcontrols_linkedsitereports"".""dbo_userpermission"" up LEFT JOIN ""prod_projectcontrols_linkedsitereports"".""dbo_person"" p ON p.id = up.personid LEFT JOIN ""prod_projectcontrols_linkedsitereports"".""dbo_project"" pr ON pr.projectid = up.projectid WHERE up.privilegename IN ('ViewPowerBIProgrammeDashboards')",
				            null
				        ),
				
				    // Generate the alternate project code for each row
				    AddAltProjectNo =
				        Table.AddColumn(
				            Source,
				            "AltProjectNo",
				            each
				                if [projectno] = null or [projectno] = "" then
				                    null
				                else if Text.StartsWith([projectno], "C") then
				                    "J" & Text.Middle([projectno], 1)
				                else if Text.StartsWith([projectno], "J") then
				                    "C" & Text.Middle([projectno], 1)
				                else
				                    null,
				            type nullable text
				        ),
				
				    AddCodeList =
				        Table.AddColumn(
				            AddAltProjectNo,
				            "AllProjectCodes",
				            each
				                List.RemoveNulls(
				                    List.Distinct({[projectno], [AltProjectNo]})
				                ),
				            type list
				        ),
				
				    ExpandedCodes =
				        Table.ExpandListColumn(AddCodeList, "AllProjectCodes"),
				
				    RenameForRLS =
				        Table.RenameColumns(
				            Table.RemoveColumns(ExpandedCodes, {"projectno", "AltProjectNo"}),
				            {{"AllProjectCodes", "projectno"}}
				        ),
				
				    Deduped =
				        Table.Distinct(RenameForRLS)
				in
				    Deduped

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

