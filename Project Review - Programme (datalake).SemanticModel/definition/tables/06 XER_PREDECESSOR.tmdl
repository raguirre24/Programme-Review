	partition '06 XER_PREDECESSOR' = m
		mode: import
		queryGroup: XER
		source =
				let
				    Source =
				        fnAthenaSource(
				            "06_xer_predecessor",
				            Text.Combine(
				                {
				                    "t.""pred_type""",
				                    "t.""task_id_key""",
				                    "t.""pred_task_id_key""",
				                    "t.""status_code""",
				                    "t.""predecessor_status_code""",
				                    "t.""task_type""",
				                    "t.""predecessor_task_type""",
				                    "t.""lag""",
				                    "t.""start""",
				                    "t.""finish""",
				                    "t.""predecessor_start""",
				                    "t.""predecessor_finish""",
				                    "t.""free_float""",
				                    "t.""total_float"""
				                },
				                ", "
				            ),
				            // A link goes when either end is excluded from Data Lake reporting.
				            {"task_id_key", "pred_task_id_key"}
				        ),
				
				    #"Parsed Date" = Table.TransformColumns(Source,{{"start", each Date.From(DateTimeZone.From(_)), type date}, {"finish", each Date.From(DateTimeZone.From(_)), type date}, {"predecessor_start", each Date.From(DateTimeZone.From(_)), type date}, {"predecessor_finish", each Date.From(DateTimeZone.From(_)), type date}}),
				
				    Typed =
				        Table.TransformColumnTypes(
				            #"Parsed Date",
				            {
				                {"lag", type number},
				                {"free_float", type number},
				                {"total_float", type number}
				            }
				        ),
				    Contract = Record.Field(XerCsvTableContracts, "06_XER_PREDECESSOR"),
				    ContractModelColumns = Record.FieldOrDefault(Contract, "ModelColumns", Contract[Columns]),
				    ModelColumns = List.Combine({ContractModelColumns, {"IsCsvSource"}}),
				    AthenaFinal = Table.SelectColumns(Typed, ContractModelColumns),
				    AthenaBranch = if XerCsvRouting[HasAthenaProjects] then Table.AddColumn(AthenaFinal, "IsCsvSource", each false, type logical) else Table.AddColumn(Table.SelectColumns(fnXerCsvEmptyTable("06_XER_PREDECESSOR"), ContractModelColumns), "IsCsvSource", each false, type logical),
				    Combined = if XerCsvRouting[IsActive] then Table.Combine({AthenaBranch, fnXerCsvLoadTable("06_XER_PREDECESSOR")}) else AthenaBranch,
				    Final = Table.SelectColumns(Combined, ModelColumns)
				in
				    Final

	annotation PBI_NavigationStepName = Navigation

