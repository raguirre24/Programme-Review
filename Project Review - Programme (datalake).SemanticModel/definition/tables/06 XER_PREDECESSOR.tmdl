	column TaskCodeAndName =
			
			VAR _taskCode = RELATED('01 XER_TASK'[task_code])
			VAR _taskName = RELATED('01 XER_TASK'[task_name])
			RETURN
			    _taskCode & " - " & _taskName
		lineageTag: b6d53fc7-0751-4f43-a8cc-c36dd9fbab0c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column predecessor_task_code = LOOKUPVALUE('01 XER_TASK'[task_code],'01 XER_TASK'[Task_ID_key],[pred_task_id_key])
		lineageTag: f6f3a806-3c26-44ba-b90b-880b9a7eb127
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Successor_Level_2 =
			VAR SuccL2 = RELATED ( '03 XER_PROJWBS'[Level_2] )
			VAR SuccL1 = RELATED ( '03 XER_PROJWBS'[Level_1] )
			RETURN
			    COALESCE ( SuccL2, IF ( NOT ISBLANK ( SuccL1 ), SuccL1 & " (Level 1)" ) )
		lineageTag: edd8bac4-29f2-4178-9030-2130db1006ed
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Predecessor_Level_2 =
			VAR PredTaskKey = '06 XER_PREDECESSOR'[pred_task_id_key]
			VAR PredWbsKey =
			    CALCULATE (
			        SELECTEDVALUE ( '01 XER_TASK'[wbs_id_key] ),
			        FILTER (
			            ALL ( '01 XER_TASK' ),
			            '01 XER_TASK'[task_id_key] = PredTaskKey
			        )
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( PredWbsKey ),
			        CALCULATE (
			            MINX (
			                FILTER (
			                    ALL ( '03 XER_PROJWBS' ),
			                    '03 XER_PROJWBS'[wbs_id_key] = PredWbsKey
			                ),
			                COALESCE (
			                    '03 XER_PROJWBS'[Level_2],
			                    IF (
			                        NOT ISBLANK ( '03 XER_PROJWBS'[Level_1] ),
			                        '03 XER_PROJWBS'[Level_1] & " (Level 1)"
			                    )
			                )
			            )
			        )
			    )
		lineageTag: 1cfa0aa8-f050-434a-8ad5-40c9f5725f1f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Link_Type =
			VAR PredWbs = '06 XER_PREDECESSOR'[Predecessor_Level_2]
			VAR SuccWbs = '06 XER_PREDECESSOR'[Successor_Level_2]
			RETURN
			    IF (
			        NOT ISBLANK ( PredWbs ) && NOT ISBLANK ( SuccWbs ),
			        IF (
			            PredWbs = SuccWbs,
			            "Internal Link",
			            "Cross-WBS Link"
			        )
			    )
		lineageTag: 95640178-8db4-4f4c-8273-243f59583603
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column WBS_Link_Direction =
			VAR PredWbs = '06 XER_PREDECESSOR'[Predecessor_Level_2]
			VAR SuccWbs = '06 XER_PREDECESSOR'[Successor_Level_2]
			RETURN
			    IF (
			        NOT ISBLANK ( PredWbs ) && NOT ISBLANK ( SuccWbs ),
			        PredWbs & " → " & SuccWbs
			    )
		lineageTag: de16278c-97f0-4bd4-86cc-fc20a5bfd566
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is Driving Predecessor' =
			
			VAR CurrentTaskID = '06 XER_PREDECESSOR'[task_id_key]
			VAR CurrentFreeFloat = '06 XER_PREDECESSOR'[free_float]
			
			VAR MinFreeFloatForTask =
			    CALCULATE (
			        MIN ( '06 XER_PREDECESSOR'[free_float] ),
			        FILTER (
			            ALL ( '06 XER_PREDECESSOR' ),
			            '06 XER_PREDECESSOR'[task_id_key] = CurrentTaskID
			        )
			    )
			
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentFreeFloat ) && CurrentFreeFloat = MinFreeFloatForTask,
			        "Driving",
			        "Not Driving"
			    )
		lineageTag: 9c5ebbb1-dcd8-402b-861b-3e4b5fd11321
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Type Validity' =
			
			VAR taskType = '06 XER_PREDECESSOR'[task_type]
			VAR predTaskType = '06 XER_PREDECESSOR'[predecessor_task_type]
			VAR invalidTypes = { "TT_WBS", "TT_LOE" }
			
			RETURN
			    IF (
			        taskType IN invalidTypes || predTaskType IN invalidTypes,
			        "Invalid",
			        "Valid"
			    )
		lineageTag: 10c66ca2-309a-4bc6-bc92-0f0c44b0d730
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

