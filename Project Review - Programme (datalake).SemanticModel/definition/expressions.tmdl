	annotation PBI_ResultType = Function

expression XerCsvGovernanceValidation =
		if not XerCsvRouting[IsActive] then
		    true
		else
		    let
		        DigitChars = List.Transform({48..57}, each Character.FromNumber(_)),
		        Identity = (value as text) as text =>
		            let normalised = Text.Upper(Text.Trim(value)), suffix = if Text.Length(normalised) > 1 then Text.Range(normalised, 1) else ""
		            in if List.Contains({"C", "J"}, Text.Start(normalised, 1)) and Text.Length(suffix) > 0 and Text.Length(Text.Remove(suffix, DigitChars)) = 0 then suffix else normalised,
		        ProjectCodes = List.Distinct(List.Transform(List.RemoveNulls(Table.Column(dbo_project, "projectno")), each Identity(Text.From(_)))),
		        PermissionCodes = List.Distinct(List.Transform(List.RemoveNulls(Table.Column(dbo_userpermission, "projectno")), each Identity(Text.From(_)))),
		        MissingProjects = List.Select(XerCsvRouting[ProjectCodes], each not List.Contains(ProjectCodes, Identity(_))),
		        MissingPermissions = List.Select(XerCsvRouting[ProjectCodes], each not List.Contains(PermissionCodes, Identity(_))),
		        Result =
		            if List.Count(MissingProjects) > 0 then
		                error Error.Record("XerCsvGovernance", "CSV routing is blocked because a routed project is absent from governed dbo_project data.", [MissingProjects = Text.Combine(MissingProjects, ", ")])
		            else if List.Count(MissingPermissions) > 0 then
		                error Error.Record("XerCsvGovernance", "CSV routing is blocked because a routed project has no governed dbo_userpermission project entry.", [MissingProjects = Text.Combine(MissingPermissions, ", ")])
		            else
		                true
		    in
		        Result
	lineageTag: 4da6823a-90e9-4128-a472-62023c92d98d
	queryGroup: XER

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Logical

expression XerCsvValidatedData =
		if not XerCsvRouting[IsActive] then
		    [
		        Validation = true,
		        Tables = [
		            #"01_XER_TASK" = fnXerCsvEmptyTable("01_XER_TASK"), #"02_XER_PROJECT" = fnXerCsvEmptyTable("02_XER_PROJECT"),
		            #"03_XER_PROJWBS" = fnXerCsvEmptyTable("03_XER_PROJWBS"), #"06_XER_PREDECESSOR" = fnXerCsvEmptyTable("06_XER_PREDECESSOR"),
		            #"07_XER_ACTVTYPE" = fnXerCsvEmptyTable("07_XER_ACTVTYPE"), #"08_XER_ACTVCODE" = fnXerCsvEmptyTable("08_XER_ACTVCODE"),
		            #"09_XER_TASKACTV" = fnXerCsvEmptyTable("09_XER_TASKACTV"), #"10_XER_CALENDAR" = fnXerCsvEmptyTable("10_XER_CALENDAR"),
		            #"12_XER_RSRC" = fnXerCsvEmptyTable("12_XER_RSRC"), #"15_XER_RESOURCE_DISTRIBUTION" = fnXerCsvEmptyTable("15_XER_RESOURCE_DISTRIBUTION")
		        ]
		    ]
		else
		    let
		        BundleData = List.Transform(XerCsvSelectedBundles, each fnXerCsvReadBundleData(_)),
		        Validation = List.AllTrue(List.Transform(BundleData, each [Validation])),
		        Combine = (tableName as text) as table => Table.Combine(List.Transform(BundleData, each Record.Field([Tables], tableName))),
		        Tables = [
		            #"01_XER_TASK" = Combine("01_XER_TASK"), #"02_XER_PROJECT" = Combine("02_XER_PROJECT"),
		            #"03_XER_PROJWBS" = Combine("03_XER_PROJWBS"), #"06_XER_PREDECESSOR" = Combine("06_XER_PREDECESSOR"),
		            #"07_XER_ACTVTYPE" = Combine("07_XER_ACTVTYPE"), #"08_XER_ACTVCODE" = Combine("08_XER_ACTVCODE"),
		            #"09_XER_TASKACTV" = Combine("09_XER_TASKACTV"), #"10_XER_CALENDAR" = Combine("10_XER_CALENDAR"),
		            #"12_XER_RSRC" = Combine("12_XER_RSRC"), #"15_XER_RESOURCE_DISTRIBUTION" = Combine("15_XER_RESOURCE_DISTRIBUTION")
		        ]
		    in
		        [Validation = Validation, Tables = Tables]
	lineageTag: 17733fe2-b2ad-4784-b751-150b9794b992
	queryGroup: XER

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Record

expression fnXerCsvLoadTable =
		let
		    fn = (tableName as text) as table =>
		        if not XerCsvRouting[IsActive] then
		            fnXerCsvEmptyTable(tableName)
		        else if not XerCsvGovernanceValidation then
		            error Error.Record("XerCsvGovernance", "CSV governance validation failed.", [TableName = tableName])
		        else if tableName = "01_XER_TASK" and XerCsvValidatedData[Validation] then
		            Record.Field(XerCsvValidatedData[Tables], tableName)
		        else if tableName = "01_XER_TASK" then
		            error Error.Record("XerCsvValidation", "CSV bundle validation failed.", [TableName = tableName])
		        else
		            Table.SelectColumns(Table.Combine(List.Transform(XerCsvSelectedBundles, each fnXerCsvReadBundleTable(_, tableName))), Record.Field(XerCsvTableContracts, tableName)[Columns])
		in
		    fn
	lineageTag: 607fc50a-3538-4f55-81c5-7d988540ab38
	queryGroup: XER

