	annotation PBI_ResultType = Table

expression fnXerCsvReadBundleTable =
		let
		    fn = (bundle as record, tableName as text) as table =>
		        let
		            Contract = if Record.HasFields(XerCsvTableContracts, tableName) then Record.Field(XerCsvTableContracts, tableName) else error Error.Record("XerCsvContract", "Unknown Programme Review CSV table.", [TableName = tableName]),
		            FileMatches = Table.SelectRows(bundle[Files], each [Name] = Contract[FileName]),
		            FileBinary = if Table.RowCount(FileMatches) = 1 then FileMatches{0}[Content] else error Error.Record("XerCsvBundle", "Expected exactly one contract CSV file.", [BundleId = bundle[BundleId], FileName = Contract[FileName]]),
		            Raw = Csv.Document(FileBinary, [Delimiter = ",", Columns = List.Count(Contract[Columns]), Encoding = 65001, QuoteStyle = QuoteStyle.Csv, ExtraValues = ExtraValues.Error]),
		            Promoted = Table.PromoteHeaders(Raw, [PromoteAllScalars = true]),
		            ActualHeaders = Table.ColumnNames(Promoted),
		            HeaderChecked = if Text.Combine(ActualHeaders, "|") = Text.Combine(Contract[Columns], "|") then Promoted else error Error.Record("XerCsvSchema", "CSV headers or header order do not match the Programme Review contract.", [BundleId = bundle[BundleId], FileName = Contract[FileName], ActualHeaders = Text.Combine(ActualHeaders, ", ")]),
		            TransformOperations =
		                List.Transform(
		                    Contract[Types],
		                    (columnType as list) as list =>
		                        let
		                            ColumnName = columnType{0},
		                            TargetType = columnType{1}
		                        in
		                            {ColumnName, (cellValue as any) as any => fnXerCsvConvertValue(cellValue, ColumnName, Contract, bundle), TargetType}
		                ),
		            Converted = Table.TransformColumns(HeaderChecked, TransformOperations, null, MissingField.Error),
		            Selected = Table.SelectColumns(Converted, Contract[Columns], MissingField.Error),
		            WithSource = Table.AddColumn(Selected, "IsCsvSource", each true, type logical)
		        in
		            WithSource
		in
		    fn
	lineageTag: 00f92d84-734a-4b14-81ad-1659be5817ad
	queryGroup: XER

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fnXerCsvLoadTable =
		let
		    fn = (tableName as text) as table =>
		        let
		            Contract = if Record.HasFields(XerCsvTableContracts, tableName) then Record.Field(XerCsvTableContracts, tableName) else error Error.Record("XerCsvContract", "Unknown Programme Review CSV table.", [TableName = tableName]),
		            ContractModelColumns = Record.FieldOrDefault(Contract, "ModelColumns", Contract[Columns]),
		            ModelColumns = List.Combine({ContractModelColumns, {"IsCsvSource"}}),
		            Empty = Table.AddColumn(fnXerCsvEmptyTable(tableName), "IsCsvSource", each true, type logical),
		            Combined = if XerCsvRouting[IsActive] then Table.Combine(List.Transform(XerCsvSelectedBundles, each fnXerCsvReadBundleTable(_, tableName))) else Empty,
		            Result = Table.SelectColumns(Combined, ModelColumns, MissingField.Error)
		        in
		            Result
		in
		    fn
	lineageTag: 607fc50a-3538-4f55-81c5-7d988540ab38
	queryGroup: XER

