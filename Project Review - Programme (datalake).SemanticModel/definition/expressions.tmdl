expression fnXerCsvNavigate =
		let
		    fn = (navigation as table, path as text) as table =>
		        let
		            Segments = List.Select(List.Transform(Text.SplitAny(path, "/\"), each Text.Trim(_)), each _ <> ""),
		            Result =
		                List.Accumulate(
		                    Segments,
		                    navigation,
		                    (current as table, segment as text) as table =>
		                        let
		                            Matches = Table.SelectRows(current, each Text.Upper(Text.Trim(Text.From([Name]))) = Text.Upper(segment) and Value.Is([Content], type table)),
		                            MatchCount = Table.RowCount(Matches),
		                            Next =
		                                if MatchCount = 1 then
		                                    Matches{0}[Content]
		                                else
		                                    error Error.Record(
		                                        "XerCsvSharePointNavigation",
		                                        "Expected exactly one SharePoint folder while navigating the configured CSV path.",
		                                        [Segment = segment, Matches = MatchCount, Path = path]
		                                    )
		                        in
		                            Next
		                )
		        in
		            Result
		in
		    fn
