expression XerCsvSelectedBundles =
		if not XerCsvRouting[IsActive] then
		    {}
		else
		    let
		        SiteUrl = Text.Trim(SharePointSite),
		        Library = Text.Trim(XerCsvLibrary),
		        RootFolder = Text.Trim(XerCsvRootFolder),
		        ConfigChecked =
		            if SiteUrl = "" or Library = "" or RootFolder = "" then
		                error Error.Record("XerCsvConfiguration", "SharePointSite, XerCsvLibrary and XerCsvRootFolder are required when CSV routing is active.", [])
		            else
		                true,
		        Site = if ConfigChecked then SharePoint.Contents(SharePointSite, [ApiVersion = 15]) else error "Invalid CSV configuration.",
		        ActiveRoot = fnXerCsvNavigate(Site, Library & "/" & RootFolder),
		        RequiredProgrammes = if XerCsvRouting[ProgrammeType] = "ALL" then {"C", "T"} else {XerCsvRouting[ProgrammeType]},
		        ProjectFolders = Table.SelectRows(ActiveRoot, each Value.Is([Content], type table)),
		        ReadProjectFolder = (projectCode as text) as record =>
		            let
		                NormalisedProjectCode = Text.Upper(Text.Trim(projectCode)),
		                Matches =
		                    Table.SelectRows(
		                        ProjectFolders,
		                        each Text.Upper(Text.Trim(Text.From([Name]))) = NormalisedProjectCode
		                    ),
		                MatchCount = Table.RowCount(Matches),
		                Match =
		                    if MatchCount = 1 then
		                        Matches{0}
		                    else if MatchCount = 0 then
		                        error Error.Record(
		                            "XerCsvProjectFolder",
		                            "No active SharePoint project folder exists for a configured CSV project.",
		                            [ProjectCode = NormalisedProjectCode, ExpectedPath = RootFolder & "/" & NormalisedProjectCode]
		                        )
		                    else
		                        error Error.Record(
		                            "XerCsvProjectFolder",
		                            "More than one active SharePoint project folder matches a configured CSV project.",
		                            [ProjectCode = NormalisedProjectCode, Matches = MatchCount]
		                        ),
		                FolderName = Text.From(Match[Name]),
		                ExactFolderNameChecked =
		                    if FolderName = NormalisedProjectCode then
		                        true
		                    else
		                        error Error.Record(
		                            "XerCsvProjectFolder",
		                            "The SharePoint project folder must use the exact uppercase project code configured in XerCsvProjectCodes.",
		                            [ProjectCode = NormalisedProjectCode, ActualFolderName = FolderName]
		                        )
		            in
		                if ExactFolderNameChecked then [ProjectCode = NormalisedProjectCode, FolderName = FolderName, Content = Match[Content]] else error "Invalid SharePoint project folder.",
		        SelectedProjectFolders = List.Transform(XerCsvRouting[ProjectCodes], each ReadProjectFolder(_)),
		        ReadManifestBearingBundles = (projectFolder as record) as list =>
		            let
		                BundleFolders = Table.SelectRows(projectFolder[Content], each Value.Is([Content], type table)),
		                ParseBundleFolder = (bundleFolder as record) as nullable record =>
		                    let
		                        BundleId = Text.From(bundleFolder[Name]),
		                        Folder = bundleFolder[Content],
		                        FileRows = Table.SelectRows(Folder, each Value.Is([Content], type binary)),
		                        ManifestFiles = Table.SelectRows(FileRows, each [Name] = "XER_CSV_MANIFEST.csv"),
		                        ManifestCount = Table.RowCount(ManifestFiles),
		                        Prefix = projectFolder[ProjectCode] & "_",
		                        Tail = if Text.StartsWith(BundleId, Prefix) then Text.Range(BundleId, Text.Length(Prefix)) else "",
		                        Parts = Text.Split(Tail, "_"),
		                        ProgrammeType = if List.Count(Parts) = 3 then Text.Upper(Parts{0}) else "",
		                        TimestampPart = if List.Count(Parts) = 3 then Parts{1} else "",
		                        HashPart = if List.Count(Parts) = 3 then Text.Upper(Parts{2}) else "",
		                        DigitChars = List.Transform({48..57}, each Character.FromNumber(_)),
		                        HexChars = List.Combine({DigitChars, List.Transform({65..70}, each Character.FromNumber(_))}),
		                        TimestampDigits = if Text.Length(TimestampPart) = 16 then Text.Start(TimestampPart, 8) & Text.Range(TimestampPart, 9, 6) else "",
		                        TimestampIso = if Text.Length(TimestampPart) = 16 then Text.Start(TimestampPart, 4) & "-" & Text.Range(TimestampPart, 4, 2) & "-" & Text.Range(TimestampPart, 6, 2) & "T" & Text.Range(TimestampPart, 9, 2) & ":" & Text.Range(TimestampPart, 11, 2) & ":" & Text.Range(TimestampPart, 13, 2) & "Z" else "",
		                        ParsedTimestamp = try DateTimeZone.FromText(TimestampIso),
		                        NameValid =
		                            List.Count(Parts) = 3 and List.Contains({"C", "T"}, ProgrammeType) and
		                            Text.Length(TimestampPart) = 16 and Text.Range(TimestampPart, 8, 1) = "T" and Text.End(TimestampPart, 1) = "Z" and
		                            Text.Length(Text.Remove(TimestampDigits, DigitChars)) = 0 and not ParsedTimestamp[HasError] and
		                            Text.Length(HashPart) = 8 and Text.Length(Text.Remove(HashPart, HexChars)) = 0,
		                        Result =
		                            if ManifestCount = 0 then
		                                null
		                            else if ManifestCount > 1 then
		                                error Error.Record("XerCsvManifest", "A bundle folder contains more than one XER_CSV_MANIFEST.csv file.", [BundleId = BundleId])
		                            else if not NameValid then
		                                error Error.Record("XerCsvBundle", "A manifest-bearing bundle folder must use <PROJECT>_<C|T>_<yyyyMMddTHHmmssZ>_<hash8>.", [ProjectFolder = projectFolder[FolderName], BundleId = BundleId])
		                            else
		                                [ProjectCode = projectFolder[ProjectCode], ProgrammeType = ProgrammeType, BundleId = BundleId, BundleTimestamp = ParsedTimestamp[Value], Folder = Folder, Files = FileRows]
		                    in
		                        Result,
		                Candidates = List.RemoveNulls(List.Transform(Table.ToRecords(BundleFolders), each ParseBundleFolder(_))),
		                CandidateIds = List.Transform(Candidates, each [BundleId]),
		                DuplicateIds = List.Select(List.Distinct(CandidateIds), (bundleId) => List.Count(List.Select(CandidateIds, each _ = bundleId)) > 1),
		                Result =
		                    if List.Count(DuplicateIds) > 0 then
		                        error Error.Record("XerCsvBundle", "Duplicate manifest-bearing bundle folders were found.", [ProjectCode = projectFolder[ProjectCode], BundleIds = Text.Combine(DuplicateIds, ", ")])
		                    else
		                        Candidates
		            in
		                Result,
		        ManifestBearingBundles = List.Combine(List.Transform(SelectedProjectFolders, each ReadManifestBearingBundles(_))),
		        RelevantBundles = List.Select(ManifestBearingBundles, each XerCsvRouting[ProgrammeType] = "ALL" or [ProgrammeType] = XerCsvRouting[ProgrammeType]),
		        RequiredPairs = List.Combine(List.Transform(XerCsvRouting[ProjectCodes], (projectCode) => List.Transform(RequiredProgrammes, (programmeType) => [ProjectCode = projectCode, ProgrammeType = programmeType]))),
		        MissingPairs = List.Select(RequiredPairs, (pair) => List.Count(List.Select(RelevantBundles, each [ProjectCode] = pair[ProjectCode] and [ProgrammeType] = pair[ProgrammeType])) = 0),
		        MissingPairLabels = List.Transform(MissingPairs, each [ProjectCode] & "-" & [ProgrammeType]),
		        Selected =
		            if List.Count(MissingPairs) > 0 then
		                error Error.Record("XerCsvBundle", "No completed active CSV bundle exists for every routed project/programme pair.", [Missing = Text.Combine(MissingPairLabels, ", ")])
		            else
		                List.Transform(
		                    RequiredPairs,
		                    (pair) =>
		                        let
		                            Candidates = List.Select(RelevantBundles, each [ProjectCode] = pair[ProjectCode] and [ProgrammeType] = pair[ProgrammeType]),
		                            Sorted = Table.Sort(Table.FromRecords(Candidates), {{"BundleTimestamp", Order.Descending}, {"BundleId", Order.Descending}})
		                        in
		                            Sorted{0}
		                )
		    in
		        Selected
	lineageTag: dd9a27e7-fcbb-4829-bb15-95f54f1bfa8f
	queryGroup: XER

