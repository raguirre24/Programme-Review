	annotation PBI_ResultType = Function

expression fnXerCsvConvertValue =
		let
		    fn = (value as any, columnName as text, contract as record, bundle as record) as any =>
		        let
		            Token = if value = null then null else Text.From(value),
		            Trimmed = if Token = null then null else Text.Trim(Token),
		            IsBlank = Trimmed = null or Trimmed = "",
		            IsRequired = List.Contains(contract[RequiredColumns], columnName),
		            IsNamespace = List.Contains(contract[NamespaceColumns], columnName),
		            IsDateColumn = List.Contains(contract[DateColumns], columnName),
		            IsLogicalColumn = List.Contains(contract[LogicalColumns], columnName),
		            IsIntegerColumn = List.Contains(contract[IntegerColumns], columnName),
		            IsNumberColumn = List.Contains(contract[NumberColumns], columnName),
		            DigitChars = List.Transform({48..57}, each Character.FromNumber(_)),
		            NumberChars = List.Combine({DigitChars, {"-", "+", ".", "e", "E"}}),
		            DateValue = if IsBlank then null else try Date.FromText(Token, [Format = "yyyy-MM-dd", Culture = "en-US"]),
		            UnsignedInteger = if IsBlank then "" else if Text.StartsWith(Token, "-") then Text.Range(Token, 1) else Token,
		            IntegerValid = not IsBlank and Text.Length(UnsignedInteger) > 0 and Text.Length(Text.Remove(UnsignedInteger, DigitChars)) = 0,
		            NumberValue = if IsBlank then null else try Number.FromText(Token, "en-US"),
		            NumberValid = not IsBlank and Token = Trimmed and Text.Length(Text.Select(Token, DigitChars)) > 0 and Text.Length(Text.Remove(Token, NumberChars)) = 0 and not Text.Contains(Token, ",") and not NumberValue[HasError],
		            ProjectValue = if IsBlank then null else Text.Upper(Trimmed),
		            Result =
		                if IsNamespace then
		                    fnXerCsvCompactKey(value, bundle, columnName, IsRequired)
		                else if IsBlank and IsRequired then
		                    error Error.Record("XerCsvData", "A required CSV field is null or blank.", [BundleId = bundle[BundleId], Column = columnName])
		                else if IsBlank then
		                    null
		                else if IsDateColumn then
		                    if Text.Length(Token) = 10 and Text.Range(Token, 4, 1) = "-" and Text.Range(Token, 7, 1) = "-" and not DateValue[HasError] and Date.ToText(DateValue[Value], "yyyy-MM-dd", "en-US") = Token then DateValue[Value] else error Error.Record("XerCsvFormat", "Date value must use yyyy-MM-dd.", [BundleId = bundle[BundleId], Column = columnName, Value = Token])
		                else if IsLogicalColumn then
		                    if Token = "true" then true else if Token = "false" then false else error Error.Record("XerCsvFormat", "Logical value must be true or false.", [BundleId = bundle[BundleId], Column = columnName, Value = Token])
		                else if IsIntegerColumn then
		                    if IntegerValid then Int64.From(Number.FromText(Token, "en-US")) else error Error.Record("XerCsvFormat", "Integer value must use invariant digits.", [BundleId = bundle[BundleId], Column = columnName, Value = Token])
		                else if IsNumberColumn then
		                    if NumberValid then NumberValue[Value] else error Error.Record("XerCsvFormat", "Number value must use an invariant decimal point.", [BundleId = bundle[BundleId], Column = columnName, Value = Token])
		                else if contract[ProjectColumn] <> null and columnName = contract[ProjectColumn] then
		                    if ProjectValue = bundle[ProjectCode] then ProjectValue else error Error.Record("XerCsvData", "CSV ProjectCode does not match its SharePoint project folder.", [BundleId = bundle[BundleId], Column = columnName, Value = Token, Expected = bundle[ProjectCode]])
		                else
		                    Token
		        in
		            Result
		in
		    fn
