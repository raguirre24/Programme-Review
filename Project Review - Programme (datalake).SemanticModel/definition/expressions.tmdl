	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression XerCsvSelectedBundles =
		if not XerCsvRouting[IsActive] then
		    {}
		else
		    let
		        CsvSiteOverride = Text.Trim(XerCsvSiteUrl),
		        SiteUrl = if CsvSiteOverride = "" then Text.Trim(SharePointSite) else CsvSiteOverride,
		        Library = Text.Trim(XerCsvLibrary),
		        RootFolder = Text.Trim(XerCsvRootFolder),
		        ConfigChecked =
		            if SiteUrl = "" or Library = "" or RootFolder = "" then
		                error Error.Record("XerCsvConfiguration", "SharePointSite (or the optional XerCsvSiteUrl override), XerCsvLibrary and XerCsvRootFolder are required when CSV routing is active.", [])
		            else
		                true,
		        Site = if ConfigChecked then SharePoint.Contents(SiteUrl, [ApiVersion = 15]) else error "Invalid CSV configuration.",
		        ActiveRoot = fnXerCsvNavigate(Site, Library & "/" & RootFolder),
		        RequiredProgrammes = if XerCsvRouting[ProgrammeType] = "ALL" then {"C", "T"} else {XerCsvRouting[ProgrammeType]},
		        ProjectFolders = Table.SelectRows(ActiveRoot, each Value.Is([Content], type table)),
		        ReadProjectFolder = (projectCode as text) as record =>
		            let
		                NormalisedProjectCode = Text.Upper(Text.Trim(projectCode)),
		                Matches =
		                    Table.SelectRows(
		                        ProjectFolders,
		                        each Text.Upper(Text.Trim(Text.From([Name]))) = NormalisedProjectCode
		                    ),
		                MatchCount = Table.RowCount(Matches),
		                Match =
		                    if MatchCount = 1 then
		                        Matches{0}
		                    else if MatchCount = 0 then
		                        error Error.Record(
		                            "XerCsvProjectFolder",
		                            "No active SharePoint project folder exists for a configured CSV project.",
		                            [ProjectCode = NormalisedProjectCode, ExpectedPath = RootFolder & "/" & NormalisedProjectCode]
		                        )
		                    else
		                        error Error.Record(
		                            "XerCsvProjectFolder",
		                            "More than one active SharePoint project folder matches a configured CSV project.",
		                            [ProjectCode = NormalisedProjectCode, Matches = MatchCount]
		                        ),
		                FolderName = Text.From(Match[Name]),
		                ExactFolderNameChecked =
		                    if FolderName = NormalisedProjectCode then
		                        true
		                    else
		                        error Error.Record(
		                            "XerCsvProjectFolder",
		                            "The SharePoint project folder must use the exact uppercase project code configured in XerCsvProjectCodes.",
		                            [ProjectCode = NormalisedProjectCode, ActualFolderName = FolderName]
		                        )
		            in
		                if ExactFolderNameChecked then [ProjectCode = NormalisedProjectCode, FolderName = FolderName, Content = Match[Content]] else error "Invalid SharePoint project folder.",
		        SelectedProjectFolders = List.Transform(XerCsvRouting[ProjectCodes], each ReadProjectFolder(_)),
		        ReadCompletedBundles = (projectFolder as record) as list =>
		            let
		                BundleFolders = Table.SelectRows(projectFolder[Content], each Value.Is([Content], type table)),
		                ParsedBundles = List.RemoveNulls(List.Transform(Table.ToRecords(BundleFolders), each fnXerCsvReadBundle(Text.From([Name]), [Content]))),
		                MismatchedBundles = List.Select(ParsedBundles, each Text.Upper(Text.Trim([ProjectCode])) <> projectFolder[ProjectCode]),
		                MismatchedBundleIds = List.Transform(MismatchedBundles, each [BundleId]),
		                ValidatedBundles =
		                    if List.Count(MismatchedBundles) > 0 then
		                        error Error.Record(
		                            "XerCsvProjectFolder",
		                            "A completed bundle manifest does not match its parent SharePoint project folder.",
		                            [ProjectFolder = projectFolder[FolderName], BundleIds = Text.Combine(MismatchedBundleIds, ", ")]
		                        )
		                    else
		                        ParsedBundles
		            in
		                ValidatedBundles,
		        CompletedBundles = List.Combine(List.Transform(SelectedProjectFolders, each ReadCompletedBundles(_))),
		        RelevantBundles = List.Select(CompletedBundles, each List.Contains(XerCsvRouting[ProjectCodes], [ProjectCode]) and (XerCsvRouting[ProgrammeType] = "ALL" or [ProgrammeType] = XerCsvRouting[ProgrammeType])),
		        RequiredPairs = List.Combine(List.Transform(XerCsvRouting[ProjectCodes], (projectCode) => List.Transform(RequiredProgrammes, (programmeType) => [ProjectCode = projectCode, ProgrammeType = programmeType]))),
		        MissingPairs = List.Select(RequiredPairs, (pair) => List.Count(List.Select(RelevantBundles, each [ProjectCode] = pair[ProjectCode] and [ProgrammeType] = pair[ProgrammeType])) = 0),
		        MissingPairLabels = List.Transform(MissingPairs, each [ProjectCode] & "-" & [ProgrammeType]),
		        Selected =
		            if List.Count(MissingPairs) > 0 then
		                error Error.Record("XerCsvBundle", "No completed active CSV bundle exists for every routed project/programme pair.", [Missing = Text.Combine(MissingPairLabels, ", ")])
		            else
		                List.Transform(
		                    RequiredPairs,
		                    (pair) =>
		                        let
		                            Candidates = List.Select(RelevantBundles, each [ProjectCode] = pair[ProjectCode] and [ProgrammeType] = pair[ProgrammeType]),
		                            Sorted = Table.Sort(Table.FromRecords(Candidates), {{"ExportedAtUtc", Order.Descending}, {"BundleId", Order.Descending}})
		                        in
		                            Sorted{0}
		                )
		    in
		        Selected
