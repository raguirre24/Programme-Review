	annotation PBI_ResultType = Function

expression fnXerCsvCompactKey =
		let
		    fn = (value as any, bundle as record, columnName as text, required as logical) as nullable text =>
		        let
		            Raw = if value = null then null else Text.Trim(Text.From(value)),
		            IsBlank = Raw = null or Raw = "",
		            Parts = if IsBlank then {} else Text.Split(Raw, "::"),
		            ProjectCode = Text.Upper(Text.Trim(bundle[ProjectCode])),
		            ProgrammeType = Text.Upper(Text.Trim(bundle[ProgrammeType])),
		            DigitChars = List.Transform({48..57}, each Character.FromNumber(_)),
		            UpperChars = List.Transform({65..90}, each Character.FromNumber(_)),
		            IsDigits = (token as text) as logical => Text.Length(token) > 0 and Text.Length(Text.Remove(token, DigitChars)) = 0,
		            IsSnapshotTag = (token as text) as logical =>
		                let
		                    BaselineTail = if Text.StartsWith(token, "BL") then Text.Range(token, 2) else "",
		                    BaselineParts = Text.Split(BaselineTail, "-"),
		                    BaselineRevisionValid = if List.Count(BaselineParts) = 1 then true else if List.Count(BaselineParts) = 2 then Text.Length(BaselineParts{1}) = 1 and Text.Length(Text.Remove(BaselineParts{1}, UpperChars)) = 0 else false,
		                    BaselineValid = List.Contains({1, 2}, List.Count(BaselineParts)) and Text.Length(BaselineParts{0}) = 2 and IsDigits(BaselineParts{0}) and BaselineRevisionValid,
		                    UpdateMonth = if Text.Length(token) = 4 and IsDigits(token) then Number.FromText(Text.End(token, 2), "en-US") else null
		                in
		                    token = Text.Trim(token) and (BaselineValid or (UpdateMonth <> null and UpdateMonth >= 1 and UpdateMonth <= 12)),
		            IsNativeId = (token as text) as logical => Text.Trim(token) <> "" and token = Text.Trim(token) and not Text.Contains(token, "|") and not Text.Contains(token, "::"),
		            V3Valid =
		                List.Count(Parts) = 5 and Parts{0} = "CSV" and
		                Text.Upper(Parts{1}) = ProjectCode and Text.Upper(Parts{2}) = ProgrammeType and
		                IsSnapshotTag(Parts{3}) and IsNativeId(Parts{4}),
		            V2Canonical = if List.Count(Parts) = 4 and Parts{0} = "CSV" and Parts{1} = bundle[BundleId] then Parts{2} else null,
		            CanonicalPrefix = ProjectCode & "-" & ProgrammeType & "-",
		            V2HasEnvelope = V2Canonical <> null and Text.StartsWith(V2Canonical, CanonicalPrefix) and Text.EndsWith(V2Canonical, ".xer"),
		            V2Core = if V2HasEnvelope then Text.Range(V2Canonical, Text.Length(CanonicalPrefix), Text.Length(V2Canonical) - Text.Length(CanonicalPrefix) - 4) else "",
		            V2CoreParts = Text.Split(V2Core, "_"),
		            V2SnapshotTag = if List.Count(V2CoreParts) = 2 then V2CoreParts{0} else "",
		            V2NativeId = if List.Count(Parts) = 4 then Parts{3} else "",
		            V2DateToken = if List.Count(V2CoreParts) = 2 then V2CoreParts{1} else "",
		            V2Valid = V2HasEnvelope and List.Count(V2CoreParts) = 2 and IsSnapshotTag(V2SnapshotTag) and Text.Length(V2DateToken) = 8 and IsDigits(V2DateToken) and IsNativeId(V2NativeId),
		            V1Parts = if IsBlank then {} else Text.Split(Raw, "|"),
		            V1Tail = if List.Count(V1Parts) = 3 and V1Parts{0} = "CSV" and V1Parts{1} = bundle[BundleId] then V1Parts{2} else null,
		            V1MarkerPosition = if V1Tail = null then -1 else Text.PositionOf(V1Tail, ".xer.", Occurrence.First),
		            V1Canonical = if V1MarkerPosition >= 0 then Text.Start(V1Tail, V1MarkerPosition + 4) else null,
		            V1NativeId = if V1MarkerPosition >= 0 then Text.Range(V1Tail, V1MarkerPosition + 5) else "",
		            V1HasEnvelope = V1Canonical <> null and Text.StartsWith(V1Canonical, CanonicalPrefix) and Text.EndsWith(V1Canonical, ".xer"),
		            V1Core = if V1HasEnvelope then Text.Range(V1Canonical, Text.Length(CanonicalPrefix), Text.Length(V1Canonical) - Text.Length(CanonicalPrefix) - 4) else "",
		            V1CoreParts = Text.Split(V1Core, "_"),
		            V1SnapshotTag = if List.Count(V1CoreParts) = 2 then V1CoreParts{0} else "",
		            V1DateToken = if List.Count(V1CoreParts) = 2 then V1CoreParts{1} else "",
		            V1Valid = V1HasEnvelope and List.Count(V1CoreParts) = 2 and IsSnapshotTag(V1SnapshotTag) and Text.Length(V1DateToken) = 8 and IsDigits(V1DateToken) and IsNativeId(V1NativeId),
		            SnapshotTag = if V3Valid then Parts{3} else if V2Valid then V2SnapshotTag else if V1Valid then V1SnapshotTag else null,
		            NativeId = if V3Valid then Parts{4} else if V2Valid then V2NativeId else if V1Valid then V1NativeId else null,
		            Compact = if SnapshotTag = null or NativeId = null then null else "CSV::" & ProjectCode & "::" & ProgrammeType & "::" & SnapshotTag & "::" & NativeId,
		            Result =
		                if IsBlank and not required then
		                    null
		                else if IsBlank then
		                    error Error.Record("XerCsvData", "A required relationship key is blank.", [BundleId = bundle[BundleId], Column = columnName])
		                else if Compact = null or (Text.Contains(Raw, "|") and not V1Valid) then
		                    error Error.Record("XerCsvData", "Relationship key is neither a valid legacy schema 1.0/2.0 key nor a compact schema 3.0 key.", [BundleId = bundle[BundleId], Column = columnName, Value = Raw])
		                else
		                    Compact
		        in
		            Result
		in
		    fn
