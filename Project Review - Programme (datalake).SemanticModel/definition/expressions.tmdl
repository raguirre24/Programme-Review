expression fnXerCsvAssertReferences =
		let
		    fn = (child as table, childColumn as text, parent as table, parentColumn as text, relationshipName as text) as logical =>
		        let
		            ChildKeys = List.Distinct(List.Select(Table.Column(child, childColumn), each _ <> null and Text.Trim(Text.From(_)) <> "")),
		            ParentKeys = List.Distinct(List.Select(Table.Column(parent, parentColumn), each _ <> null and Text.Trim(Text.From(_)) <> "")),
		            Missing = List.Difference(ChildKeys, ParentKeys),
		            Result = if List.Count(Missing) = 0 then true else error Error.Record("XerCsvReferentialIntegrity", "CSV relationship keys do not resolve within the selected bundle.", [Relationship = relationshipName, MissingCount = List.Count(Missing), Example = Text.From(Missing{0})])
		        in
		            Result
		in
		    fn
	lineageTag: fcc3c874-4455-44a1-b1e8-b8f3932aa038
	queryGroup: XER

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fnXerCsvReadBundleData =
		let
		    fn = (bundle as record) as record =>
		        let
		            T01 = fnXerCsvReadBundleTable(bundle, "01_XER_TASK"),
		            T02 = fnXerCsvReadBundleTable(bundle, "02_XER_PROJECT"),
		            T03 = fnXerCsvReadBundleTable(bundle, "03_XER_PROJWBS"),
		            T06 = fnXerCsvReadBundleTable(bundle, "06_XER_PREDECESSOR"),
		            T07 = fnXerCsvReadBundleTable(bundle, "07_XER_ACTVTYPE"),
		            T08 = fnXerCsvReadBundleTable(bundle, "08_XER_ACTVCODE"),
		            T09 = fnXerCsvReadBundleTable(bundle, "09_XER_TASKACTV"),
		            T10 = fnXerCsvReadBundleTable(bundle, "10_XER_CALENDAR"),
		            T12 = fnXerCsvReadBundleTable(bundle, "12_XER_RSRC"),
		            T15 = fnXerCsvReadBundleTable(bundle, "15_XER_RESOURCE_DISTRIBUTION"),
		            ManifestFiles = Table.RenameColumns(Table.Distinct(Table.SelectColumns(bundle[Manifest], {"canonical_xer_filename"})), {{"canonical_xer_filename", "filename"}}),
		            Checks = {
		                fnXerCsvAssertReferences(T01, "filename", ManifestFiles, "filename", "01 filename -> manifest canonical filename"),
		                fnXerCsvAssertReferences(T01, "proj_id_key", T02, "proj_id_key", "01 proj_id_key -> 02 proj_id_key"),
		                fnXerCsvAssertReferences(T01, "wbs_id_key", T03, "wbs_id_key", "01 wbs_id_key -> 03 wbs_id_key"),
		                fnXerCsvAssertReferences(T01, "calendar_id_key", T10, "clndr_id_key", "01 calendar_id_key -> 10 clndr_id_key"),
		                fnXerCsvAssertReferences(T03, "parent_wbs_id_key", T03, "wbs_id_key", "03 parent_wbs_id_key -> 03 wbs_id_key"),
		                fnXerCsvAssertReferences(T06, "task_id_key", T01, "task_id_key", "06 task_id_key -> 01 task_id_key"),
		                fnXerCsvAssertReferences(T06, "pred_task_id_key", T01, "task_id_key", "06 pred_task_id_key -> 01 task_id_key"),
		                fnXerCsvAssertReferences(T08, "actv_code_type_id_key", T07, "actv_code_type_id_key", "08 actv_code_type_id_key -> 07 actv_code_type_id_key"),
		                fnXerCsvAssertReferences(T09, "task_id_key", T01, "task_id_key", "09 task_id_key -> 01 task_id_key"),
		                fnXerCsvAssertReferences(T09, "actv_code_id_key", T08, "actv_code_id_key", "09 actv_code_id_key -> 08 actv_code_id_key"),
		                fnXerCsvAssertReferences(T15, "task_id_key", T01, "task_id_key", "15 task_id_key -> 01 task_id_key"),
		                fnXerCsvAssertReferences(T15, "rsrc_id_key", T12, "rsrc_id_key", "15 rsrc_id_key -> 12 rsrc_id_key")
		            },
		            Validation = List.AllTrue(Checks),
		            Tables = [#"01_XER_TASK" = T01, #"02_XER_PROJECT" = T02, #"03_XER_PROJWBS" = T03, #"06_XER_PREDECESSOR" = T06, #"07_XER_ACTVTYPE" = T07, #"08_XER_ACTVCODE" = T08, #"09_XER_TASKACTV" = T09, #"10_XER_CALENDAR" = T10, #"12_XER_RSRC" = T12, #"15_XER_RESOURCE_DISTRIBUTION" = T15]
		        in
		            [Validation = Validation, Tables = Tables]
		in
		    fn
