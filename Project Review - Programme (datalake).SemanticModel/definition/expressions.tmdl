expression fnXerCsvValidateRawTokens =
		let
		    fn = (source as table, dateColumns as list, logicalColumns as list, integerColumns as list, numberColumns as list, context as text) as table =>
		        let
		            DigitChars = List.Transform({48..57}, each Character.FromNumber(_)),
		            IsBlank = (value as any) as logical => value = null or Text.From(value) = "",
		            IsDigits = (value as text) as logical => Text.Length(value) > 0 and Text.Length(Text.Remove(value, DigitChars)) = 0,
		            IsDate = (value as any) as logical =>
		                if IsBlank(value) then true else
		                let
		                    token = Text.From(value),
		                    parsed = try Date.FromText(token, [Format = "yyyy-MM-dd", Culture = "en-US"])
		                in
		                    Text.Length(token) = 10 and Text.Range(token, 4, 1) = "-" and Text.Range(token, 7, 1) = "-" and IsDigits(Text.Remove(token, {"-"})) and not parsed[HasError] and Date.ToText(parsed[Value], "yyyy-MM-dd", "en-US") = token,
		            IsLogical = (value as any) as logical => IsBlank(value) or List.Contains({"true", "false"}, Text.From(value)),
		            IsInteger = (value as any) as logical =>
		                if IsBlank(value) then true else
		                let token = Text.From(value), unsigned = if Text.StartsWith(token, "-") then Text.Range(token, 1) else token
		                in IsDigits(unsigned),
		            IsNumber = (value as any) as logical =>
		                if IsBlank(value) then true else
		                let
		                    token = Text.From(value),
		                    lower = Text.Lower(token),
		                    exponentParts = Text.Split(lower, "e"),
		                    mantissa = exponentParts{0},
		                    unsignedMantissa = if Text.StartsWith(mantissa, "-") then Text.Range(mantissa, 1) else mantissa,
		                    decimalParts = Text.Split(unsignedMantissa, "."),
		                    exponent = if List.Count(exponentParts) = 2 then exponentParts{1} else null,
		                    unsignedExponent = if exponent <> null and (Text.StartsWith(exponent, "-") or Text.StartsWith(exponent, "+")) then Text.Range(exponent, 1) else exponent,
		                    mantissaValid = List.Count(decimalParts) <= 2 and List.AllTrue(List.Transform(decimalParts, each IsDigits(_))),
		                    exponentValid = List.Count(exponentParts) = 1 or (List.Count(exponentParts) = 2 and unsignedExponent <> null and IsDigits(unsignedExponent)),
		                    parsed = try Number.FromText(token, "en-US")
		                in
		                    mantissaValid and exponentValid and not parsed[HasError],
		            InvalidDates = List.Select(dateColumns, (columnName) => Table.RowCount(Table.SelectRows(source, each not IsDate(Record.Field(_, columnName)))) > 0),
		            InvalidLogicals = List.Select(logicalColumns, (columnName) => Table.RowCount(Table.SelectRows(source, each not IsLogical(Record.Field(_, columnName)))) > 0),
		            InvalidIntegers = List.Select(integerColumns, (columnName) => Table.RowCount(Table.SelectRows(source, each not IsInteger(Record.Field(_, columnName)))) > 0),
		            InvalidNumbers = List.Select(numberColumns, (columnName) => Table.RowCount(Table.SelectRows(source, each not IsNumber(Record.Field(_, columnName)))) > 0),
		            Invalid = List.Combine({InvalidDates, InvalidLogicals, InvalidIntegers, InvalidNumbers}),
		            Result = if List.Count(Invalid) = 0 then source else error Error.Record("XerCsvFormat", "CSV values do not use the required ISO date, true/false logical, or invariant numeric format.", [Context = context, Columns = Text.Combine(List.Distinct(Invalid), ", ")])
		        in
		            Result
		in
		    fn
	lineageTag: 85bd4d9d-f8ba-4cb6-9c47-3147b230f01b
	queryGroup: XER

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fnXerCsvEmptyTable =
		let
		    fn = (tableName as text) as table =>
		        let
		            Contract =
		                if Record.HasFields(XerCsvTableContracts, tableName) then
		                    Record.Field(XerCsvTableContracts, tableName)
		                else
		                    error Error.Record("XerCsvContract", "Unknown Programme Review CSV table.", [TableName = tableName]),
		            Empty = #table(Contract[Columns], {}),
		            Typed = Table.TransformColumnTypes(Empty, Contract[Types], "en-NZ")
		        in
		            Typed
		in
		    fn
	lineageTag: 4f2893c1-2db6-46fa-a08c-dc4d2987216e
	queryGroup: XER

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fnXerCsvNavigate =
		let
		    fn = (navigation as table, path as text) as table =>
		        let
		            Segments = List.Select(List.Transform(Text.SplitAny(path, "/\"), each Text.Trim(_)), each _ <> ""),
		            Result =
		                List.Accumulate(
		                    Segments,
		                    navigation,
		                    (current as table, segment as text) as table =>
		                        let
		                            Matches = Table.SelectRows(current, each Text.Upper(Text.Trim(Text.From([Name]))) = Text.Upper(segment) and Value.Is([Content], type table)),
		                            MatchCount = Table.RowCount(Matches),
		                            Next =
		                                if MatchCount = 1 then
		                                    Matches{0}[Content]
		                                else
		                                    error Error.Record(
		                                        "XerCsvSharePointNavigation",
		                                        "Expected exactly one SharePoint folder while navigating the configured CSV path.",
		                                        [Segment = segment, Matches = MatchCount, Path = path]
		                                    )
		                        in
		                            Next
		                )
		        in
		            Result
		in
		    fn
	lineageTag: f7bd9b3d-8d7f-4998-b538-52e478fc803b
	queryGroup: XER

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fnXerCsvReadBundle =
		let
		    fn = (bundleName as text, folder as table) as nullable record =>
		        let
		            ExpectedManifestColumns = {
		                "schema_version", "bundle_id", "bundle_status", "parser_version", "project_code", "project_name",
		                "programme_type", "original_xer_filename", "canonical_xer_filename", "snapshot_kind", "snapshot_tag",
		                "monthupdate", "update_date", "data_date", "source_sha256", "table_name", "row_count", "csv_sha256", "exported_at_utc"
		            },
		            FileRows = Table.SelectRows(folder, each Value.Is([Content], type binary)),
		            ChildFolders = Table.SelectRows(folder, each Value.Is([Content], type table)),
		            ManifestFiles = Table.SelectRows(FileRows, each [Name] = "XER_CSV_MANIFEST.csv"),
		            ManifestCount = Table.RowCount(ManifestFiles),
		            ParsedManifest =
		                if ManifestCount = 0 then
		                    null
		                else if ManifestCount > 1 then
		                    error Error.Record("XerCsvManifest", "A bundle contains more than one XER_CSV_MANIFEST.csv file.", [BundleId = bundleName])
		                else
		                    let
		                        Raw = Csv.Document(Binary.Buffer(ManifestFiles{0}[Content]), [Delimiter = ",", Columns = 19, Encoding = 65001, QuoteStyle = QuoteStyle.Csv, ExtraValues = ExtraValues.Error]),
		                        Promoted = Table.PromoteHeaders(Raw, [PromoteAllScalars = true]),
		                        ActualHeaders = Table.ColumnNames(Promoted),
		                        HeaderSignature = Text.Combine(ActualHeaders, "|"),
		                        ExpectedSignature = Text.Combine(ExpectedManifestColumns, "|"),
		                        HeaderChecked =
		                            if HeaderSignature <> ExpectedSignature then
		                                error Error.Record("XerCsvManifest", "Manifest headers or header order do not match schema version 1.0.", [BundleId = bundleName, ActualHeaders = HeaderSignature])
		                            else
		                                Promoted,
		                        StrictTokens = fnXerCsvValidateRawTokens(HeaderChecked, {"monthupdate", "update_date", "data_date"}, {}, {"row_count"}, {}, bundleName & "/XER_CSV_MANIFEST.csv"),
		                        InvalidExportedAt = Table.RowCount(Table.SelectRows(StrictTokens, each let token = [exported_at_utc], parsed = try DateTimeZone.FromText(token) in token = null or token = "" or not Text.EndsWith(token, "Z") or parsed[HasError])),
		                        ExportedAtChecked = if InvalidExportedAt = 0 then StrictTokens else error Error.Record("XerCsvFormat", "exported_at_utc must be a non-blank ISO-8601 UTC value ending in Z.", [BundleId = bundleName]),
		                        Typed = Table.TransformColumnTypes(
		                            ExportedAtChecked,
		                            {
		                                {"schema_version", type text}, {"bundle_id", type text}, {"bundle_status", type text},
		                                {"parser_version", type text}, {"project_code", type text}, {"project_name", type text},
		                                {"programme_type", type text}, {"original_xer_filename", type text}, {"canonical_xer_filename", type text},
		                                {"snapshot_kind", type text}, {"snapshot_tag", type text}, {"monthupdate", type nullable date},
		                                {"update_date", type nullable date}, {"data_date", type nullable date}, {"source_sha256", type text},
		                                {"table_name", type text}, {"row_count", Int64.Type}, {"csv_sha256", type text},
		                                {"exported_at_utc", type nullable datetimezone}
		                            },
		                            "en-NZ"
		                        ),
		                        Clean = Table.TransformColumns(
		                            Typed,
		                            {
		                                {"schema_version", each Text.Trim(_), type text}, {"bundle_id", each Text.Trim(_), type text},
		                                {"bundle_status", each Text.Upper(Text.Trim(_)), type text}, {"parser_version", each Text.Trim(_), type text},
		                                {"project_code", each Text.Upper(Text.Trim(_)), type text}, {"project_name", each Text.Trim(_), type text},
		                                {"programme_type", each Text.Upper(Text.Trim(_)), type text}, {"original_xer_filename", each Text.Trim(_), type text},
		                                {"canonical_xer_filename", each Text.Trim(_), type text}, {"snapshot_kind", each Text.Upper(Text.Trim(_)), type text},
		                                {"snapshot_tag", each Text.Trim(_), type text}, {"source_sha256", each Text.Upper(Text.Trim(_)), type text},
		                                {"table_name", each Text.Trim(_), type text}, {"csv_sha256", each Text.Upper(Text.Trim(_)), type text}
		                            }
		                        )
		                    in
		                        Clean,
		    Result =
		        if ParsedManifest = null then
		            null
		        else
		            let
		                Statuses = List.Distinct(Table.Column(ParsedManifest, "bundle_status")),
		                Status = if List.Count(Statuses) = 1 then Statuses{0} else error Error.Record("XerCsvManifest", "Manifest rows have inconsistent bundle_status values.", [BundleId = bundleName]),
		                IsComplete = Status = "COMPLETE",
		                ExpectedTableNames = Record.FieldNames(XerCsvTableContracts),
		                ExpectedFileNames = List.Combine({List.Transform(ExpectedTableNames, each Record.Field(XerCsvTableContracts, _)[FileName]), {"XER_CSV_MANIFEST.csv"}}),
		                ActualFileNames = Table.Column(FileRows, "Name"),
		                MissingFiles = List.Difference(ExpectedFileNames, ActualFileNames),
		                UnexpectedFiles = List.Difference(ActualFileNames, ExpectedFileNames),
		                DuplicateFiles = List.Select(List.Distinct(ActualFileNames), (fileName) => List.Count(List.Select(ActualFileNames, each _ = fileName)) > 1),
		                SchemaVersions = List.Distinct(Table.Column(ParsedManifest, "schema_version")),
		                BundleIds = List.Distinct(Table.Column(ParsedManifest, "bundle_id")),
		                ProjectCodes = List.Distinct(Table.Column(ParsedManifest, "project_code")),
		                ProgrammeTypes = List.Distinct(Table.Column(ParsedManifest, "programme_type")),
		                ProjectCode = if List.Count(ProjectCodes) = 1 then ProjectCodes{0} else null,
		                ProgrammeType = if List.Count(ProgrammeTypes) = 1 then ProgrammeTypes{0} else null,
		                Prefix = if ProjectCode = null or ProgrammeType = null then "" else ProjectCode & "_" & ProgrammeType & "_",
		                BundleTail = if Text.StartsWith(bundleName, Prefix) then Text.Range(bundleName, Text.Length(Prefix)) else "",
		                BundleTailParts = Text.Split(BundleTail, "_"),
		                TimestampPart = if List.Count(BundleTailParts) = 2 then BundleTailParts{0} else "",
		                HashPart = if List.Count(BundleTailParts) = 2 then Text.Upper(BundleTailParts{1}) else "",
		                HexChars = List.Combine({List.Transform({48..57}, each Character.FromNumber(_)), List.Transform({65..70}, each Character.FromNumber(_))}),
		                TimestampDigits = if Text.Length(TimestampPart) = 16 then Text.Start(TimestampPart, 8) & Text.Range(TimestampPart, 9, 6) else "",
		                DigitChars = List.Transform({48..57}, each Character.FromNumber(_)),
		                TimestampIso = if Text.Length(TimestampPart) = 16 then Text.Start(TimestampPart, 4) & "-" & Text.Range(TimestampPart, 4, 2) & "-" & Text.Range(TimestampPart, 6, 2) & "T" & Text.Range(TimestampPart, 9, 2) & ":" & Text.Range(TimestampPart, 11, 2) & ":" & Text.Range(TimestampPart, 13, 2) & "Z" else "",
		                ParsedBundleTimestamp = try DateTimeZone.FromText(TimestampIso),
		                BundleNameValid = Text.Length(TimestampPart) = 16 and Text.Range(TimestampPart, 8, 1) = "T" and Text.End(TimestampPart, 1) = "Z" and Text.Length(Text.Remove(TimestampDigits, DigitChars)) = 0 and not ParsedBundleTimestamp[HasError] and Text.Length(HashPart) = 8 and Text.Length(Text.Remove(HashPart, HexChars)) = 0,
		                ManifestTableNames = List.Distinct(Table.Column(ParsedManifest, "table_name")),
		                MissingManifestTables = List.Difference(ExpectedTableNames, ManifestTableNames),
		                UnexpectedManifestTables = List.Difference(ManifestTableNames, ExpectedTableNames),
		                CanonicalSources = List.Distinct(Table.Column(ParsedManifest, "canonical_xer_filename")),
		                SourceTableKeys = List.Transform(Table.ToRecords(ParsedManifest), each [canonical_xer_filename] & "|" & [table_name]),
		                ExpectedSourceTableKeys = List.Combine(List.Transform(CanonicalSources, (canonicalName) => List.Transform(ExpectedTableNames, each canonicalName & "|" & _))),
		                MissingSourceTables = List.Difference(ExpectedSourceTableKeys, SourceTableKeys),
		                UnexpectedSourceTables = List.Difference(SourceTableKeys, ExpectedSourceTableKeys),
		                DuplicateSourceTables = List.Count(SourceTableKeys) <> List.Count(List.Distinct(SourceTableKeys)),
		                PerSourceMetadataColumns = {"schema_version", "bundle_id", "bundle_status", "parser_version", "project_code", "project_name", "programme_type", "original_xer_filename", "snapshot_kind", "snapshot_tag", "monthupdate", "update_date", "data_date", "source_sha256", "exported_at_utc"},
		                SourceMetadataConsistent =
		                    List.AllTrue(
		                        List.Transform(
		                            CanonicalSources,
		                            (canonicalName) =>
		                                let rows = Table.SelectRows(ParsedManifest, each [canonical_xer_filename] = canonicalName)
		                                in Table.RowCount(rows) = List.Count(ExpectedTableNames) and List.AllTrue(List.Transform(PerSourceMetadataColumns, (columnName) => List.Count(List.Distinct(Table.Column(rows, columnName))) = 1))
		                        )
		                    ),
		                ShaValues = List.Combine({Table.Column(ParsedManifest, "source_sha256"), Table.Column(ParsedManifest, "csv_sha256")}),
		                HashesValid = List.AllTrue(List.Transform(ShaValues, each Text.Length(_) = 64 and Text.Length(Text.Remove(_, HexChars)) = 0)),
		                CanonicalNamesValid =
		                    ProjectCode <> null and ProgrammeType <> null and
		                    List.AllTrue(
		                        List.Transform(
		                            CanonicalSources,
		                            (canonicalName) =>
		                                let
		                                    sourceRows = Table.SelectRows(ParsedManifest, each [canonical_xer_filename] = canonicalName),
		                                    source = sourceRows{0},
		                                    canonicalPrefix = ProjectCode & "-" & ProgrammeType & "-",
		                                    hasEnvelope = Text.StartsWith(canonicalName, canonicalPrefix) and Text.EndsWith(canonicalName, ".xer"),
		                                    core = if hasEnvelope then Text.Range(canonicalName, Text.Length(canonicalPrefix), Text.Length(canonicalName) - Text.Length(canonicalPrefix) - 4) else "",
		                                    coreParts = Text.Split(core, "_"),
		                                    tag = if List.Count(coreParts) = 2 then coreParts{0} else "",
		                                    dateToken = if List.Count(coreParts) = 2 then coreParts{1} else "",
		                                    parsedDate = try Date.FromText(dateToken, [Format = "yyyyMMdd", Culture = "en-US"]),
		                                    dateValid = Text.Length(dateToken) = 8 and Text.Length(Text.Remove(dateToken, DigitChars)) = 0 and not parsedDate[HasError] and Date.ToText(parsedDate[Value], "yyyyMMdd", "en-US") = dateToken,
		                                    baselineTail = if Text.StartsWith(tag, "BL") then Text.Range(tag, 2) else "",
		                                    baselineParts = Text.Split(baselineTail, "-"),
		                                    baselineTagValid = List.Contains({1, 2}, List.Count(baselineParts)) and Text.Length(baselineParts{0}) = 2 and Text.Length(Text.Remove(baselineParts{0}, DigitChars)) = 0 and (List.Count(baselineParts) = 1 or (Text.Length(baselineParts{1}) = 1 and Text.Length(Text.Remove(baselineParts{1}, List.Transform({65..90}, each Character.FromNumber(_)))) = 0)),
		                                    updateMonth = if Text.Length(tag) = 4 and Text.Length(Text.Remove(tag, DigitChars)) = 0 then Number.FromText(Text.End(tag, 2), "en-US") else null,
		                                    updateTagValid = updateMonth <> null and updateMonth >= 1 and updateMonth <= 12,
		                                    kindTagValid = if source[snapshot_kind] = "BASELINE" then baselineTagValid else if source[snapshot_kind] = "UPDATE" then updateTagValid and tag = Date.ToText(source[monthupdate], "yyMM", "en-US") and source[update_date] = Date.EndOfMonth(source[monthupdate]) else false
		                                in
		                                    hasEnvelope and List.Count(coreParts) = 2 and tag = source[snapshot_tag] and dateValid and parsedDate[Value] = source[data_date] and kindTagValid
		                        )
		                    ),
		                RequiredTextColumns = {"parser_version", "project_code", "project_name", "programme_type", "original_xer_filename", "canonical_xer_filename", "snapshot_kind", "snapshot_tag", "source_sha256", "table_name", "csv_sha256"},
		                TextMetadataValid = List.AllTrue(List.Transform(RequiredTextColumns, (columnName) => List.AllTrue(List.Transform(Table.Column(ParsedManifest, columnName), each _ <> null and Text.Trim(Text.From(_)) <> "")))),
		                SnapshotKindsValid = List.AllTrue(List.Transform(Table.Column(ParsedManifest, "snapshot_kind"), each List.Contains({"BASELINE", "UPDATE"}, _))),
		                SourceMetadataRows = List.Transform(CanonicalSources, (canonicalName) => Table.SelectRows(ParsedManifest, each [canonical_xer_filename] = canonicalName){0}),
		                BaselineRows = List.Select(SourceMetadataRows, each [snapshot_kind] = "BASELINE"),
		                UpdateRows = List.Select(SourceMetadataRows, each [snapshot_kind] = "UPDATE"),
		                BaselineCount = List.Count(BaselineRows),
		                SnapshotTags = List.Transform(SourceMetadataRows, each [snapshot_tag]),
		                UpdateDates = List.Transform(SourceMetadataRows, each [update_date]),
		                SnapshotChronologyValid =
		                    if BaselineCount <> 1 then
		                        false
		                    else
		                        let
		                            baseline = BaselineRows{0},
		                            NonBaselineUpdateDates = List.RemoveNulls(List.Transform(UpdateRows, each [update_date])),
		                            BaselineCandidateDates =
		                                if baseline[monthupdate] = null then
		                                    {}
		                                else
		                                    List.Transform({0..240}, each Date.EndOfMonth(Date.AddMonths(baseline[monthupdate], -_))),
		                            ExpectedBaselineUpdateDate = List.First(List.Select(BaselineCandidateDates, each not List.Contains(NonBaselineUpdateDates, _)), null),
		                            BaselineEffectiveDateValid = ExpectedBaselineUpdateDate <> null and baseline[update_date] = ExpectedBaselineUpdateDate,
		                            UpdatesFollowBaseline =
		                                baseline[monthupdate] <> null and baseline[update_date] <> null and
		                                List.AllTrue(List.Transform(UpdateRows, each [monthupdate] <> null and [update_date] <> null and [monthupdate] > baseline[monthupdate] and [update_date] > baseline[update_date])),
		                            UpdateDatesUnique = List.Count(UpdateDates) = List.Count(List.Distinct(UpdateDates))
		                        in
		                            BaselineEffectiveDateValid and UpdatesFollowBaseline and UpdateDatesUnique,
		                SnapshotIdentityValid = BaselineCount = 1 and SnapshotChronologyValid and List.Count(SnapshotTags) = List.Count(List.Distinct(SnapshotTags)),
		                DatesValid = List.NonNullCount(Table.Column(ParsedManifest, "monthupdate")) = Table.RowCount(ParsedManifest) and List.NonNullCount(Table.Column(ParsedManifest, "update_date")) = Table.RowCount(ParsedManifest) and List.NonNullCount(Table.Column(ParsedManifest, "data_date")) = Table.RowCount(ParsedManifest) and List.NonNullCount(Table.Column(ParsedManifest, "exported_at_utc")) = Table.RowCount(ParsedManifest),
		                RowCountsValid = List.AllTrue(List.Transform(Table.Column(ParsedManifest, "row_count"), each _ <> null and _ >= 0)),
		                CsvHashesConsistent = List.AllTrue(List.Transform(ExpectedTableNames, (tableName) => List.Count(List.Distinct(Table.Column(Table.SelectRows(ParsedManifest, each [table_name] = tableName), "csv_sha256"))) = 1)),
		                BundleExportTimes = List.Distinct(Table.Column(ParsedManifest, "exported_at_utc")),
		                BundleExportedAtValid = List.Count(BundleExportTimes) = 1 and not ParsedBundleTimestamp[HasError] and DateTimeZone.ToUtc(BundleExportTimes{0}) = DateTimeZone.ToUtc(ParsedBundleTimestamp[Value]),
		                ExportedAtUtc = if DatesValid then List.Max(Table.Column(ParsedManifest, "exported_at_utc")) else null,
		                Validated =
		                    if not IsComplete then
		                        null
		                    else if Table.RowCount(ChildFolders) > 0 or List.Count(MissingFiles) > 0 or List.Count(UnexpectedFiles) > 0 or List.Count(DuplicateFiles) > 0 then
		                        error Error.Record("XerCsvBundle", "A completed bundle must contain exactly the ten contract CSV files and XER_CSV_MANIFEST.csv, with no duplicate files or child folders.", [BundleId = bundleName, MissingFiles = Text.Combine(MissingFiles, ", "), UnexpectedFiles = Text.Combine(UnexpectedFiles, ", ")])
		                    else if List.Count(SchemaVersions) <> 1 or SchemaVersions{0} <> "1.0" then
		                        error Error.Record("XerCsvManifest", "Unsupported schema_version; Programme Review requires 1.0.", [BundleId = bundleName])
		                    else if List.Count(BundleIds) <> 1 or BundleIds{0} <> bundleName or not BundleNameValid then
		                        error Error.Record("XerCsvManifest", "bundle_id must match the folder and use <PROJECT>_<C|T>_<yyyyMMddTHHmmssZ>_<hash8>.", [BundleId = bundleName])
		                    else if ProjectCode = null or ProgrammeType = null or not List.Contains({"C", "T"}, ProgrammeType) then
		                        error Error.Record("XerCsvManifest", "A bundle must contain exactly one project_code and one programme_type (C or T).", [BundleId = bundleName])
		                    else if List.Count(MissingManifestTables) > 0 or List.Count(UnexpectedManifestTables) > 0 or List.Count(MissingSourceTables) > 0 or List.Count(UnexpectedSourceTables) > 0 or DuplicateSourceTables or not SourceMetadataConsistent then
		                        error Error.Record("XerCsvManifest", "Manifest source-XER/table rows are incomplete, unexpected, or duplicated.", [BundleId = bundleName])
		                    else if not TextMetadataValid or not SnapshotKindsValid or not SnapshotIdentityValid or not DatesValid or not RowCountsValid or not HashesValid or not CsvHashesConsistent or not BundleExportedAtValid or not CanonicalNamesValid then
		                        error Error.Record("XerCsvManifest", "Manifest metadata is incomplete or invalid.", [BundleId = bundleName])
		                    else
		                        [BundleId = bundleName, ProjectCode = ProjectCode, ProgrammeType = ProgrammeType, ExportedAtUtc = ExportedAtUtc, Manifest = ParsedManifest, Files = FileRows]
		            in
		                Validated
		in
		    Result
		in
		    fn
