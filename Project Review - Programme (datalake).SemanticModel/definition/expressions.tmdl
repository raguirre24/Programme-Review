	annotation PBI_ResultType = List

expression XerCsvSelectedManifest =
		let
		    Columns = {
		        "schema_version", "bundle_id", "bundle_status", "parser_version", "project_code", "project_name",
		        "programme_type", "original_xer_filename", "canonical_xer_filename", "snapshot_kind", "snapshot_tag",
		        "monthupdate", "update_date", "data_date", "source_sha256", "table_name", "row_count", "csv_sha256", "exported_at_utc"
		    },
		    Types = {
		        {"schema_version", type text}, {"bundle_id", type text}, {"bundle_status", type text}, {"parser_version", type text},
		        {"project_code", type text}, {"project_name", type text}, {"programme_type", type text}, {"original_xer_filename", type text},
		        {"canonical_xer_filename", type text}, {"snapshot_kind", type text}, {"snapshot_tag", type text},
		        {"monthupdate", type nullable date}, {"update_date", type nullable date}, {"data_date", type nullable date},
		        {"source_sha256", type text}, {"table_name", type text}, {"row_count", Int64.Type}, {"csv_sha256", type text},
		        {"exported_at_utc", type nullable datetime}
		    },
		    Empty = Table.TransformColumnTypes(#table(Columns, {}), Types, "en-NZ"),
		    ReadSelected = (location as record) as record =>
		        let
		            Validated = fnXerCsvReadBundle(location[BundleId], location[Folder]),
		            Present = if Validated = null then error Error.Record("XerCsvManifest", "The selected bundle no longer contains its completed manifest.", [BundleId = location[BundleId]]) else Validated,
		            IdentityChecked =
		                if Present[ProjectCode] <> location[ProjectCode] or Present[ProgrammeType] <> location[ProgrammeType] then
		                    error Error.Record("XerCsvProjectFolder", "The selected bundle manifest does not match its project folder and programme envelope.", [BundleId = location[BundleId], FolderProject = location[ProjectCode], ManifestProject = Present[ProjectCode], FolderProgramme = location[ProgrammeType], ManifestProgramme = Present[ProgrammeType]])
		                else
		                    Present
		        in
		            IdentityChecked,
		    Selected = if XerCsvRouting[IsActive] then List.Transform(XerCsvSelectedBundles, each ReadSelected(_)) else {},
		    Combined = if List.Count(Selected) = 0 then Empty else Table.Combine(List.Transform(Selected, each Table.SelectColumns([Manifest], Columns))),
		    Result = Table.TransformColumnTypes(Table.SelectColumns(Combined, Columns), Types, "en-NZ")
		in
		    Result
	lineageTag: e1335ef8-beca-4ad4-ab82-a91a97654d6c
	queryGroup: XER

