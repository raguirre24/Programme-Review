expression XerCsvProjectFilterList =
		if not XerCsvEnabled then
		    {}
		else
		let
		    Raw = Text.Trim(XerCsvProjectCodes),
		    RawTokens =
		        List.Select(
		            List.Transform(Text.Split(Raw, ","), each Text.Upper(Text.Trim(_))),
		            each _ <> ""
		        ),
		    AllowedChars =
		        List.Combine({
		            List.Transform({48..57}, each Character.FromNumber(_)),
		            List.Transform({65..90}, each Character.FromNumber(_)),
		            {"_"}
		        }),
		    InvalidTokens = List.Select(RawTokens, each Text.Length(Text.Remove(_, AllowedChars)) > 0),
		    Result =
		        if List.Count(InvalidTokens) > 0 then
		            error Error.Record(
		                "XerCsvRouting",
		                "XerCsvProjectCodes can contain only comma-separated project codes using A-Z, 0-9 or underscore.",
		                [InvalidCodes = Text.Combine(InvalidTokens, ", ")]
		            )
		        else
		            List.Sort(List.Distinct(RawTokens))
		in
		    Result
	lineageTag: e660bda3-5c00-4f32-a5a9-90adeaa22e90
	queryGroup: XER

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = List

expression XerCsvRouting =
		let
		    RoutedCodes = XerCsvProjectFilterList,
		    DigitChars = List.Transform({48..57}, each Character.FromNumber(_)),
		    IsNumericSuffix = (value as text) as logical =>
		        Text.Length(value) > 1 and Text.Length(Text.Remove(Text.Range(value, 1), DigitChars)) = 0,
		    Identity = (value as text) as text =>
		        if List.Contains({"C", "J"}, Text.Start(value, 1)) and IsNumericSuffix(value) then
		            Text.Range(value, 1)
		        else
		            value,
		    Alternate = (value as text) as nullable text =>
		        if Text.Start(value, 1) = "C" and IsNumericSuffix(value) then
		            "J" & Text.Range(value, 1)
		        else if Text.Start(value, 1) = "J" and IsNumericSuffix(value) then
		            "C" & Text.Range(value, 1)
		        else
		            null,
		    RoutedIdentities = List.Transform(RoutedCodes, each Identity(_)),
		    AliasCollisions =
		        List.Select(
		            List.Distinct(RoutedIdentities),
		            (identityValue) => List.Count(List.Select(RoutedIdentities, each _ = identityValue)) > 1
		        ),
		    SelectedIdentities =
		        if ProjectFilterList = null then
		            null
		        else
		            List.Distinct(List.Transform(ProjectFilterList, each Identity(_))),
		    OutsideSelectedScope =
		        if SelectedIdentities = null then
		            {}
		        else
		            List.Select(RoutedCodes, each not List.Contains(SelectedIdentities, Identity(_))),
		    ProgrammeType = Text.Upper(Text.Trim(SelectedProgrammeType)),
		    ExcludedCodes =
		        List.Sort(
		            List.Distinct(
		                List.Combine({
		                    RoutedCodes,
		                    List.RemoveNulls(List.Transform(RoutedCodes, each Alternate(_)))
		                })
		            )
		        ),
		    IsActive = XerCsvEnabled and List.Count(RoutedCodes) > 0,
		    Result =
		        if List.Count(AliasCollisions) > 0 then
		            error Error.Record(
		                "XerCsvRouting",
		                "Do not configure both C and J aliases for the same project in XerCsvProjectCodes.",
		                [ProjectIdentities = Text.Combine(AliasCollisions, ", ")]
		            )
		        else if IsActive and List.Count(OutsideSelectedScope) > 0 then
		            error Error.Record(
		                "XerCsvRouting",
		                "Every routed CSV project must also be included by SelectedProjects (C/J aliases count as the same project).",
		                [OutsideSelectedProjects = Text.Combine(OutsideSelectedScope, ", ")]
		            )
		        else if IsActive and not List.Contains({"C", "T", "ALL"}, ProgrammeType) then
		            error Error.Record("XerCsvRouting", "SelectedProgrammeType must be C, T, or ALL.", [Value = SelectedProgrammeType])
		        else
		            [
		                IsActive = IsActive,
		                ProjectCodes = RoutedCodes,
		                AthenaExcludedProjectCodes = if IsActive then ExcludedCodes else {},
		                ProgrammeType = ProgrammeType
		            ]
		in
		    Result
