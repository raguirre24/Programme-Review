	queryGroup: XER

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = List

expression fnXerCsvReadBundleTable =
		let
		    fn = (bundle as record, tableName as text) as table =>
		        let
		            Contract = if Record.HasFields(XerCsvTableContracts, tableName) then Record.Field(XerCsvTableContracts, tableName) else error Error.Record("XerCsvContract", "Unknown Programme Review CSV table.", [TableName = tableName]),
		            FileMatches = Table.SelectRows(bundle[Files], each [Name] = Contract[FileName]),
		            FileBinary = if Table.RowCount(FileMatches) = 1 then Binary.Buffer(FileMatches{0}[Content]) else error Error.Record("XerCsvBundle", "Expected exactly one contract CSV file.", [BundleId = bundle[BundleId], FileName = Contract[FileName]]),
		            ManifestRows = Table.SelectRows(bundle[Manifest], each [table_name] = tableName),
		            Raw = Csv.Document(FileBinary, [Delimiter = ",", Columns = List.Count(Contract[Columns]), Encoding = 65001, QuoteStyle = QuoteStyle.Csv, ExtraValues = ExtraValues.Error]),
		            Promoted = Table.PromoteHeaders(Raw, [PromoteAllScalars = true]),
		            ActualHeaders = Table.ColumnNames(Promoted),
		            HeaderChecked = if Text.Combine(ActualHeaders, "|") = Text.Combine(Contract[Columns], "|") then Promoted else error Error.Record("XerCsvSchema", "CSV headers or header order do not match schema version 1.0.", [BundleId = bundle[BundleId], FileName = Contract[FileName], ActualHeaders = Text.Combine(ActualHeaders, ", ")]),
		            StrictTokens = fnXerCsvValidateRawTokens(HeaderChecked, Contract[DateColumns], Contract[LogicalColumns], Contract[IntegerColumns], Contract[NumberColumns], bundle[BundleId] & "/" & Contract[FileName]),
		            Typed = Table.TransformColumnTypes(StrictTokens, Contract[Types], "en-NZ"),
		            ProjectNormalised = Typed,
		            RequiredNulls =
		                List.Select(
		                    Contract[RequiredColumns],
		                    (columnName) => Table.RowCount(Table.SelectRows(ProjectNormalised, each let value = Record.Field(_, columnName) in value = null or Text.Trim(Text.From(value)) = "")) > 0
		                ),
		            CanonicalNames = List.Distinct(Table.Column(bundle[Manifest], "canonical_xer_filename")),
		            AllowedKeyPrefixes = List.Transform(CanonicalNames, each "CSV|" & bundle[BundleId] & "|" & _ & "."),
		            InvalidNamespaceColumns =
		                List.Select(
		                    Contract[NamespaceColumns],
		                    (columnName) =>
		                        Table.RowCount(
		                            Table.SelectRows(
		                                ProjectNormalised,
		                                each
		                                    let value = Record.Field(_, columnName)
		                                    in value <> null and Text.Trim(Text.From(value)) <> "" and not List.AnyTrue(List.Transform(AllowedKeyPrefixes, (prefix) => Text.StartsWith(Text.From(value), prefix)))
		                            )
		                        ) > 0
		                ),
		            InvalidMixedNamespaceRows =
		                if List.Count(Contract[NamespaceColumns]) < 2 then
		                    0
		                else
		                    Table.RowCount(
		                        Table.SelectRows(
		                            ProjectNormalised,
		                            each
		                                let
		                                    values = List.RemoveNulls(List.Transform(Contract[NamespaceColumns], (columnName) => let value = Record.Field(_, columnName) in if value = null or Text.Trim(Text.From(value)) = "" then null else Text.From(value))),
		                                    prefixes = List.RemoveNulls(List.Transform(values, (value) => let matches = List.Select(AllowedKeyPrefixes, (prefix) => Text.StartsWith(value, prefix)) in if List.Count(matches) = 1 then matches{0} else null))
		                                in
		                                    List.Count(List.Distinct(prefixes)) > 1
		                        )
		                    ),
		            InvalidUniqueKeys = List.Select(Contract[UniqueKeys], (keyColumns) => Table.RowCount(Table.Distinct(Table.SelectColumns(ProjectNormalised, keyColumns))) <> Table.RowCount(ProjectNormalised)),
		            ExpectedRows = List.Sum(Table.Column(ManifestRows, "row_count")),
		            ActualRows = Table.RowCount(ProjectNormalised),
		            PerSourceRowCountMismatches =
		                List.Select(
		                    Table.ToRecords(ManifestRows),
		                    (manifestRow) =>
		                        let
		                            canonicalName = manifestRow[canonical_xer_filename],
		                            prefix = "CSV|" & bundle[BundleId] & "|" & canonicalName & ".",
		                            sourceRows =
		                                if Contract[SourceKeyColumn] = null then
		                                    Table.RowCount(Table.SelectRows(ProjectNormalised, each [filename] = canonicalName))
		                                else
		                                    Table.RowCount(Table.SelectRows(ProjectNormalised, each let value = Record.Field(_, Contract[SourceKeyColumn]) in value <> null and Text.StartsWith(Text.From(value), prefix)))
		                        in
		                            sourceRows <> manifestRow[row_count]
		                ),
		            InvalidProjectRows = if Contract[ProjectColumn] = null then 0 else Table.RowCount(Table.SelectRows(ProjectNormalised, each Record.Field(_, Contract[ProjectColumn]) <> bundle[ProjectCode])),
		            InvalidTaskMetadataRows =
		                if tableName <> "01_XER_TASK" then
		                    0
		                else
		                    Table.RowCount(
		                        Table.SelectRows(
		                            ProjectNormalised,
		                            each
		                                let
		                                    sourceManifest = Table.SelectRows(bundle[Manifest], (manifestRow) => manifestRow[canonical_xer_filename] = [filename]),
		                                    source = if Table.RowCount(sourceManifest) = 10 then sourceManifest{0} else null
		                                in
		                                    source = null or [ProjectCode] <> source[project_code] or [monthupdate] <> source[monthupdate] or [UpdateDate] <> source[update_date] or [data_date] <> source[data_date] or [ProjectName] <> source[project_name]
		                        )
		                    ),
		            InvalidTaskFilenameKeyRows =
		                if tableName <> "01_XER_TASK" then
		                    0
		                else
		                    Table.RowCount(
		                        Table.SelectRows(
		                            ProjectNormalised,
		                            each
		                                let expectedPrefix = "CSV|" & bundle[BundleId] & "|" & [filename] & "."
		                                in not List.AllTrue(List.Transform(Contract[NamespaceColumns], (columnName) => let value = Record.Field(_, columnName) in value <> null and Text.StartsWith(Text.From(value), expectedPrefix)))
		                        )
		                    ),
		            InvalidProjectSnapshotMetadataRows =
		                if tableName <> "02_XER_PROJECT" then
		                    0
		                else
		                    Table.RowCount(
		                        Table.SelectRows(
		                            ProjectNormalised,
		                            each
		                                let
		                                    key = [proj_id_key],
		                                    matchingSources = Table.SelectRows(bundle[Manifest], (manifestRow) => manifestRow[table_name] = "02_XER_PROJECT" and Text.StartsWith(key, "CSV|" & bundle[BundleId] & "|" & manifestRow[canonical_xer_filename] & ".")),
		                                    source = if Table.RowCount(matchingSources) = 1 then matchingSources{0} else null
		                                in
		                                    source = null or [ProjectCode] <> source[project_code] or [monthupdate] <> source[monthupdate] or [last_recalc_date] <> source[data_date]
		                        )
		                    ),
		            Validated =
		                if List.Count(RequiredNulls) > 0 then
		                    error Error.Record("XerCsvData", "Required CSV fields contain null or blank values.", [BundleId = bundle[BundleId], TableName = tableName, Columns = Text.Combine(RequiredNulls, ", ")])
		                else if List.Count(InvalidNamespaceColumns) > 0 then
		                    error Error.Record("XerCsvData", "Relationship keys do not use the required CSV bundle/canonical-file namespace.", [BundleId = bundle[BundleId], TableName = tableName, Columns = Text.Combine(InvalidNamespaceColumns, ", ")])
		                else if InvalidMixedNamespaceRows > 0 then
		                    error Error.Record("XerCsvData", "Namespaced relationship keys on a row come from different canonical XER snapshots.", [BundleId = bundle[BundleId], TableName = tableName, Rows = InvalidMixedNamespaceRows])
		                else if List.Count(InvalidUniqueKeys) > 0 then
		                    error Error.Record("XerCsvData", "CSV primary/composite keys are duplicated.", [BundleId = bundle[BundleId], TableName = tableName])
		                else if ExpectedRows <> ActualRows or List.Count(PerSourceRowCountMismatches) > 0 then
		                    error Error.Record("XerCsvData", "CSV row count does not equal the sum of manifest row_count values.", [BundleId = bundle[BundleId], TableName = tableName, Expected = ExpectedRows, Actual = ActualRows])
		                else if InvalidProjectRows > 0 then
		                    error Error.Record("XerCsvData", "CSV ProjectCode values do not match the owning manifest.", [BundleId = bundle[BundleId], TableName = tableName])
		                else if InvalidTaskMetadataRows > 0 then
		                    error Error.Record("XerCsvData", "01 task snapshot metadata does not match its canonical manifest source.", [BundleId = bundle[BundleId], Rows = InvalidTaskMetadataRows])
		                else if InvalidTaskFilenameKeyRows > 0 then
		                    error Error.Record("XerCsvData", "01 task relationship keys do not match the row's canonical filename namespace.", [BundleId = bundle[BundleId], Rows = InvalidTaskFilenameKeyRows])
		                else if InvalidProjectSnapshotMetadataRows > 0 then
		                    error Error.Record("XerCsvData", "02 project snapshot metadata does not match its canonical manifest source.", [BundleId = bundle[BundleId], Rows = InvalidProjectSnapshotMetadataRows])
		                else
		                    Table.SelectColumns(ProjectNormalised, Contract[Columns])
		        in
		            Validated
		in
		    fn
	lineageTag: 00f92d84-734a-4b14-81ad-1659be5817ad
