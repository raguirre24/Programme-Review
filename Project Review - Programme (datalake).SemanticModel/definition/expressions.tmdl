expression fnXerCsvValidateRawTokens =
		let
		    fn = (source as table, dateColumns as list, logicalColumns as list, integerColumns as list, numberColumns as list, context as text) as table =>
		        let
		            DigitChars = List.Transform({48..57}, each Character.FromNumber(_)),
		            IsBlank = (value as any) as logical => value = null or Text.From(value) = "",
		            IsDigits = (value as text) as logical => Text.Length(value) > 0 and Text.Length(Text.Remove(value, DigitChars)) = 0,
		            IsDate = (value as any) as logical =>
		                if IsBlank(value) then true else
		                let
		                    token = Text.From(value),
		                    parsed = try Date.FromText(token, [Format = "yyyy-MM-dd", Culture = "en-US"])
		                in
		                    Text.Length(token) = 10 and Text.Range(token, 4, 1) = "-" and Text.Range(token, 7, 1) = "-" and IsDigits(Text.Remove(token, {"-"})) and not parsed[HasError] and Date.ToText(parsed[Value], "yyyy-MM-dd", "en-US") = token,
		            IsLogical = (value as any) as logical => IsBlank(value) or List.Contains({"true", "false"}, Text.From(value)),
		            IsInteger = (value as any) as logical =>
		                if IsBlank(value) then true else
		                let token = Text.From(value), unsigned = if Text.StartsWith(token, "-") then Text.Range(token, 1) else token
		                in IsDigits(unsigned),
		            IsNumber = (value as any) as logical =>
		                if IsBlank(value) then true else
		                let
		                    token = Text.From(value),
		                    lower = Text.Lower(token),
		                    exponentParts = Text.Split(lower, "e"),
		                    mantissa = exponentParts{0},
		                    unsignedMantissa = if Text.StartsWith(mantissa, "-") then Text.Range(mantissa, 1) else mantissa,
		                    decimalParts = Text.Split(unsignedMantissa, "."),
		                    exponent = if List.Count(exponentParts) = 2 then exponentParts{1} else null,
		                    unsignedExponent = if exponent <> null and (Text.StartsWith(exponent, "-") or Text.StartsWith(exponent, "+")) then Text.Range(exponent, 1) else exponent,
		                    mantissaValid = List.Count(decimalParts) <= 2 and List.AllTrue(List.Transform(decimalParts, each IsDigits(_))),
		                    exponentValid = List.Count(exponentParts) = 1 or (List.Count(exponentParts) = 2 and unsignedExponent <> null and IsDigits(unsignedExponent)),
		                    parsed = try Number.FromText(token, "en-US")
		                in
		                    mantissaValid and exponentValid and not parsed[HasError],
		            InvalidDates = List.Select(dateColumns, (columnName) => Table.RowCount(Table.SelectRows(source, each not IsDate(Record.Field(_, columnName)))) > 0),
		            InvalidLogicals = List.Select(logicalColumns, (columnName) => Table.RowCount(Table.SelectRows(source, each not IsLogical(Record.Field(_, columnName)))) > 0),
		            InvalidIntegers = List.Select(integerColumns, (columnName) => Table.RowCount(Table.SelectRows(source, each not IsInteger(Record.Field(_, columnName)))) > 0),
		            InvalidNumbers = List.Select(numberColumns, (columnName) => Table.RowCount(Table.SelectRows(source, each not IsNumber(Record.Field(_, columnName)))) > 0),
		            Invalid = List.Combine({InvalidDates, InvalidLogicals, InvalidIntegers, InvalidNumbers}),
		            Result = if List.Count(Invalid) = 0 then source else error Error.Record("XerCsvFormat", "CSV values do not use the required ISO date, true/false logical, or invariant numeric format.", [Context = context, Columns = Text.Combine(List.Distinct(Invalid), ", ")])
		        in
		            Result
		in
		    fn
	lineageTag: 85bd4d9d-f8ba-4cb6-9c47-3147b230f01b
